# Entorno LOCAL solamente. No copiar estas variables a Git con valores reales.
POSTGRES_DB=tfi_auditoria
POSTGRES_USER=tfi_user
POSTGRES_PASSWORD=REEMPLAZAR_POR_LA_MISMA_CLAVE_LOCAL_DEL_BLOQUE_2
POSTGRES_PORT=5432

JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_LOCAL_DE_AL_MENOS_32_CARACTERES

BOOTSTRAP_ADMIN_EMAIL=admin@tfi.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_LOCAL
BOOTSTRAP_ORG_IDENTIFIER=TFI-DEMO
BOOTSTRAP_ORG_NAME=Organizacion Demo TFI

FRONTEND_ORIGIN=http://localhost:4321

# Bitácora de excepciones (MongoDB local del docker compose)
MONGODB_URI=mongodb://localhost:27017
BITACORA_EXCEPCIONES_NIVEL=ERROR

# Repositorio de archivos. En local NO hace falta: audit-core usa el Azurite del docker compose
# (perfil dev). Solo completar para probar contra una cuenta real de Azure (no subir a Git).
# AZURE_STORAGE_CONNECTION_STRING=

# Correo. En local los avisos van a Mailpit (docker compose, http://localhost:8025) y no hace falta nada más.
# Para probar Azure Communication Services desde local (no subir a Git):
# CORREO_CONEXION=endpoint=https://<recurso>.communication.azure.com/;accesskey=<VALOR_CONFIGURADO_EN_ENV>
# CORREO_REMITENTE=DoNotReply@<dominio>.azurecomm.net
APP_URL_PUBLICA=http://localhost:4321

# Secreto de las tareas programadas (/internal/...). En local el perfil dev ya trae uno.
# TAREA_SECRETO=
