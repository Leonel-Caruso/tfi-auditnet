+        ▶ ${t('auditorias.ejecutar')}
+      </button>` : ''}
+    ${!baseline ? `<div class="alert alert-error">${t('auditorias.sinBaselineActiva')}</div>` : ''}
+  `);
+
+  document.querySelector<HTMLButtonElement>('#execute-selected-audit')?.addEventListener('click', () => executeAudit(configuration.id));
+  document.querySelector<HTMLButtonElement>('#config-file-download')?.addEventListener('click', () => downloadOriginal(configuration.id));
+};
+
+const selectAudit = async (id: number) => {
+  selectedAuditId = id;
+  selectedConfigurationId = null;
+  renderConfigurations();
+  renderAudits();
+
+  const response = await auditFetch(`/api/audits/${id}`);
+  if (!response.ok) {
+    showMessage('error', await readApiError(response));
+    return;
+  }
+
+  const detail = await response.json() as AuditDetail;
+  renderAuditDetail(detail);
+};
+
+const renderAuditDetail = (detail: AuditDetail) => {
+  const audit = detail.auditoria;
+  const device = deviceById(audit.dispositivoId);
+  const baseline = baselineById(audit.baselineId);
+  const evaluations = detail.evaluaciones.map((evaluation) => `
+    <div class="evaluation-item ${evaluation.cumple ? 'is-pass' : 'is-fail'}">
+      <div>
+        <code>${escapeHtml(evaluation.codigoRegla)}</code>
+        <strong>${escapeHtml(evaluation.nombreRegla)}</strong>
+      </div>
+      <span class="status-badge ${evaluation.cumple ? 'status-ready' : 'status-strong'}">
+        ${t(evaluation.cumple ? 'auditorias.cumple' : 'auditorias.hallazgo')}
+      </span>
+      <small>${escapeHtml(evidencia(evaluation.evidencia))}</small>
+    </div>
+  `).join('');
+
+  showInspector(`
+    <div class="inspector-identity">
+      <span class="inspector-code">${code('AUD', audit.id)}</span>
+      <h3>${escapeHtml(device?.identificador ?? t('auditorias.dispositivoNumero', { id: audit.dispositivoId }))}</h3>
+      <span class="status-badge ${audit.resultado === 'CUMPLE' ? 'status-ready' : 'status-strong'}">${escapeHtml(etiqueta('resultado', audit.resultado))}</span>
+    </div>
+    <dl class="technical-definition-list">
+      <div><dt>${t('general.baseline')}</dt><dd>${escapeHtml(baseline?.nombre ?? `#${audit.baselineId}`)}</dd></div>
+      <div><dt>${t('auditorias.configuracion')}</dt><dd>${code('CFG', audit.configuracionId)}</dd></div>
+      <div><dt>${t('auditorias.reglasEvaluadas')}</dt><dd>${audit.totalReglas}</dd></div>
+      <div><dt>${t('auditorias.reglasCumplidas')}</dt><dd>${audit.reglasCumplidas}</dd></div>
+      <div><dt>${t('auditorias.hallazgos')}</dt><dd>${audit.totalHallazgos}</dd></div>
+      <div><dt>${t('auditorias.severidadMaxima')}</dt><dd>${escapeHtml(severityCode(audit.severidadMaxima))}</dd></div>
+      <div><dt>${t('auditorias.ejecuto')}</dt><dd>${escapeHtml(audit.ejecutadoPor)}</dd></div>
+      <div><dt>${t('bitacoras.fecha')}</dt><dd>${escapeHtml(formatDate(audit.fechaEjecucion))}</dd></div>
+    </dl>
+    <div class="evaluation-list">
+      <span class="eyebrow">${t('auditorias.evaluacionReglas')}</span>
+      ${evaluations}
+    </div>
+    ${audit.totalHallazgos > 0 ? `<a class="button button-ghost button-full" href="/results?auditoria=${audit.id}">${t('auditorias.verHallazgos')}</a>` : ''}
+    <a class="button button-ghost button-full" href="/history?auditoria=${audit.id}">${t('auditorias.verHistorial')}</a>
+  `);
+};
+
+const executeAudit = async (configurationId: number) => {
+  const button = document.querySelector<HTMLButtonElement>('#execute-selected-audit');
+  if (button) button.disabled = true;
+
+  try {
+    const response = await auditFetch('/api/audits', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ configuracionId: configurationId }),
+    });
+
+    if (!response.ok) throw new Error(await readApiError(response));
+
+    const detail = await response.json() as AuditDetail;
+    showMessage(
+      'success',
+      t('auditorias.finalizada', { codigo: code('AUD', detail.auditoria.id), hallazgos: plural(detail.auditoria.totalHallazgos, 'informe.hallazgo') }),
+    );
+    await refreshAll();
+    selectedAuditId = detail.auditoria.id;
+    selectedConfigurationId = null;
+    renderConfigurations();
+    renderAudits();
+    renderAuditDetail(detail);
+  } catch (error) {
+    showMessage('error', error instanceof Error ? error.message : t('auditorias.errorEjecutar'));
+  } finally {
+    if (button) button.disabled = false;
+  }
+};
+
+const openDialog = () => {
+  configForm?.reset();
+  configDialog?.showModal();
+};
+
+const closeDialog = () => configDialog?.close();
+
+openConfigButton?.addEventListener('click', openDialog);
+document.querySelector('#close-config-dialog')?.addEventListener('click', closeDialog);
+document.querySelector('#cancel-config')?.addEventListener('click', closeDialog);
+
+configFile?.addEventListener('change', async () => {
+  const file = configFile.files?.[0];
+  if (!file || !configContent) return;
+  configContent.value = await file.text();
+});
+
+configForm?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const deviceId = Number(configDevice?.value);
+  const content = configContent?.value ?? '';
+  const file = configFile?.files?.[0];
+  const extension = file?.name.split('.').pop()?.toLowerCase();
+  const formato = extension === 'cfg' ? 'CFG' : extension === 'txt' ? 'TXT' : 'TEXTO';
+  const nombreFuente = file?.name ?? 'entrada-manual';
+
+  try {
+    const response = await auditFetch(`/api/devices/${deviceId}/configurations`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        contenido: content,
+        formato,
+        nombreFuente,
+      }),
+    });
+
+    if (!response.ok) throw new Error(await readApiError(response));
+
+    const created = await response.json() as DeviceConfiguration;
+    closeDialog();
+    showMessage('success', t('auditorias.importada', { codigo: code('CFG', created.id), version: created.version }));
+    await refreshAll();
+    selectConfiguration(created.id);
+  } catch (error) {
+    showMessage('error', error instanceof Error ? error.message : t('auditorias.errorImportar'));
+  }
+});
+
+searchInput?.addEventListener('input', renderConfigurations);
+
+refreshAll().catch((error) => {
+  showMessage('error', error instanceof Error ? error.message : t('auditorias.errorCargar'));
+});
diff --git a/frontend/web-app/src/scripts/baselines.ts b/frontend/web-app/src/scripts/baselines.ts
new file mode 100644
index 0000000..48b6d99
--- /dev/null
+++ b/frontend/web-app/src/scripts/baselines.ts
@@ -0,0 +1,336 @@
+// Baselines: alta, versiones, descripción y activación.
+import { auditFetch, authFetch } from '../lib/auth';
+import {
+  jsonRequest,
+  readApiError,
+  type BaselineRule,
+  type ConfigurationBaseline,
+  type DeviceType,
+  type Organization,
+} from '../lib/api';
+import { plural, recordStatusCode } from '../lib/format';
+import { t } from '../lib/i18n';
+import { confirmAction, notify, setText } from '../lib/ui';
+
+const state = {
+  baselines: [] as ConfigurationBaseline[],
+  rules: [] as BaselineRule[],
+  deviceTypes: [] as DeviceType[],
+  organizations: [] as Organization[],
+  current: null as ConfigurationBaseline | null,
+  changeMode: 'description' as 'description' | 'version',
+};
+
+const body = document.querySelector<HTMLTableSectionElement>('#baselines-body');
+const empty = document.querySelector<HTMLElement>('#baselines-empty');
+const count = document.querySelector<HTMLElement>('#baseline-count');
+const search = document.querySelector<HTMLInputElement>('#baseline-search');
+const statusFilter = document.querySelector<HTMLSelectElement>('#baseline-status-filter');
+const dialog = document.querySelector<HTMLDialogElement>('#baseline-dialog');
+const form = document.querySelector<HTMLFormElement>('#baseline-form');
+const formError = document.querySelector<HTMLElement>('#baseline-form-error');
+const typeSelect = document.querySelector<HTMLSelectElement>('#baseline-device-type');
+const organizationSelect = document.querySelector<HTMLSelectElement>('#baseline-organization');
+const changeDialog = document.querySelector<HTMLDialogElement>('#baseline-change-dialog');
+const changeDescription = document.querySelector<HTMLTextAreaElement>('#baseline-change-description');
+const changeError = document.querySelector<HTMLElement>('#baseline-change-error');
+
+const showMessage = (text: string, kind: 'success' | 'error' = 'success') => notify('#baseline-message', text, kind, 5200);
+
+const code = (baseline: ConfigurationBaseline) => `BL-${String(baseline.id).padStart(3, '0')}`;
+const typeFor = (id: number) => state.deviceTypes.find((type) => type.id === id);
+const organizationFor = (id: number) => state.organizations.find((org) => org.id === id);
+const activeRulesFor = (baselineId: number) =>
+  state.rules.filter((rule) => rule.baselineId === baselineId && rule.estado === 'ACTIVA');
+const versionsOf = (baseline: ConfigurationBaseline) => state.baselines
+  .filter((item) => item.organizacionId === baseline.organizacionId
+    && item.nombre.toLowerCase() === baseline.nombre.toLowerCase())
+  .sort((a, b) => b.version - a.version);
+const statusClass = (estado: ConfigurationBaseline['estado']) => estado === 'ACTIVO' ? 'status-ready' : 'status-next';
+
+function filteredBaselines(): ConfigurationBaseline[] {
+  const query = search?.value.trim().toLowerCase() ?? '';
+  const status = statusFilter?.value ?? '';
+  return state.baselines.filter((baseline) => {
+    const type = typeFor(baseline.tipoDispositivoId);
+    const org = organizationFor(baseline.organizacionId);
+    const haystack = [baseline.nombre, baseline.descripcion, type?.nombre ?? '', org?.razonSocial ?? ''].join(' ').toLowerCase();
+    return (!query || haystack.includes(query)) && (!status || baseline.estado === status);
+  });
+}
+
+function buildRow(baseline: ConfigurationBaseline): HTMLTableRowElement {
+  const row = document.createElement('tr');
+  row.className = 'policy-row';
+  row.classList.toggle('is-selected', state.current?.id === baseline.id);
+  row.tabIndex = 0;
+  row.dataset.baselineId = String(baseline.id);
+  const org = organizationFor(baseline.organizacionId);
+  const type = typeFor(baseline.tipoDispositivoId);
+
+  const name = document.createElement('td');
+  const strong = document.createElement('strong');
+  strong.textContent = baseline.nombre;
+  const small = document.createElement('small');
+  small.textContent = code(baseline);
+  name.append(strong, small);
+
+  const organization = document.createElement('td');
+  organization.textContent = org?.razonSocial ?? t('dispositivos.organizacionNumero', { id: baseline.organizacionId });
+
+  const deviceType = document.createElement('td');
+  deviceType.textContent = type?.nombre ?? `#${baseline.tipoDispositivoId}`;
+
+  const version = document.createElement('td');
+  const versionCode = document.createElement('code');
+  versionCode.textContent = `v${baseline.version}`;
+  version.appendChild(versionCode);
+
+  const rules = document.createElement('td');
+  rules.textContent = String(activeRulesFor(baseline.id).length);
+
+  const usage = document.createElement('td');
+  const usageText = document.createElement('small');
+  usageText.textContent = baseline.auditorias > 0 ? plural(baseline.auditorias, 'tablero.auditoria') : t('baselines.sinUso');
+  usage.appendChild(usageText);
+
+  const status = document.createElement('td');
+  const badge = document.createElement('span');
+  badge.className = `status-badge ${statusClass(baseline.estado)}`;
+  badge.textContent = recordStatusCode(baseline.estado);
+  status.appendChild(badge);
+
+  row.append(name, organization, deviceType, version, rules, usage, status);
+  const inspect = () => void inspectBaseline(baseline.id);
+  row.addEventListener('click', inspect);
+  row.addEventListener('keydown', (event) => {
+    if (event.key === 'Enter' || event.key === ' ') inspect();
+  });
+  return row;
+}
+
+function render(): void {
+  const baselines = filteredBaselines();
+  if (count) count.textContent = plural(state.baselines.length, 'baselines.cantidad');
+  if (!body || !empty) return;
+  body.replaceChildren(...baselines.map(buildRow));
+  empty.classList.toggle('is-hidden', baselines.length > 0);
+  document.querySelector('.policy-table')?.classList.toggle('is-hidden', baselines.length === 0);
+}
+
+function renderVersions(baseline: ConfigurationBaseline): void {
+  const container = document.querySelector('#baseline-inspector-versions');
+  if (!container) return;
+  container.replaceChildren(...versionsOf(baseline).map((version) => {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'baseline-version-item';
+    button.classList.toggle('is-current', version.id === baseline.id);
+    const label = document.createElement('code');
+    label.textContent = `v${version.version}`;
+    const detail = document.createElement('span');
+    detail.textContent = t('baselines.versionResumen', { estado: recordStatusCode(version.estado).toLowerCase(), n: version.auditorias });
+    button.append(label, detail);
+    button.addEventListener('click', () => void inspectBaseline(version.id));
+    return button;
+  }));
+}
+
+async function inspectBaseline(id: number): Promise<void> {
+  const [baselineResponse, rulesResponse] = await Promise.all([
+    auditFetch(`/api/baselines/${id}`),
+    auditFetch(`/api/baselines/${id}/rules`),
+  ]);
+  if (!baselineResponse.ok) return showMessage(await readApiError(baselineResponse), 'error');
+  if (!rulesResponse.ok) return showMessage(await readApiError(rulesResponse), 'error');
+
+  const baseline = await baselineResponse.json() as ConfigurationBaseline;
+  const rules = await rulesResponse.json() as BaselineRule[];
+  state.current = baseline;
+  document.querySelectorAll<HTMLElement>('.policy-row').forEach((row) => {
+    row.classList.toggle('is-selected', row.dataset.baselineId === String(baseline.id));
+  });
+
+  const org = organizationFor(baseline.organizacionId);
+  const type = typeFor(baseline.tipoDispositivoId);
+  const activeRules = rules.filter((rule) => rule.estado === 'ACTIVA').length;
+  const frozen = baseline.auditorias > 0;
+
+  setText('#baseline-inspector-code', code(baseline));
+  setText('#baseline-inspector-name', baseline.nombre);
+  setText('#baseline-inspector-status', recordStatusCode(baseline.estado));
+  setText('#baseline-inspector-description', baseline.descripcion);
+  setText('#baseline-inspector-organization', org?.razonSocial ?? `#${baseline.organizacionId}`);
+  setText('#baseline-inspector-type', type ? `${type.nombre} / ${type.familia}` : `#${baseline.tipoDispositivoId}`);
+  setText('#baseline-inspector-version', `v${baseline.version}`);
+  setText('#baseline-inspector-rules', t('baselines.reglasActivas', { activas: activeRules, total: rules.length }));
+  setText('#baseline-inspector-audits', String(baseline.auditorias));
+  setText('#baseline-inspector-id', String(baseline.id));
+  setText('#baseline-inspector-policy', t(frozen ? 'baselines.reglasCongeladas' : 'baselines.baselineReglas'));
+  setText('#baseline-inspector-policy-text', t(frozen
+    ? 'baselines.congeladaAyuda'
+    : baseline.estado === 'ACTIVO' ? 'baselines.activaAyuda' : 'baselines.inactivaAyuda'));
+  setText('#baseline-toggle', t(baseline.estado === 'ACTIVO' ? 'baselines.desactivar' : 'baselines.activar'));
+
+  const status = document.querySelector('#baseline-inspector-status');
+  if (status) status.className = `status-badge ${statusClass(baseline.estado)}`;
+  renderVersions(baseline);
+  document.querySelector('#baseline-inspector-empty')?.classList.add('is-hidden');
+  document.querySelector('#baseline-inspector-content')?.classList.remove('is-hidden');
+}
+
+async function load(): Promise<void> {
+  const [baselineResponse, rulesResponse, typesResponse, organizationsResponse] = await Promise.all([
+    auditFetch('/api/baselines'),
+    auditFetch('/api/rules'),
+    auditFetch('/api/device-types'),
+    authFetch('/api/client-organizations'),
+  ]);
+  for (const response of [baselineResponse, rulesResponse, typesResponse, organizationsResponse]) {
+    if (!response.ok) throw new Error(await readApiError(response));
+  }
+  state.baselines = await baselineResponse.json() as ConfigurationBaseline[];
+  state.rules = await rulesResponse.json() as BaselineRule[];
+  state.deviceTypes = (await typesResponse.json() as DeviceType[]).filter((type) => type.activo);
+  state.organizations = await organizationsResponse.json() as Organization[];
+
+  typeSelect?.replaceChildren(new Option(t('dispositivos.seleccionarTipo'), ''));
+  state.deviceTypes.forEach((type) => typeSelect?.add(new Option(`${type.nombre} · ${type.fabricante} · ${type.familia}`, String(type.id))));
+  organizationSelect?.replaceChildren(new Option(t('dispositivos.seleccionarOrganizacion'), ''));
+  state.organizations.forEach((org) => organizationSelect?.add(new Option(org.razonSocial, String(org.id))));
+  if (organizationSelect && state.organizations.length === 1) organizationSelect.value = String(state.organizations[0].id);
+  render();
+}
+
+async function reloadAndInspect(id: number): Promise<void> {
+  await load();
+  await inspectBaseline(id);
+}
+
+function openDialog(): void {
+  form?.reset();
+  formError?.classList.add('is-hidden');
+  if (organizationSelect && state.organizations.length === 1) organizationSelect.value = String(state.organizations[0].id);
+  dialog?.showModal();
+}
+
+document.querySelector('#open-baseline-dialog')?.addEventListener('click', openDialog);
+document.querySelector('#close-baseline-dialog')?.addEventListener('click', () => dialog?.close());
+document.querySelector('#cancel-baseline-dialog')?.addEventListener('click', () => dialog?.close());
+document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
+  button.addEventListener('click', () => button.closest('dialog')?.close());
+});
+search?.addEventListener('input', render);
+statusFilter?.addEventListener('change', render);
+
+form?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  formError?.classList.add('is-hidden');
+  const payload = {
+    nombre: (document.querySelector<HTMLInputElement>('#baseline-name')?.value ?? '').trim(),
+    descripcion: (document.querySelector<HTMLTextAreaElement>('#baseline-description')?.value ?? '').trim(),
+    tipoDispositivoId: Number(typeSelect?.value),
+    organizacionId: Number(organizationSelect?.value),
+  };
+
+  const response = await auditFetch('/api/baselines', jsonRequest('POST', payload));
+  if (!response.ok) {
+    if (formError) {
+      formError.textContent = await readApiError(response);
+      formError.classList.remove('is-hidden');
+    }
+    return;
+  }
+
+  const created = await response.json() as ConfigurationBaseline;
+  dialog?.close();
+  showMessage(t('baselines.creada', { nombre: created.nombre }));
+  await reloadAndInspect(created.id);
+});
+
+// Editar descripción / nueva versión
+function openChangeDialog(mode: 'description' | 'version'): void {
+  const baseline = state.current;
+  if (!baseline || !changeDescription) return;
+  state.changeMode = mode;
+  changeError?.classList.add('is-hidden');
+  changeDescription.value = baseline.descripcion;
+
+  const next = Math.max(...versionsOf(baseline).map((item) => item.version)) + 1;
+  const copied = activeRulesFor(baseline.id).length;
+  const current = state.baselines.find((item) => item.estado === 'ACTIVO'
+    && item.organizacionId === baseline.organizacionId
+    && item.tipoDispositivoId === baseline.tipoDispositivoId);
+
+  if (mode === 'description') {
+    setText('#baseline-change-eyebrow', t('baselines.editarBaseline'));
+    setText('#baseline-change-title', t('baselines.editarTitulo', { nombre: baseline.nombre, version: baseline.version }));
+    setText('#baseline-change-subtitle', t('baselines.descripcionNoVersiona'));
+    setText('#baseline-change-code', 'operacion = MODIFICACION');
+    setText('#baseline-change-text', t('baselines.cambioBitacora'));
+    setText('#baseline-change-submit', t('baselines.guardarDescripcion'));
+  } else {
+    setText('#baseline-change-eyebrow', t('baselines.nuevaVersionBaseline'));
+    setText('#baseline-change-title', t('baselines.nuevaVersionTitulo', { nombre: baseline.nombre, version: next }));
+    setText('#baseline-change-subtitle', t('baselines.generaDesde', { version: baseline.version }));
+    setText('#baseline-change-code', t('baselines.reglasCopiadas', { n: copied }));
+    setText('#baseline-change-text', current
+      ? t('baselines.reemplaza', { version: next, nombre: current.nombre, anterior: current.version })
+      : t('baselines.quedaActiva', { version: next }));
+    setText('#baseline-change-submit', t('baselines.generarVersion', { version: next }));
+  }
+  changeDialog?.showModal();
+}
+
+document.querySelector('#baseline-edit')?.addEventListener('click', () => openChangeDialog('description'));
+document.querySelector('#baseline-version')?.addEventListener('click', () => openChangeDialog('version'));
+
+document.querySelector<HTMLFormElement>('#baseline-change-form')?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const baseline = state.current;
+  if (!baseline) return;
+  changeError?.classList.add('is-hidden');
+  const descripcion = (changeDescription?.value ?? '').trim();
+
+  const response = state.changeMode === 'description'
+    ? await auditFetch(`/api/baselines/${baseline.id}`, jsonRequest('PUT', { descripcion }))
+    : await auditFetch(`/api/baselines/${baseline.id}/versions`, jsonRequest('POST', { descripcion }));
+  if (!response.ok) {
+    if (changeError) {
+      changeError.textContent = await readApiError(response);
+      changeError.classList.remove('is-hidden');
+    }
+    return;
+  }
+  const saved = await response.json() as ConfigurationBaseline;
+  changeDialog?.close();
+  showMessage(state.changeMode === 'description'
+    ? t('baselines.descripcionActualizada', { nombre: saved.nombre, version: saved.version })
+    : t('baselines.versionGenerada', { nombre: saved.nombre, version: saved.version }));
+  await reloadAndInspect(saved.id);
+});
+
+// Activar / desactivar
+document.querySelector('#baseline-toggle')?.addEventListener('click', async () => {
+  const baseline = state.current;
+  if (!baseline) return;
+  const deactivate = baseline.estado === 'ACTIVO';
+  const question = deactivate
+    ? t('baselines.confirmarDesactivar', { nombre: baseline.nombre, version: baseline.version })
+    : t('baselines.confirmarActivar', { nombre: baseline.nombre, version: baseline.version });
+  if (!await confirmAction(t('general.confirmasOperacion'), question, t(deactivate ? 'baselines.desactivar' : 'baselines.activar'))) return;
+
+  const response = await auditFetch(`/api/baselines/${baseline.id}/status`,
+    jsonRequest('PATCH', { estado: deactivate ? 'INACTIVO' : 'ACTIVO' }));
+  if (!response.ok) {
+    showMessage(await readApiError(response), 'error');
+    return;
+  }
+  const saved = await response.json() as ConfigurationBaseline;
+  showMessage(t('baselines.ahoraEsta', { nombre: saved.nombre, version: saved.version, estado: recordStatusCode(saved.estado) }));
+  await reloadAndInspect(saved.id);
+});
+
+load().catch((error) => {
+  showMessage(error instanceof Error ? error.message : t('baselines.errorCargar'), 'error');
+});
diff --git a/frontend/web-app/src/scripts/client-status.ts b/frontend/web-app/src/scripts/client-status.ts
new file mode 100644
index 0000000..268c2f3
--- /dev/null
+++ b/frontend/web-app/src/scripts/client-status.ts
@@ -0,0 +1,109 @@
+// Estado del cliente: riesgo por sede y por dispositivo de una organización.
+import { auditFetch, authFetch, getStoredUser, hasRole } from '../lib/auth';
+import { readApiError, type ClientAuditStatus, type NetworkDevice, type Organization, type ReviewStatus, type Site, type SiteRisk } from '../lib/api';
+import { code, escapeHtml, formatDate, riskBadge } from '../lib/format';
+import { deviceRiskRowsHtml, kpiHtml, recentAuditsHtml, riskBannerHtml, severityChartHtml, wireTooltips } from '../lib/dashboard-view';
+import { t } from '../lib/i18n';
+import { setHtml, show } from '../lib/ui';
+
+const isAdmin = hasRole('ADMINISTRADOR_SISTEMA');
+const params = new URLSearchParams(window.location.search);
+let organizations: Organization[] = [];
+let devices: NetworkDevice[] = [];
+let sites: Site[] = [];
+let loadSeq = 0;
+
+const showError = (message: string | null) => show('#client-error', message);
+
+const siteRowsHtml = (rows: SiteRisk[]) => rows.map((row) => {
+  const name = row.sedeId == null
+    ? t('cliente.sinSedeAsignada')
+    : sites.find((site) => site.id === row.sedeId)?.nombre ?? t('tablero.sedeNumero', { id: row.sedeId });
+  return `
+    <tr class="${row.nivel === 'ALTO' ? 'is-critical' : ''}">
+      <td><strong>${escapeHtml(name)}</strong></td>
+      <td>${riskBadge(row.nivel)}</td>
+      <td>${row.dispositivos}</td>
+      <td>${row.auditados}/${row.dispositivos}</td>
+      <td>${row.pendientes}</td>
+      <td>${row.criticosPendientes}</td>
+      <td>${row.alertasVigentes > 0 && row.sedeId != null
+        ? `<a class="inline-link" href="/alerts?sede=${row.sedeId}">${row.alertasVigentes} →</a>`
+        : row.alertasVigentes}</td>
+    </tr>`;
+}).join('');
+
+const load = async (organizationId: number) => {
+  showError(null);
+  const seq = ++loadSeq;
+  const [statusResponse, siteResponse, deviceResponse, reviewResponse] = await Promise.all([
+    auditFetch(`/api/client-organizations/${organizationId}/audit-status`),
+    authFetch(`/api/client-organizations/${organizationId}/sites`),
+    auditFetch('/api/devices'),
+    auditFetch(`/api/review/status?organizationId=${organizationId}`),
+  ]);
+  if (seq !== loadSeq) return;
+  if (!statusResponse.ok) {
+    showError(await readApiError(statusResponse));
+    return;
+  }
+  const status = await statusResponse.json() as ClientAuditStatus;
+  sites = siteResponse.ok ? await siteResponse.json() as Site[] : [];
+  devices = deviceResponse.ok ? await deviceResponse.json() as NetworkDevice[] : [];
+  const review = reviewResponse.ok ? await reviewResponse.json() as ReviewStatus : null;
+  if (seq !== loadSeq) return;
+
+  const organization = organizations.find((item) => item.id === organizationId);
+  const title = document.querySelector('#client-title');
+  if (title) title.textContent = organization ? organization.razonSocial : t('dispositivos.organizacionNumero', { id: organizationId });
+
+  const summary = status.resumen;
+  setHtml('#client-risk', riskBannerHtml(summary, organization?.razonSocial ?? t('general.organizacion')));
+  setHtml('#client-kpis', kpiHtml(summary, review));
+  setHtml('#client-sites', siteRowsHtml(status.sedes));
+  document.querySelector('#client-sites-empty')?.classList.toggle('is-hidden', status.sedes.length > 0);
+  setHtml('#client-severity', severityChartHtml(summary));
+  setHtml('#client-recent', recentAuditsHtml(summary.auditoriasRecientes,
+    (id) => devices.find((device) => device.id === id)?.identificador ?? `#${id}`));
+  setHtml('#client-devices', deviceRiskRowsHtml(status.dispositivos, sites));
+  setHtml('#client-reports', status.reportes.length === 0
+    ? `<p class="log-muted">${escapeHtml(t('cliente.sinReportes'))}</p>`
+    : `<ul class="compare-list">${status.reportes.map((report) => `
+        <li class="compare-item">
+          <a class="inline-link" href="/reports?reporte=${report.id}"><code>${code('REP', report.id)}</code></a>
+          <span>${escapeHtml(report.titulo)}</span>
+          <small>${escapeHtml(formatDate(report.fechaGeneracion))}</small>
+        </li>`).join('')}</ul>`);
+  if (!siteResponse.ok) showError(t('cliente.errorSedes'));
+  wireTooltips(document);
+};
+
+const start = async () => {
+  if (isAdmin) {
+    const response = await authFetch('/api/client-organizations');
+    if (!response.ok) throw new Error(await readApiError(response));
+    organizations = await response.json() as Organization[];
+    if (organizations.length === 0) throw new Error(t('cliente.sinOrganizaciones'));
+    const select = document.querySelector<HTMLSelectElement>('#client-org');
+    organizations.forEach((organization) => select?.add(new Option(organization.razonSocial, String(organization.id))));
+    const requested = Number(params.get('organizacion'));
+    const initial = organizations.some((item) => item.id === requested) ? requested : organizations[0].id;
+    if (select) {
+      select.value = String(initial);
+      select.addEventListener('change', () => {
+        window.history.replaceState(null, '', `?organizacion=${select.value}`);
+        void load(Number(select.value));
+      });
+    }
+    document.querySelector('#client-org-filter')?.removeAttribute('hidden');
+    await load(initial);
+    return;
+  }
+  const own = getStoredUser()?.organizationId;
+  if (!own) throw new Error(t('tablero.sinOrganizacion'));
+  const response = await authFetch(`/api/client-organizations/${own}`);
+  if (response.ok) organizations = [await response.json() as Organization];
+  await load(own);
+};
+
+start().catch((error) => showError(error instanceof Error ? error.message : t('cliente.errorEstado')));
diff --git a/frontend/web-app/src/scripts/dashboard.ts b/frontend/web-app/src/scripts/dashboard.ts
new file mode 100644
index 0000000..6a4fc8b
--- /dev/null
+++ b/frontend/web-app/src/scripts/dashboard.ts
@@ -0,0 +1,113 @@
+// Tablero de control: indicadores, gráficos, alertas y auditorías recientes.
+import { auditFetch, authFetch, getStoredUser, hasRole } from '../lib/auth';
+import { readApiError, type CriticalAlert, type DashboardSummary, type NetworkDevice, type Organization, type ReviewStatus, type Site, type User } from '../lib/api';
+import { alertStatusBadge, code, escapeHtml, severityClass, severityCode } from '../lib/format';
+import { t } from '../lib/i18n';
+import {
+  deviceRiskRowsHtml,
+  evolutionChartHtml,
+  kpiHtml,
+  recentAuditsHtml,
+  riskBannerHtml,
+  severityChartHtml,
+  wireTooltips,
+} from '../lib/dashboard-view';
+import { loadVisibleSites } from '../lib/sites';
+import { setHtml, show } from '../lib/ui';
+
+const isAdmin = hasRole('ADMINISTRADOR_SISTEMA');
+let devices: NetworkDevice[] = [];
+let sites: Site[] = [];
+let organizations: Organization[] = [];
+let loadSeq = 0;
+
+const showError = (message: string | null) => show('#dash-error', message);
+const deviceName = (id: number) => devices.find((device) => device.id === id)?.identificador ?? `#${id}`;
+const selectedOrg = () => Number(document.querySelector<HTMLSelectElement>('#dash-org')?.value) || null;
+
+const alertsHtml = (alerts: CriticalAlert[]) => alerts.length === 0
+  ? `<p class="log-muted">${escapeHtml(t('tablero.sinEventos'))}</p>`
+  : `<ul class="compare-list">${alerts.slice(0, 5).map((alert) => `
+      <li class="compare-item ${alert.severidad === 'CRITICA' ? 'compare-nuevo_hallazgo' : ''}">
+        <a class="inline-link" href="/alerts?alerta=${alert.id}"><code>${code('ALR', alert.id)}</code></a>
+        <span>${escapeHtml(alert.codigoRegla ?? '')} · ${escapeHtml(alert.dispositivoIdentificador ?? `#${alert.dispositivoId}`)}</span>
+        <span class="badge-row"><span class="severity-badge ${severityClass(alert.severidad)}">${escapeHtml(severityCode(alert.severidad))}</span>${alertStatusBadge(alert.estado)}</span>
+      </li>`).join('')}</ul>${alerts.length > 5 ? `<p class="log-muted">${escapeHtml(t('tablero.yMas', { n: alerts.length - 5 }))}</p>` : ''}`;
+
+const load = async () => {
+  showError(null);
+  const org = selectedOrg();
+  const seq = ++loadSeq;
+  const [summaryResponse, alertResponse, reviewResponse] = await Promise.all([
+    auditFetch(`/api/dashboard/summary${org ? `?organizacionId=${org}` : ''}`),
+    auditFetch('/api/alerts/critical'),
+    auditFetch(`/api/review/status${org ? `?organizationId=${org}` : ''}`),
+  ]);
+  if (seq !== loadSeq) return;
+  if (!summaryResponse.ok) {
+    showError(await readApiError(summaryResponse));
+    setHtml('#dash-kpis', `<article class="metric-card"><span class="metric-label">${escapeHtml(t('tablero.sinDatos'))}</span><strong>—</strong><small>${escapeHtml(t('tablero.errorResumen'))}</small></article>`);
+    return;
+  }
+  const summary = await summaryResponse.json() as DashboardSummary;
+  const review = reviewResponse.ok ? await reviewResponse.json() as ReviewStatus : null;
+  if (seq !== loadSeq) return;
+
+  const orgName = org
+    ? organizations.find((item) => item.id === org)?.razonSocial ?? t('tablero.organizacionNumero', { id: org })
+    : null;
+  const scope = isAdmin ? orgName ?? t('tablero.todasOrganizaciones') : t('tablero.tuOrganizacion');
+  const title = document.querySelector('#dash-scope-title');
+  if (title) title.textContent = isAdmin && !org ? t('tablero.estadoPlataforma') : t('tablero.estadoDe', { alcance: scope });
+  const clientLink = document.querySelector<HTMLAnchorElement>('#dash-client-link');
+  if (clientLink) {
+    clientLink.href = org ? `/client-status?organizacion=${org}` : '/client-status';
+  }
+
+  setHtml('#dash-risk', riskBannerHtml(summary, scope));
+  setHtml('#dash-kpis', kpiHtml(summary, review));
+  setHtml('#dash-severity', severityChartHtml(summary));
+  setHtml('#dash-evolution', evolutionChartHtml(summary.evolucion));
+  setHtml('#dash-recent', recentAuditsHtml(summary.auditoriasRecientes, deviceName));
+  setHtml('#dash-risk-devices', deviceRiskRowsHtml(summary.dispositivosEnRiesgo, sites));
+  document.querySelector('#dash-risk-empty')?.classList.toggle('is-hidden', summary.dispositivosEnRiesgo.length > 0);
+
+  // Si una sección falla, el resto del tablero se muestra igual.
+  if (alertResponse.ok) {
+    const alerts = (await alertResponse.json() as CriticalAlert[])
+      .filter((alert) => !org || alert.organizacionId === org);
+    setHtml('#dash-alerts', alertsHtml(alerts));
+  } else {
+    setHtml('#dash-alerts', `<p class="log-muted">${escapeHtml(t('tablero.errorAlertas', { error: await readApiError(alertResponse) }))}</p>`);
+  }
+  wireTooltips(document);
+};
+
+const loadReferences = async () => {
+  const [deviceResponse, visibleSites] = await Promise.all([auditFetch('/api/devices'), loadVisibleSites()]);
+  if (deviceResponse.ok) devices = await deviceResponse.json() as NetworkDevice[];
+  sites = visibleSites;
+  if (!isAdmin) return;
+
+  document.querySelector('#dash-org-filter')?.removeAttribute('hidden');
+  document.querySelectorAll('[data-admin-section]').forEach((node) => node.removeAttribute('hidden'));
+  const [orgResponse, userResponse] = await Promise.all([authFetch('/api/client-organizations'), authFetch('/api/users')]);
+  if (orgResponse.ok) {
+    organizations = await orgResponse.json() as Organization[];
+    const select = document.querySelector<HTMLSelectElement>('#dash-org');
+    organizations.forEach((organization) => select?.add(new Option(organization.razonSocial, String(organization.id))));
+    setHtml('#metric-organizations', String(organizations.length));
+    setHtml('#metric-sites', String(sites.length));
+  }
+  if (userResponse.ok) setHtml('#metric-users', String((await userResponse.json() as User[]).length));
+};
+
+document.querySelector('#dash-org')?.addEventListener('change', () => void load());
+
+if (!isAdmin && !getStoredUser()?.organizationId) {
+  showError(t('tablero.sinOrganizacion'));
+}
+loadReferences()
+  .catch(() => {})
+  .then(load)
+  .catch((error) => showError(error instanceof Error ? error.message : t('tablero.errorResumen')));
diff --git a/frontend/web-app/src/scripts/devices.ts b/frontend/web-app/src/scripts/devices.ts
new file mode 100644
index 0000000..89c6722
--- /dev/null
+++ b/frontend/web-app/src/scripts/devices.ts
@@ -0,0 +1,459 @@
+// Dispositivos: inventario, alta, edición, baja lógica y tipos de dispositivo.
+import { auditFetch, authFetch } from '../lib/auth';
+import {
+  jsonRequest,
+  readApiError,
+  type DeviceType,
+  type NetworkDevice,
+  type Organization,
+  type Site,
+} from '../lib/api';
+import { plural, recordStatusCode, severityCode } from '../lib/format';
+import { t } from '../lib/i18n';
+import { confirmAction, notify, setText } from '../lib/ui';
+
+const state = {
+  devices: [] as NetworkDevice[],
+  deviceTypes: [] as DeviceType[],
+  organizations: [] as Organization[],
+  sitesByOrganization: new Map<number, Site[]>(),
+  current: null as NetworkDevice | null,
+  editing: null as NetworkDevice | null,
+};
+
+const body = document.querySelector<HTMLTableSectionElement>('#devices-body');
+const empty = document.querySelector<HTMLElement>('#devices-empty');
+const count = document.querySelector<HTMLElement>('#device-count');
+const search = document.querySelector<HTMLInputElement>('#device-search');
+const criticalityFilter = document.querySelector<HTMLSelectElement>('#device-criticality-filter');
+const statusFilter = document.querySelector<HTMLSelectElement>('#device-status-filter');
+const dialog = document.querySelector<HTMLDialogElement>('#device-dialog');
+const form = document.querySelector<HTMLFormElement>('#device-form');
+const formError = document.querySelector<HTMLElement>('#device-form-error');
+const typeDialog = document.querySelector<HTMLDialogElement>('#type-dialog');
+
+const typeSelect = document.querySelector<HTMLSelectElement>('#device-type');
+const vendorInput = document.querySelector<HTMLInputElement>('#device-vendor');
+const organizationSelect = document.querySelector<HTMLSelectElement>('#device-organization');
+const siteSelect = document.querySelector<HTMLSelectElement>('#device-site');
+const saveButton = document.querySelector<HTMLButtonElement>('#save-device');
+
+const showMessage = (text: string, kind: 'success' | 'error' = 'success') => notify('#device-message', text, kind, 4200);
+
+function typeFor(id: number): DeviceType | undefined {
+  return state.deviceTypes.find((type) => type.id === id);
+}
+
+function organizationFor(id: number): Organization | undefined {
+  return state.organizations.find((organization) => organization.id === id);
+}
+
+function siteFor(device: NetworkDevice): Site | undefined {
+  if (!device.sedeId) return undefined;
+  return state.sitesByOrganization.get(device.organizacionId)?.find((site) => site.id === device.sedeId);
+}
+
+function criticalityClass(value: NetworkDevice['criticidad']): string {
+  if (value === 'CRITICA') return 'severity-critical';
+  if (value === 'ALTA') return 'severity-high';
+  if (value === 'MEDIA') return 'severity-medium';
+  return 'severity-low';
+}
+
+function statusClass(value: NetworkDevice['estado']): string {
+  return value === 'ACTIVO' ? 'status-ready' : 'status-next';
+}
+
+function filteredDevices(): NetworkDevice[] {
+  const query = search?.value.trim().toLowerCase() ?? '';
+  const criticality = criticalityFilter?.value ?? '';
+  const status = statusFilter?.value ?? '';
+
+  return state.devices.filter((device) => {
+    const type = typeFor(device.tipoDispositivoId);
+    const haystack = [device.identificador, device.nombre, device.fabricante, type?.nombre ?? '']
+      .join(' ')
+      .toLowerCase();
+    return (!query || haystack.includes(query))
+      && (!criticality || device.criticidad === criticality)
+      && (!status || device.estado === status);
+  });
+}
+
+function buildRow(device: NetworkDevice): HTMLTableRowElement {
+  const row = document.createElement('tr');
+  row.className = 'device-row';
+  row.classList.toggle('is-selected', state.current?.id === device.id);
+  row.tabIndex = 0;
+  row.dataset.deviceId = String(device.id);
+
+  const type = typeFor(device.tipoDispositivoId);
+  const site = siteFor(device);
+  const organization = organizationFor(device.organizacionId);
+
+  const identifier = document.createElement('td');
+  const identifierCode = document.createElement('code');
+  identifierCode.textContent = device.identificador;
+  identifier.appendChild(identifierCode);
+
+  const name = document.createElement('td');
+  const nameStrong = document.createElement('strong');
+  nameStrong.textContent = device.nombre;
+  const vendorSmall = document.createElement('small');
+  vendorSmall.textContent = device.fabricante;
+  name.append(nameStrong, vendorSmall);
+
+  const typeCell = document.createElement('td');
+  typeCell.textContent = type?.nombre ?? `#${device.tipoDispositivoId}`;
+
+  const location = document.createElement('td');
+  const locationStrong = document.createElement('strong');
+  locationStrong.textContent = site?.nombre ?? t('dispositivos.sinSedeEspecifica');
+  const organizationSmall = document.createElement('small');
+  organizationSmall.textContent = organization?.razonSocial ?? t('dispositivos.organizacionNumero', { id: device.organizacionId });
+  location.append(locationStrong, organizationSmall);
+
+  const criticality = document.createElement('td');
+  const criticalityBadge = document.createElement('span');
+  criticalityBadge.className = `severity-badge ${criticalityClass(device.criticidad)}`;
+  criticalityBadge.textContent = severityCode(device.criticidad);
+  criticality.appendChild(criticalityBadge);
+
+  const status = document.createElement('td');
+  const statusBadge = document.createElement('span');
+  statusBadge.className = `status-badge ${statusClass(device.estado)}`;
+  statusBadge.textContent = recordStatusCode(device.estado);
+  status.appendChild(statusBadge);
+
+  row.append(identifier, name, typeCell, location, criticality, status);
+
+  const inspect = () => void inspectDevice(device.id);
+  row.addEventListener('click', inspect);
+  row.addEventListener('keydown', (event) => {
+    if (event.key === 'Enter' || event.key === ' ') inspect();
+  });
+
+  return row;
+}
+
+function renderDevices(): void {
+  const devices = filteredDevices();
+  if (count) count.textContent = plural(state.devices.length, 'dispositivos.activos');
+  if (!body || !empty) return;
+
+  body.replaceChildren(...devices.map(buildRow));
+  empty.classList.toggle('is-hidden', devices.length > 0);
+  document.querySelector('.device-table')?.classList.toggle('is-hidden', devices.length === 0);
+}
+
+async function inspectDevice(id: number): Promise<void> {
+  const response = await auditFetch(`/api/devices/${id}`);
+  if (!response.ok) {
+    showMessage(await readApiError(response), 'error');
+    return;
+  }
+
+  const device = await response.json() as NetworkDevice;
+  showDevice(device);
+}
+
+function showDevice(device: NetworkDevice): void {
+  state.current = device;
+  document.querySelectorAll<HTMLElement>('.device-row').forEach((row) => {
+    row.classList.toggle('is-selected', row.dataset.deviceId === String(device.id));
+  });
+
+  const type = typeFor(device.tipoDispositivoId);
+  const organization = organizationFor(device.organizacionId);
+  const site = siteFor(device);
+  const active = device.estado === 'ACTIVO';
+
+  setText('#inspector-identifier', device.identificador);
+  setText('#inspector-name', device.nombre);
+  setText('#inspector-status', recordStatusCode(device.estado));
+  setText('#inspector-type', type ? `${type.nombre} / ${type.familia}` : `#${device.tipoDispositivoId}`);
+  setText('#inspector-vendor', device.fabricante);
+  setText('#inspector-organization', organization?.razonSocial ?? `#${device.organizacionId}`);
+  setText('#inspector-site', site?.nombre ?? t('dispositivos.sinSedeEspecifica'));
+  setText('#inspector-criticality', severityCode(device.criticidad));
+  setText('#inspector-id', String(device.id));
+  setText('#inspector-scope', active ? 'scope = audit_ready' : 'scope = baja_logica');
+  setText('#inspector-scope-text', t(active ? 'dispositivos.disponibleFuturasConfiguracionesBaselines' : 'dispositivos.conservaHistorial'));
+  setText('#toggle-device-status', t(active ? 'dispositivos.darBaja' : 'dispositivos.reactivar'));
+
+  const status = document.querySelector('#inspector-status');
+  if (status) status.className = `status-badge ${statusClass(device.estado)}`;
+
+  document.querySelector('#device-inspector-empty')?.classList.add('is-hidden');
+  document.querySelector('#device-inspector-content')?.classList.remove('is-hidden');
+}
+
+async function loadSites(organizationId: number, refresh = false): Promise<Site[]> {
+  if (!refresh && state.sitesByOrganization.has(organizationId)) {
+    return state.sitesByOrganization.get(organizationId) ?? [];
+  }
+
+  const response = await authFetch(`/api/client-organizations/${organizationId}/sites`);
+  if (!response.ok) return [];
+  const sites = await response.json() as Site[];
+  state.sitesByOrganization.set(organizationId, sites);
+  return sites;
+}
+
+function fillTypeSelect(selected?: number): void {
+  if (!typeSelect) return;
+  typeSelect.replaceChildren(new Option(t('dispositivos.seleccionarTipo'), ''));
+  state.deviceTypes.forEach((type) => {
+    typeSelect.add(new Option(`${type.nombre} · ${type.fabricante} · ${type.familia}`, String(type.id)));
+  });
+  if (selected) typeSelect.value = String(selected);
+}
+
+async function loadDeviceTypes(): Promise<void> {
+  const response = await auditFetch('/api/device-types');
+  if (!response.ok) throw new Error(await readApiError(response));
+  state.deviceTypes = (await response.json() as DeviceType[]).filter((type) => type.activo);
+}
+
+async function loadReferenceData(): Promise<void> {
+  const organizationsResponse = await authFetch('/api/client-organizations');
+  if (!organizationsResponse.ok) throw new Error(await readApiError(organizationsResponse));
+  await loadDeviceTypes();
+  state.organizations = await organizationsResponse.json() as Organization[];
+
+  await Promise.all(state.organizations.map((organization) => loadSites(organization.id)));
+
+  fillTypeSelect();
+  if (organizationSelect) {
+    organizationSelect.replaceChildren(new Option(t('dispositivos.seleccionarOrganizacion'), ''));
+    state.organizations.forEach((organization) => {
+      const disabled = organization.estado !== 'ACTIVO' ? ` ${t('dispositivos.deshabilitada')}` : '';
+      organizationSelect.add(new Option(`${organization.razonSocial}${disabled}`, String(organization.id)));
+    });
+  }
+}
+
+async function loadDevices(): Promise<void> {
+  const response = await auditFetch('/api/devices');
+  if (!response.ok) throw new Error(await readApiError(response));
+  state.devices = await response.json() as NetworkDevice[];
+  renderDevices();
+}
+
+async function updateSiteSelect(selected?: number | null): Promise<void> {
+  if (!organizationSelect || !siteSelect) return;
+  const organizationId = Number(organizationSelect.value);
+  siteSelect.replaceChildren(new Option(t('dispositivos.sinSedeEspecifica'), ''));
+
+  if (!organizationId) {
+    siteSelect.disabled = true;
+    return;
+  }
+
+  // Se vuelve a consultar por si se registraron sedes nuevas en otra pantalla.
+  const sites = await loadSites(organizationId, true);
+  sites.forEach((site) => {
+    // Una sede deshabilitada no admite dispositivos nuevos; se muestra solo si el equipo ya estaba ahí.
+    if (site.estado !== 'ACTIVO' && site.id !== selected) return;
+    const label = `${site.nombre} · ${site.ubicacion}${site.estado !== 'ACTIVO' ? ` ${t('dispositivos.deshabilitada')}` : ''}`;
+    siteSelect.add(new Option(label, String(site.id)));
+  });
+  siteSelect.disabled = false;
+  if (selected) siteSelect.value = String(selected);
+}
+
+// Alta y edición de dispositivos
+function setDialogMode(device: NetworkDevice | null): void {
+  state.editing = device;
+  const editing = device !== null;
+  setText('#device-dialog-eyebrow', t(editing ? 'dispositivos.editarDispositivo' : 'dispositivos.nuevoDispositivo'));
+  setText('#device-dialog-title', editing
+    ? t('dispositivos.editarIdentificador', { identificador: device.identificador })
+    : t('dispositivos.registrarDispositivo'));
+  setText('#device-dialog-subtitle', t(editing ? 'dispositivos.cambiosBitacora' : 'dispositivos.incorporaActivoRedInventario'));
+  setText('#device-form-state', t('dispositivos.estadoCodigo', { estado: recordStatusCode(editing ? device.estado : 'ACTIVO') }));
+  setText('#device-form-state-text', t(editing ? 'dispositivos.organizacionNoCambia' : 'dispositivos.estadoInicialAsignaAutomaticamente'));
+  if (saveButton) saveButton.textContent = t(editing ? 'general.guardarCambios' : 'dispositivos.registrarDispositivo');
+  if (organizationSelect) organizationSelect.disabled = editing;
+}
+
+async function openDeviceDialog(device: NetworkDevice | null): Promise<void> {
+  form?.reset();
+  formError?.classList.add('is-hidden');
+  setDialogMode(device);
+
+  const value = (selector: string, text: string) => {
+    const input = document.querySelector<HTMLInputElement | HTMLSelectElement>(selector);
+    if (input) input.value = text;
+  };
+
+  if (device) {
+    // Si el tipo del dispositivo quedó inactivo no figura en la lista: se agrega para no perderlo.
+    if (typeSelect && !typeFor(device.tipoDispositivoId)
+      && !typeSelect.querySelector(`option[value="${device.tipoDispositivoId}"]`)) {
+      typeSelect.add(new Option(t('dispositivos.tipoInactivo', { id: device.tipoDispositivoId }), String(device.tipoDispositivoId)));
+    }
+    value('#device-identifier', device.identificador);
+    value('#device-name', device.nombre);
+    value('#device-type', String(device.tipoDispositivoId));
+    value('#device-vendor', device.fabricante);
+    value('#device-organization', String(device.organizacionId));
+    value('#device-criticality', device.criticidad);
+    await updateSiteSelect(device.sedeId);
+  } else {
+    if (vendorInput) vendorInput.value = '';
+    if (siteSelect) {
+      siteSelect.replaceChildren(new Option(t('dispositivos.sinSedeEspecifica'), ''));
+      siteSelect.disabled = true;
+    }
+    // El administrador de una organización solo ve la suya: se elige sola.
+    if (state.organizations.length === 1 && organizationSelect) {
+      organizationSelect.value = String(state.organizations[0].id);
+      await updateSiteSelect();
+    }
+  }
+  dialog?.showModal();
+}
+
+typeSelect?.addEventListener('change', () => {
+  const type = typeFor(Number(typeSelect.value));
+  if (vendorInput) vendorInput.value = type?.fabricante ?? '';
+});
+
+organizationSelect?.addEventListener('change', () => void updateSiteSelect());
+search?.addEventListener('input', renderDevices);
+criticalityFilter?.addEventListener('change', renderDevices);
+statusFilter?.addEventListener('change', renderDevices);
+
+document.querySelector('#open-device-dialog')?.addEventListener('click', () => void openDeviceDialog(null));
+document.querySelector('#edit-device')?.addEventListener('click', () => {
+  if (state.current) void openDeviceDialog(state.current);
+});
+
+const closeDialog = () => dialog?.close();
+document.querySelector('#close-device-dialog')?.addEventListener('click', closeDialog);
+document.querySelector('#cancel-device-dialog')?.addEventListener('click', closeDialog);
+dialog?.addEventListener('click', (event) => {
+  if (event.target === dialog) closeDialog();
+});
+
+form?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  formError?.classList.add('is-hidden');
+
+  const editing = state.editing;
+  const selectedType = typeFor(Number(typeSelect?.value));
+  const fields = {
+    nombre: document.querySelector<HTMLInputElement>('#device-name')?.value.trim(),
+    identificador: document.querySelector<HTMLInputElement>('#device-identifier')?.value.trim(),
+    tipoDispositivoId: Number(typeSelect?.value),
+    fabricante: selectedType?.fabricante ?? vendorInput?.value.trim(),
+    sedeId: siteSelect?.value ? Number(siteSelect.value) : null,
+    criticidad: document.querySelector<HTMLSelectElement>('#device-criticality')?.value,
+  };
+
+  if (saveButton) {
+    saveButton.disabled = true;
+    saveButton.textContent = t(editing ? 'general.guardando' : 'general.registrando');
+  }
+
+  try {
+    const response = editing
+      ? await auditFetch(`/api/devices/${editing.id}`, jsonRequest('PUT', fields))
+      : await auditFetch('/api/devices', jsonRequest('POST', { ...fields, organizacionId: Number(organizationSelect?.value) }));
+
+    if (!response.ok) {
+      if (formError) {
+        formError.textContent = await readApiError(response);
+        formError.classList.remove('is-hidden');
+      }
+      return;
+    }
+
+    const saved = await response.json() as NetworkDevice;
+    dialog?.close();
+    showMessage(t(editing ? 'dispositivos.actualizado' : 'dispositivos.registrado', { identificador: saved.identificador }));
+    await loadDevices();
+    showDevice(saved);
+  } catch (error) {
+    if (formError) {
+      formError.textContent = error instanceof Error ? error.message : t('dispositivos.errorGuardar');
+      formError.classList.remove('is-hidden');
+    }
+  } finally {
+    if (saveButton) {
+      saveButton.disabled = false;
+      saveButton.textContent = t(state.editing ? 'general.guardarCambios' : 'dispositivos.registrarDispositivo');
+    }
+  }
+});
+
+// Baja lógica / reactivación
+document.querySelector('#toggle-device-status')?.addEventListener('click', async () => {
+  const device = state.current;
+  if (!device) return;
+  const deactivate = device.estado === 'ACTIVO';
+  const question = t(deactivate ? 'dispositivos.confirmarBaja' : 'dispositivos.confirmarReactivar',
+    { identificador: device.identificador });
+  if (!await confirmAction(t('general.confirmasOperacion'), question, t(deactivate ? 'dispositivos.darBaja' : 'dispositivos.reactivar'))) return;
+
+  const response = await auditFetch(`/api/devices/${device.id}/status`,
+    jsonRequest('PATCH', { estado: deactivate ? 'INACTIVO' : 'ACTIVO' }));
+  if (!response.ok) {
+    showMessage(await readApiError(response), 'error');
+    return;
+  }
+  const updated = await response.json() as NetworkDevice;
+  showMessage(t(deactivate ? 'dispositivos.dadoBaja' : 'dispositivos.reactivado', { identificador: updated.identificador }));
+  await loadDevices();
+  showDevice(updated);
+});
+
+// Tipos de dispositivo
+document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
+  button.addEventListener('click', () => button.closest('dialog')?.close());
+});
+
+document.querySelector('#open-type-dialog')?.addEventListener('click', () => {
+  document.querySelector<HTMLFormElement>('#type-form')?.reset();
+  document.querySelector('#type-form-error')?.classList.add('is-hidden');
+  typeDialog?.showModal();
+});
+
+document.querySelector<HTMLFormElement>('#type-form')?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const error = document.querySelector<HTMLElement>('#type-form-error');
+  error?.classList.add('is-hidden');
+  const read = (selector: string) => (document.querySelector<HTMLInputElement>(selector)?.value ?? '').trim();
+
+  const response = await auditFetch('/api/device-types', jsonRequest('POST', {
+    nombre: read('#type-name'),
+    fabricante: read('#type-vendor'),
+    familia: read('#type-family'),
+  }));
+  if (!response.ok) {
+    if (error) {
+      error.textContent = await readApiError(response);
+      error.classList.remove('is-hidden');
+    }
+    return;
+  }
+  const created = await response.json() as DeviceType;
+  typeDialog?.close();
+  await loadDeviceTypes();
+  fillTypeSelect(Number(typeSelect?.value) || undefined);
+  renderDevices();
+  showMessage(t('dispositivos.tipoRegistrado', { nombre: created.nombre, fabricante: created.fabricante }));
+});
+
+async function initializeDevices(): Promise<void> {
+  try {
+    await loadReferenceData();
+    await loadDevices();
+  } catch (error) {
+    if (body) body.replaceChildren();
+    showMessage(error instanceof Error ? error.message : t('dispositivos.errorCargar'), 'error');
+  }
+}
+
+initializeDevices();
diff --git a/frontend/web-app/src/scripts/history.ts b/frontend/web-app/src/scripts/history.ts
new file mode 100644
index 0000000..5d7d375
--- /dev/null
+++ b/frontend/web-app/src/scripts/history.ts
@@ -0,0 +1,285 @@
+// Historial de auditorías: evidencia de cada auditoría y comparación con la anterior.
+import { auditFetch } from '../lib/auth';
+import {
+  readApiError,
+  type AuditComparison,
+  type AuditDetail,
+  type AuditSummary,
+  type ConfigurationBaseline,
+  type DeviceConfiguration,
+  type NetworkDevice,
+  type RuleChangeCategory,
+} from '../lib/api';
+import { code, escapeHtml, findingStatusBadge, formatDate, localToIso, severityClass, severityCode } from '../lib/format';
+import { etiqueta, t } from '../lib/i18n';
+import { crearPaginador, totalDeRespuesta } from '../lib/paginador';
+import { show } from '../lib/ui';
+import { evidencia } from '../lib/evidencia';
+
+let audits: AuditSummary[] = [];
+let devices: NetworkDevice[] = [];
+let baselines: ConfigurationBaseline[] = [];
+let selectedId: number | null = null;
+// Evita que una respuesta lenta pise a una más nueva (filtros o selección cambiados rápido).
+let loadSeq = 0;
+
+const params = new URLSearchParams(window.location.search);
+const initialAudit = Number(params.get('auditoria')) || null;
+const initialDevice = Number(params.get('dispositivo')) || null;
+
+const form = document.querySelector<HTMLFormElement>('#history-filters');
+// El historial crece con cada auditoría: se pide al servidor de a una página.
+const paginador = crearPaginador(document.querySelector<HTMLElement>('#history-pager'), { alCambiar: () => void load() });
+let total = 0;
+const deviceById = (id: number) => devices.find((item) => item.id === id);
+const baselineById = (id: number) => baselines.find((item) => item.id === id);
+const automaticBadge = (audit: AuditSummary) => audit.origen === 'AUTOMATICA'
+  ? ` <span class="status-badge status-next" title="${t('historial.automaticaAyuda')}">${t('historial.automatica')}</span>`
+  : '';
+
+const showError = (message: string | null) => show('#history-error', message);
+
+const CATEGORIES: RuleChangeCategory[] = ['NUEVO_HALLAZGO', 'CORREGIDO', 'PERSISTENTE', 'SIN_CAMBIO', 'REGLA_NUEVA', 'REGLA_RETIRADA'];
+const categoryLabel = (category: RuleChangeCategory) => etiqueta('cambio', category);
+
+const buildQuery = () => {
+  const query = new URLSearchParams();
+  if (!form) return '';
+  const data = new FormData(form);
+  for (const name of ['dispositivoId', 'baselineId', 'severidad', 'resultado', 'ejecutadoPor']) {
+    const value = String(data.get(name) ?? '').trim();
+    if (value) query.set(name, value);
+  }
+  const desde = localToIso(String(data.get('desde') ?? ''));
+  const hasta = localToIso(String(data.get('hasta') ?? ''), true);
+  if (desde) query.set('desde', desde);
+  if (hasta) query.set('hasta', hasta);
+  if (desde && hasta && desde > hasta) throw new Error(t('bitacoras.rangoInvalido'));
+  const text = query.toString();
+  return text ? `?${text}` : '';
+};
+
+const render = () => {
+  const body = document.querySelector<HTMLTableSectionElement>('#history-body');
+  if (!body) return;
+  body.innerHTML = audits.map((audit) => {
+    const device = deviceById(audit.dispositivoId);
+    const baseline = baselineById(audit.baselineId);
+    return `
+      <tr class="finding-row ${audit.id === selectedId ? 'is-selected' : ''}" data-audit-id="${audit.id}" tabindex="0">
+        <td><code>${code('AUD', audit.id)}</code></td>
+        <td><span class="log-nowrap">${escapeHtml(formatDate(audit.fechaEjecucion))}</span></td>
+        <td><strong>${escapeHtml(device?.identificador ?? `#${audit.dispositivoId}`)}</strong><small>${escapeHtml(device?.nombre ?? '')}</small></td>
+        <td>${escapeHtml(baseline ? `${baseline.nombre} v${baseline.version}` : `#${audit.baselineId}`)}</td>
+        <td><code>${audit.reglasCumplidas}/${audit.totalReglas}</code></td>
+        <td><strong>${audit.totalHallazgos}</strong></td>
+        <td>${audit.severidadMaxima === 'NINGUNA'
+          ? `<span class="status-badge status-ready">${escapeHtml(severityCode('NINGUNA'))}</span>`
+          : `<span class="severity-badge ${severityClass(audit.severidadMaxima)}">${escapeHtml(severityCode(audit.severidadMaxima))}</span>`}</td>
+        <td><small>${escapeHtml(audit.ejecutadoPor)}</small>${automaticBadge(audit)}</td>
+      </tr>`;
+  }).join('');
+
+  const count = document.querySelector('#history-count');
+  if (count) count.textContent = String(total);
+  document.querySelector('#history-empty')?.classList.toggle('is-hidden', audits.length > 0);
+
+  body.querySelectorAll<HTMLElement>('[data-audit-id]').forEach((row) => {
+    const select = () => void selectAudit(Number(row.dataset.auditId));
+    row.addEventListener('click', select);
+    row.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        select();
+      }
+    });
+  });
+};
+
+const comparisonHtml = (comparison: AuditComparison) => {
+  if (!comparison.anterior) {
+    return `<p class="log-muted">${escapeHtml(t('historial.primeraAuditoria'))}</p>`;
+  }
+  const chips = CATEGORIES
+    .filter((category) => (comparison.resumen[category] ?? 0) > 0)
+    .map((category) => `<span class="compare-chip compare-${category.toLowerCase()}">${comparison.resumen[category]} ${escapeHtml(categoryLabel(category))}</span>`)
+    .join('');
+  const relevant = comparison.cambios.filter((change) => change.categoria !== 'SIN_CAMBIO');
+  const items = relevant.map((change) => `
+    <li class="compare-item compare-${change.categoria.toLowerCase()}">
+      <code>${escapeHtml(change.codigoRegla)}</code>
+      <span>${escapeHtml(change.nombreRegla)}</span>
+      <small>${escapeHtml(categoryLabel(change.categoria))}${change.severidad ? ` · ${escapeHtml(severityCode(change.severidad))}` : ''}</small>
+    </li>`).join('');
+  return `
+    <p class="log-muted">${escapeHtml(t(comparison.anterior.baselineId !== comparison.actual.baselineId ? 'historial.respectoDeOtraBaseline' : 'historial.respectoDe', {
+      auditoria: code('AUD', comparison.anterior.id), fecha: formatDate(comparison.anterior.fechaEjecucion) }))}</p>
+    <div class="compare-chips">${chips}</div>
+    ${items ? `<ul class="compare-list">${items}</ul>` : `<p class="log-muted">${escapeHtml(t('historial.mismoResultado'))}</p>`}`;
+};
+
+const selectAudit = async (id: number) => {
+  selectedId = id;
+  render();
+  const [detailResponse, comparisonResponse] = await Promise.all([
+    auditFetch(`/api/audits/${id}`),
+    auditFetch(`/api/audits/${id}/comparison`),
+  ]);
+  if (id !== selectedId) return; // el usuario ya eligió otra auditoría
+  if (!detailResponse.ok) return showError(await readApiError(detailResponse));
+  if (!comparisonResponse.ok) return showError(await readApiError(comparisonResponse));
+  const detail = await detailResponse.json() as AuditDetail;
+  const comparison = await comparisonResponse.json() as AuditComparison;
+  if (id !== selectedId) return;
+  const audit = detail.auditoria;
+  const device = deviceById(audit.dispositivoId);
+
+  const evaluations = detail.evaluaciones.map((evaluation) => `
+    <div class="evaluation-item ${evaluation.cumple ? 'is-pass' : 'is-fail'}">
+      <div>
+        <code>${escapeHtml(evaluation.codigoRegla)}</code>
+        <strong>${escapeHtml(evaluation.nombreRegla)}</strong>
+      </div>
+      <span class="status-badge ${evaluation.cumple ? 'status-ready' : 'status-strong'}">${t(evaluation.cumple ? 'auditorias.cumple' : 'auditorias.hallazgo')}</span>
+      <small>${escapeHtml(evaluation.patron)} — ${escapeHtml(evidencia(evaluation.evidencia))}</small>
+    </div>`).join('');
+
+  const findings = detail.hallazgos.map((finding) => `
+    <li class="compare-item">
+      <code>${code('FND', finding.id)}</code>
+      <span>${escapeHtml(finding.codigoRegla)}</span>
+      ${findingStatusBadge(finding.estado)}
+    </li>`).join('');
+
+  const incomplete = !detail.configuracion || !detail.baseline;
+  const content = document.querySelector<HTMLElement>('#history-inspector-content');
+  if (!content) return;
+  document.querySelector('#history-inspector-empty')?.classList.add('is-hidden');
+  content.innerHTML = `
+    <div class="inspector-identity">
+      <span class="inspector-code">${code('AUD', audit.id)} · ${escapeHtml(formatDate(audit.fechaEjecucion))}</span>
+      <h3>${escapeHtml(device?.identificador ?? t('auditorias.dispositivoNumero', { id: audit.dispositivoId }))}</h3>
+      <span class="status-badge ${audit.resultado === 'CUMPLE' ? 'status-ready' : 'status-strong'}">${escapeHtml(etiqueta('resultado', audit.resultado))}</span>
+    </div>
+    ${incomplete ? `<div class="alert alert-error">${escapeHtml(t('historial.incompleta'))}</div>` : ''}
+    <dl class="technical-definition-list">
+      <div><dt>${t('general.baseline')}</dt><dd>${detail.baseline ? `${escapeHtml(detail.baseline.nombre)} v${detail.baseline.version}` : `#${audit.baselineId}`}</dd></div>
+      <div><dt>${t('auditorias.configuracion')}</dt><dd>${detail.configuracion
+        ? `${code('CFG', detail.configuracion.id)} · v${detail.configuracion.version} · ${escapeHtml(detail.configuracion.nombreFuente)}`
+        : code('CFG', audit.configuracionId)}</dd></div>
+      <div><dt>${t('historial.importada')}</dt><dd>${detail.configuracion
+        ? `${escapeHtml(formatDate(detail.configuracion.fechaImportacion))} · ${escapeHtml(detail.configuracion.usuarioResponsable)}`
+        : '—'}</dd></div>
+      <div><dt>${t('auditorias.reglasCumplidas')}</dt><dd>${audit.reglasCumplidas}/${audit.totalReglas}</dd></div>
+      <div><dt>${t('auditorias.ejecuto')}</dt><dd>${escapeHtml(audit.ejecutadoPor)} ${automaticBadge(audit)}</dd></div>
+    </dl>
+
+    <div class="baseline-versions">
+      <span>${t('historial.evolucion')}</span>
+      ${comparisonHtml(comparison)}
+    </div>
+
+    <div class="evaluation-list">
+      <span class="eyebrow">${t('historial.reglasAplicadas')}</span>
+      ${evaluations}
+    </div>
+
+    ${findings ? `
+    <div class="baseline-versions">
+      <span>${t('historial.hallazgosGenerados')}</span>
+      <ul class="compare-list">${findings}</ul>
+      <a class="button button-ghost button-small button-full" href="/results?auditoria=${audit.id}">${t('historial.verHallazgos')}</a>
+    </div>` : ''}
+
+    ${detail.configuracion ? `
+    <button id="show-config" class="button button-ghost button-small button-full" type="button">Ver configuración evaluada</button>
+    <div id="config-block" class="config-preview is-hidden">
+      <span>configuración normalizada (${code('CFG', detail.configuracion.id)})</span>
+      <pre id="config-content">cargando...</pre>
+    </div>` : ''}
+    <button id="filter-device" class="button button-ghost button-small button-full" type="button">${t('historial.soloDispositivo')}</button>
+    <a class="button button-ghost button-small button-full" href="/reports?auditoria=${audit.id}">Generar reporte de esta auditoría →</a>
+  `;
+  content.classList.remove('is-hidden');
+
+  document.querySelector('#show-config')?.addEventListener('click', async () => {
+    const block = document.querySelector('#config-block');
+    const pre = document.querySelector('#config-content');
+    block?.classList.toggle('is-hidden');
+    if (!detail.configuracion || !pre || pre.textContent !== 'cargando...') return;
+    const response = await auditFetch(`/api/configurations/${detail.configuracion.id}`);
+    pre.textContent = response.ok
+      ? (await response.json() as DeviceConfiguration).contenidoNormalizado
+      : await readApiError(response);
+  });
+  document.querySelector('#filter-device')?.addEventListener('click', () => {
+    const select = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
+    if (select) select.value = String(audit.dispositivoId);
+    paginador.reiniciar();
+    void load();
+  });
+};
+
+const load = async () => {
+  showError(null);
+  let query: string;
+  try {
+    query = buildQuery();
+  } catch (error) {
+    showError(error instanceof Error ? error.message : t('bitacoras.filtrosInvalidos'));
+    return;
+  }
+  const pagina = `pagina=${paginador.pagina}&porPagina=${paginador.porPagina}`;
+  const seq = ++loadSeq;
+  const response = await auditFetch(`/api/audits/history${query ? `${query}&` : '?'}${pagina}`);
+  if (seq !== loadSeq) return;
+  if (!response.ok) {
+    showError(await readApiError(response));
+    return;
+  }
+  const data = await response.json() as AuditSummary[];
+  if (seq !== loadSeq) return;
+  total = totalDeRespuesta(response, data.length);
+  const paginaPedida = paginador.pagina;
+  paginador.actualizar(total);
+  // La página pedida quedó después del final (por ejemplo, cambió el total): se pide la última.
+  if (data.length === 0 && total > 0 && paginador.pagina !== paginaPedida) return load();
+  audits = data;
+  render();
+};
+
+const loadReferences = async () => {
+  const [deviceResponse, baselineResponse] = await Promise.all([
+    auditFetch('/api/devices'),
+    auditFetch('/api/baselines'),
+  ]);
+  for (const response of [deviceResponse, baselineResponse]) {
+    if (!response.ok) throw new Error(await readApiError(response));
+  }
+  devices = await deviceResponse.json() as NetworkDevice[];
+  baselines = await baselineResponse.json() as ConfigurationBaseline[];
+  const deviceSelect = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
+  devices.forEach((device) => deviceSelect?.add(new Option(`${device.identificador} · ${device.nombre}`, String(device.id))));
+  const baselineSelect = form?.querySelector<HTMLSelectElement>('[name=baselineId]');
+  baselines.forEach((baseline) => baselineSelect?.add(new Option(`${baseline.nombre} v${baseline.version}`, String(baseline.id))));
+  if (initialDevice && deviceSelect) deviceSelect.value = String(initialDevice);
+};
+
+form?.addEventListener('submit', (event) => {
+  event.preventDefault();
+  paginador.reiniciar();
+  void load();
+});
+document.querySelector('#history-clear')?.addEventListener('click', () => {
+  form?.reset();
+  paginador.reiniciar();
+  window.history.replaceState(null, '', window.location.pathname);
+  void load();
+});
+
+loadReferences()
+  .then(load)
+  .then(() => {
+    if (initialAudit) void selectAudit(initialAudit);
+  })
+  .catch((error) => showError(error instanceof Error ? error.message : t('historial.errorCargar')));
diff --git a/frontend/web-app/src/scripts/login.ts b/frontend/web-app/src/scripts/login.ts
new file mode 100644
index 0000000..cda6a6f
--- /dev/null
+++ b/frontend/web-app/src/scripts/login.ts
@@ -0,0 +1,51 @@
+// Inicio de sesión.
+import { getToken, isSessionExpired, login } from '../lib/auth';
+import { t } from '../lib/i18n';
+import { animarLogo } from '../lib/logo-animado';
+
+animarLogo(document.querySelector<HTMLElement>('#hero-mark'));
+
+if (getToken() && !isSessionExpired()) {
+  window.location.replace('/dashboard');
+}
+
+const form = document.querySelector<HTMLFormElement>('#login-form');
+const errorBox = document.querySelector<HTMLDivElement>('#login-error');
+const button = document.querySelector<HTMLButtonElement>('#login-button');
+
+const reason = new URLSearchParams(window.location.search).get('reason');
+if (reason === 'expired' && errorBox) {
+  errorBox.textContent = t('login.sesionTerminada');
+  errorBox.classList.remove('is-hidden');
+  window.history.replaceState({}, '', '/login');
+}
+
+form?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  errorBox?.classList.add('is-hidden');
+
+  const identity = document.querySelector<HTMLInputElement>('#identity')?.value.trim();
+  const password = document.querySelector<HTMLInputElement>('#password')?.value;
+
+  if (!identity || !password) return;
+
+  if (button) {
+    button.disabled = true;
+    button.textContent = t('login.validando');
+  }
+
+  try {
+    await login(identity, password);
+    window.location.assign('/dashboard');
+  } catch (error) {
+    if (errorBox) {
+      errorBox.textContent = error instanceof Error ? error.message : t('login.error');
+      errorBox.classList.remove('is-hidden');
+    }
+  } finally {
+    if (button) {
+      button.disabled = false;
+      button.textContent = t('login.ingresar');
+    }
+  }
+});
