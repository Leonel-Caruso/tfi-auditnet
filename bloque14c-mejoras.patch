index 0000000..cda973a
--- /dev/null
+++ b/frontend/web-app/src/lib/tema.ts
@@ -0,0 +1,42 @@
+// Tema claro u oscuro. Se recuerda en este navegador; sin elección se sigue el del sistema.
+// public/inicio.js lo aplica antes de mostrar la página con la misma regla.
+export type Tema = 'claro' | 'oscuro' | 'sistema';
+
+const CLAVE = 'auditnet.tema';
+
+export function temaElegido(): Tema {
+  try {
+    const guardado = localStorage.getItem(CLAVE);
+    if (guardado === 'claro' || guardado === 'oscuro') return guardado;
+  } catch {
+    // Sin acceso al almacenamiento del navegador se sigue el sistema.
+  }
+  return 'sistema';
+}
+
+export function elegirTema(tema: Tema): void {
+  try {
+    if (tema === 'sistema') localStorage.removeItem(CLAVE);
+    else localStorage.setItem(CLAVE, tema);
+  } catch {
+    // Se aplica igual en esta página aunque no se pueda recordar.
+  }
+  const oscuro = tema === 'oscuro' || (tema === 'sistema' && matchMedia('(prefers-color-scheme: dark)').matches);
+  document.documentElement.dataset.tema = oscuro ? 'oscuro' : 'claro';
+  marcar();
+}
+
+function marcar(): void {
+  const actual = temaElegido();
+  document.querySelectorAll<HTMLButtonElement>('[data-opcion-tema]').forEach((boton) => {
+    boton.setAttribute('aria-pressed', String(boton.dataset.opcionTema === actual));
+  });
+}
+
+/** Conecta los botones Claro / Oscuro / Sistema que haya en la página. */
+export function conectarSelectorTema(): void {
+  document.querySelectorAll<HTMLButtonElement>('[data-opcion-tema]').forEach((boton) => {
+    boton.addEventListener('click', () => elegirTema(boton.dataset.opcionTema as Tema));
+  });
+  marcar();
+}
