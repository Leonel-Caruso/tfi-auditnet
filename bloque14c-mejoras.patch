+// Mi plan: plan contratado, uso y solicitudes de cambio.
+import { authFetch, getStoredUser, hasRole } from '../lib/auth';
+import { jsonRequest, readApiError, type OrganizationPlan, type Plan, type PlanRequest } from '../lib/api';
+import { escapeHtml } from '../lib/format';
+import { t } from '../lib/i18n';
+import {
+  formatDay, formatPrice, isCustomPlan, isTrialPlan, limitsText, planCard, requestDetail, requestStatusBadge,
+  usageRow, validityText,
+} from '../lib/plans';
+import { show } from '../lib/ui';
+
+// El administrador del sistema gestiona los planes de todas las organizaciones desde otra pantalla.
+if (hasRole('ADMINISTRADOR_SISTEMA')) window.location.replace('/plans');
+
+const organizationId = getStoredUser()?.organizationId;
+const canRequest = hasRole('ADMINISTRADOR_ORGANIZACION');
+const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector);
+const requestDialog = $<HTMLDialogElement>('#request-dialog');
+
+let catalog: Plan[] = [];
+let current: OrganizationPlan | null = null;
+
+const planName = (code: string) => catalog.find((plan) => plan.codigo === code)?.nombre ?? code;
+
+/** Planes que se pueden pedir: no los de prueba ni el actual (salvo uno a medida, para renegociar límites). */
+const requestable = () => catalog.filter((plan) => !isTrialPlan(plan)
+  && (plan.codigo !== current?.plan.codigo || isCustomPlan(plan)));
+
+const renderCurrent = () => {
+  if (!current) return;
+  $('#plan-name')!.textContent = current.plan.nombre;
+  $('#plan-price')!.textContent = formatPrice(current.plan);
+  $('#plan-current')!.innerHTML = `
+    <p class="plan-validity ${current.vencido ? 'is-expired' : ''}">${escapeHtml(validityText(current))}</p>
+    ${usageRow(t('planes.dispositivosActivos'), current.dispositivosActivos, current.maxDispositivos)}
+    ${usageRow(t('planes.usuariosActivos'), current.usuariosActivos, current.maxUsuarios)}
+    <p class="log-muted">${escapeHtml(t('plan.desdeEl', { fecha: formatDay(current.desde) }))}
+      ${current.plan.condiciones ? escapeHtml(current.plan.condiciones) : ''}</p>`;
+
+  const expiry = $('#plan-expiry');
+  if (expiry) {
+    const soon = current.vence && !current.vencido && (current.diasRestantes ?? 0) <= 15;
+    expiry.className = `alert ${current.vencido ? 'alert-error' : 'alert-warning'}`;
+    expiry.textContent = current.vencido
+      ? t('plan.pruebaVencida')
+      : t('plan.pruebaPorVencer', { dias: current.diasRestantes ?? 0 });
+    expiry.classList.toggle('is-hidden', !current.vencido && !soon);
+  }
+
+  const pending = current.solicitudPendiente;
+  $('#plan-pending')!.innerHTML = pending
+    ? `<ul class="request-list"><li>
+        <div><strong>${escapeHtml(planName(pending.planActual))} → ${escapeHtml(planName(pending.planSolicitado))}</strong>${requestStatusBadge(pending.estado)}</div>
+        <small>${escapeHtml(requestDetail(pending))}</small>
+        ${pending.comentario ? `<p>${escapeHtml(pending.comentario)}</p>` : ''}
+        ${canRequest ? `<div><button class="button button-ghost button-small" type="button" data-cancel="${pending.id}">${escapeHtml(t('plan.cancelarSolicitud'))}</button></div>` : ''}
+      </li></ul>`
+    : `<p class="log-muted">${escapeHtml(t('plan.sinPendientes'))}${canRequest ? ` ${escapeHtml(t('plan.pediOtroPlan'))}` : ''}</p>`;
+  const open = $<HTMLButtonElement>('#request-open');
+  if (open) open.disabled = Boolean(pending) || requestable().length === 0;
+};
+
+const renderCatalog = () => {
+  $('#plan-catalog')!.innerHTML = catalog.map((plan) => planCard(plan, plan.codigo === current?.plan.codigo)).join('');
+};
+
+const renderHistory = (requests: PlanRequest[]) => {
+  const done = requests.filter((request) => request.estado !== 'PENDIENTE');
+  $('#plan-history')!.innerHTML = done.map((request) => `
+    <li>
+      <div><strong>${escapeHtml(planName(request.planActual))} → ${escapeHtml(planName(request.planSolicitado))}</strong>${requestStatusBadge(request.estado)}</div>
+      <small>${escapeHtml(requestDetail(request))}</small>
+      ${request.respuesta ? `<p>${escapeHtml(request.respuesta)}</p>` : ''}
+    </li>`).join('');
+  $('#plan-history-empty')?.classList.toggle('is-hidden', done.length > 0);
+};
+
+const load = async () => {
+  if (!organizationId) return show('#plan-error', t('tablero.sinOrganizacion'));
+  const [catalogResponse, planResponse] = await Promise.all([
+    authFetch('/api/plans'),
+    authFetch(`/api/client-organizations/${organizationId}/plan`),
+  ]);
+  if (!planResponse.ok) return show('#plan-error', await readApiError(planResponse));
+  if (catalogResponse.ok) catalog = await catalogResponse.json() as Plan[];
+  current = await planResponse.json() as OrganizationPlan;
+  renderCurrent();
+  renderCatalog();
+  const historyResponse = await authFetch(`/api/client-organizations/${organizationId}/plan-requests`);
+  renderHistory(historyResponse.ok ? await historyResponse.json() as PlanRequest[] : []);
+};
+
+const syncConditions = () => {
+  const plan = catalog.find((item) => item.codigo === $<HTMLSelectElement>('#request-plan')?.value);
+  $('#request-conditions')!.textContent = plan
+    ? `${formatPrice(plan)} · ${limitsText(plan)}. ${plan.condiciones ?? ''}`
+    : '';
+};
+
+$('#request-open')?.addEventListener('click', () => {
+  $<HTMLFormElement>('#request-form')?.reset();
+  show('#request-form-error', null);
+  const select = $<HTMLSelectElement>('#request-plan');
+  select?.replaceChildren(...requestable().map((plan) => new Option(plan.nombre, plan.codigo)));
+  syncConditions();
+  requestDialog?.showModal();
+});
+$('#request-plan')?.addEventListener('change', syncConditions);
+
+$<HTMLFormElement>('#request-form')?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  show('#request-form-error', null);
+  const payload = {
+    plan: $<HTMLSelectElement>('#request-plan')?.value ?? '',
+    modalidad: document.querySelector<HTMLInputElement>('input[name=modalidad]:checked')?.value ?? 'MENSUAL',
+    comentario: ($<HTMLTextAreaElement>('#request-comment')?.value ?? '').trim(),
+  };
+  const response = await authFetch(`/api/client-organizations/${organizationId}/plan-requests`, jsonRequest('POST', payload));
+  if (!response.ok) return show('#request-form-error', await readApiError(response));
+  requestDialog?.close();
+  show('#plan-message', t('plan.solicitudEnviada'));
+  await load();
+});
+
+$('#plan-pending')?.addEventListener('click', async (event) => {
+  const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-cancel]');
+  if (!button) return;
+  const response = await authFetch(`/api/client-organizations/${organizationId}/plan-requests/${button.dataset.cancel}/cancel`,
+    { method: 'POST' });
+  if (!response.ok) return show('#plan-error', await readApiError(response));
+  show('#plan-message', t('plan.solicitudCancelada'));
+  await load();
+});
+
+document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
+  button.addEventListener('click', () => button.closest('dialog')?.close());
+});
+
+load().catch((error) => show('#plan-error', error instanceof Error ? error.message : t('plan.errorCargar')));
diff --git a/frontend/web-app/src/scripts/plans.ts b/frontend/web-app/src/scripts/plans.ts
new file mode 100644
index 0000000..2c6c6c2
--- /dev/null
+++ b/frontend/web-app/src/scripts/plans.ts
@@ -0,0 +1,138 @@
+// Planes y solicitudes: resolución de pedidos y precios del catálogo.
+import { authFetch } from '../lib/auth';
+import { jsonRequest, readApiError, type Plan, type PlanRequest } from '../lib/api';
+import { escapeHtml } from '../lib/format';
+import { t } from '../lib/i18n';
+import { isCustomPlan, planCard, requestDetail, requestStatusBadge } from '../lib/plans';
+import { notify, show } from '../lib/ui';
+
+const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector);
+const resolveDialog = $<HTMLDialogElement>('#resolve-dialog');
+const priceDialog = $<HTMLDialogElement>('#price-dialog');
+
+let catalog: Plan[] = [];
+let requests: PlanRequest[] = [];
+let resolving: { request: PlanRequest; approve: boolean } | null = null;
+let editingPlan: Plan | null = null;
+
+const planName = (code: string) => catalog.find((plan) => plan.codigo === code)?.nombre ?? code;
+
+const requestItem = (request: PlanRequest, actions: boolean) => `
+  <li data-request-id="${request.id}">
+    <div>
+      <strong>${escapeHtml(request.organizacion ?? t('tablero.organizacionNumero', { id: request.organizationId }))}: ${escapeHtml(planName(request.planActual))} → ${escapeHtml(planName(request.planSolicitado))}</strong>
+      ${requestStatusBadge(request.estado)}
+    </div>
+    <small>${escapeHtml(requestDetail(request))}</small>
+    ${request.comentario ? `<p>${escapeHtml(t('planes.comentarioCliente', { texto: request.comentario }))}</p>` : ''}
+    ${request.respuesta ? `<p>${escapeHtml(t('planes.respuesta', { texto: request.respuesta }))}</p>` : ''}
+    ${actions ? `<div class="inline-actions">
+      <button class="button button-primary button-small" type="button" data-action="approve">${t('planes.aprobar')}</button>
+      <button class="button button-ghost button-small" type="button" data-action="reject">${t('planes.rechazar')}</button>
+    </div>` : ''}
+  </li>`;
+
+const renderRequests = () => {
+  const pending = requests.filter((request) => request.estado === 'PENDIENTE');
+  const resolved = requests.filter((request) => request.estado !== 'PENDIENTE').reverse();
+  $('#pending-list')!.innerHTML = pending.map((request) => requestItem(request, true)).join('');
+  $('#pending-count')!.textContent = String(pending.length);
+  $('#pending-empty')?.classList.toggle('is-hidden', pending.length > 0);
+  $('#history-list')!.innerHTML = resolved.map((request) => requestItem(request, false)).join('');
+  $('#history-empty')?.classList.toggle('is-hidden', resolved.length > 0);
+};
+
+const renderCatalog = () => {
+  $('#catalog')!.innerHTML = catalog.map((plan) => planCard(plan, false,
+    `<button class="button button-ghost button-small" type="button" data-plan="${escapeHtml(plan.codigo)}">${t('planes.editarPrecio')}</button>`)).join('');
+};
+
+const load = async () => {
+  const [catalogResponse, requestResponse] = await Promise.all([
+    authFetch('/api/plans'),
+    authFetch('/api/admin/plan-requests'),
+  ]);
+  if (!catalogResponse.ok) return show('#plans-error', await readApiError(catalogResponse));
+  if (!requestResponse.ok) return show('#plans-error', await readApiError(requestResponse));
+  catalog = await catalogResponse.json() as Plan[];
+  requests = await requestResponse.json() as PlanRequest[];
+  renderCatalog();
+  renderRequests();
+};
+
+// Aprobar o rechazar
+$('#pending-list')?.addEventListener('click', (event) => {
+  const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
+  const id = Number(button?.closest<HTMLElement>('[data-request-id]')?.dataset.requestId);
+  const request = requests.find((item) => item.id === id);
+  if (!button || !request) return;
+  const approve = button.dataset.action === 'approve';
+  const target = catalog.find((plan) => plan.codigo === request.planSolicitado);
+  const custom = approve && target !== undefined && isCustomPlan(target);
+  resolving = { request, approve };
+  $<HTMLFormElement>('#resolve-form')?.reset();
+  show('#resolve-form-error', null);
+  $('#resolve-eyebrow')!.textContent = t(approve ? 'planes.aprobarSolicitud' : 'planes.rechazarSolicitud');
+  $('#resolve-title')!.textContent = `${request.organizacion ?? ''}: ${planName(request.planSolicitado)}`;
+  $('#resolve-help')!.textContent = t(approve ? 'planes.aprobarAyuda' : 'planes.rechazarAyuda');
+  $('#resolve-answer-label')!.textContent = t(approve ? 'planes.respuestaCliente' : 'planes.motivoRechazo');
+  $('#resolve-submit')!.textContent = t(approve ? 'planes.aprobar' : 'planes.rechazar');
+  document.querySelectorAll<HTMLElement>('[data-custom-limit]').forEach((node) => node.classList.toggle('is-hidden', !custom));
+  resolveDialog?.showModal();
+});
+
+$<HTMLFormElement>('#resolve-form')?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!resolving) return;
+  show('#resolve-form-error', null);
+  const { request, approve } = resolving;
+  const number = (selector: string) => {
+    const input = $<HTMLInputElement>(selector);
+    return input && !input.closest('.is-hidden') && input.value !== '' ? Number(input.value) : null;
+  };
+  const payload = {
+    respuesta: ($<HTMLTextAreaElement>('#resolve-answer')?.value ?? '').trim(),
+    limiteDispositivos: number('#resolve-devices'),
+    limiteUsuarios: number('#resolve-users'),
+  };
+  const response = await authFetch(`/api/admin/plan-requests/${request.id}/${approve ? 'approve' : 'reject'}`,
+    jsonRequest('POST', payload));
+  if (!response.ok) return show('#resolve-form-error', await readApiError(response));
+  resolveDialog?.close();
+  notify('#plans-message', approve
+    ? t('organizaciones.planAplicado', { organizacion: request.organizacion ?? t('planes.laOrganizacion'), plan: planName(request.planSolicitado) })
+    : t('planes.solicitudRechazada'));
+  await load();
+});
+
+// Precio y condiciones del catálogo
+$('#catalog')?.addEventListener('click', (event) => {
+  const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-plan]');
+  editingPlan = catalog.find((plan) => plan.codigo === button?.dataset.plan) ?? null;
+  if (!editingPlan) return;
+  show('#price-form-error', null);
+  $('#price-title')!.textContent = t('planes.planNombre', { plan: editingPlan.nombre });
+  $<HTMLInputElement>('#price-value')!.value = editingPlan.precioMensualUsd === null ? '' : String(editingPlan.precioMensualUsd);
+  $<HTMLTextAreaElement>('#price-conditions')!.value = editingPlan.condiciones ?? '';
+  priceDialog?.showModal();
+});
+
+$<HTMLFormElement>('#price-form')?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!editingPlan) return;
+  const price = $<HTMLInputElement>('#price-value')?.value ?? '';
+  const response = await authFetch(`/api/plans/${editingPlan.codigo}`, jsonRequest('PUT', {
+    precioMensualUsd: price === '' ? null : Number(price),
+    condiciones: ($<HTMLTextAreaElement>('#price-conditions')?.value ?? '').trim(),
+  }));
+  if (!response.ok) return show('#price-form-error', await readApiError(response));
+  priceDialog?.close();
+  notify('#plans-message', t('planes.planActualizado', { plan: editingPlan.nombre }));
+  await load();
+});
+
+document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
+  button.addEventListener('click', () => button.closest('dialog')?.close());
+});
+
+load().catch((error) => show('#plans-error', error instanceof Error ? error.message : t('planes.errorCargar')));
diff --git a/frontend/web-app/src/scripts/recover.ts b/frontend/web-app/src/scripts/recover.ts
new file mode 100644
index 0000000..68cdc9d
--- /dev/null
+++ b/frontend/web-app/src/scripts/recover.ts
@@ -0,0 +1,40 @@
+// Recuperación de contraseña: pedido del enlace por correo.
+import { MANAGEMENT_API_URL, readApiError } from '../lib/api';
+import { idiomaActual, t } from '../lib/i18n';
+
+const form = document.querySelector<HTMLFormElement>('#recover-form');
+const errorBox = document.querySelector<HTMLElement>('#recover-error');
+const done = document.querySelector<HTMLElement>('#recover-done');
+const submit = document.querySelector<HTMLButtonElement>('#recover-submit');
+
+const fail = (message: string) => {
+  if (!errorBox) return;
+  errorBox.textContent = message;
+  errorBox.classList.remove('is-hidden');
+};
+
+form?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  errorBox?.classList.add('is-hidden');
+  const identidad = document.querySelector<HTMLInputElement>('#recover-identity')?.value.trim();
+  if (!identidad) return fail(t('recuperar.falta'));
+  if (submit) submit.disabled = true;
+  try {
+    const response = await fetch(`${MANAGEMENT_API_URL}/api/auth/password-recovery`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'Accept-Language': idiomaActual() },
+      body: JSON.stringify({ identidad }),
+    });
+    if (!response.ok) throw new Error(await readApiError(response));
+    // La respuesta es la misma exista o no la cuenta: el texto sale del diccionario.
+    if (done) {
+      done.textContent = t('recuperar.enviado');
+      done.classList.remove('is-hidden');
+    }
+    if (submit) submit.textContent = t('recuperar.reenviar');
+  } catch (error) {
+    fail(error instanceof Error ? error.message : t('recuperar.error'));
+  } finally {
+    if (submit) submit.disabled = false;
+  }
+});
diff --git a/frontend/web-app/src/scripts/reports.ts b/frontend/web-app/src/scripts/reports.ts
new file mode 100644
index 0000000..96bba8a
--- /dev/null
+++ b/frontend/web-app/src/scripts/reports.ts
@@ -0,0 +1,245 @@
+// Reportes: generación, documento (PDF) y descarga en CSV.
+import { auditFetch, authFetch, getStoredUser, hasRole } from '../lib/auth';
+import {
+  jsonRequest,
+  readApiError,
+  type AuditReport,
+  type NetworkDevice,
+  type Organization,
+  type ReportSummary,
+  type Site,
+} from '../lib/api';
+import { code, escapeHtml, formatDate } from '../lib/format';
+import { t } from '../lib/i18n';
+import { printPageStyle, reportDocumentHtml } from '../lib/report-document';
+import { loadVisibleSites } from '../lib/sites';
+import { scrollToView, show } from '../lib/ui';
+
+const isAdmin = hasRole('ADMINISTRADOR_SISTEMA');
+// Generan el administrador, el analista de redes y el auditor técnico; el resto consulta.
+const canGenerate = isAdmin || hasRole('ANALISTA_RED') || hasRole('AUDITOR_TECNICO');
+const params = new URLSearchParams(window.location.search);
+
+let reports: ReportSummary[] = [];
+let devices: NetworkDevice[] = [];
+let sites: Site[] = [];
+let organizations: Organization[] = [];
+let selectedId: number | null = null;
+
+const form = document.querySelector<HTMLFormElement>('#report-form');
+const view = document.querySelector<HTMLElement>('#report-view');
+
+const showError = (message: string | null) => show('#report-error', message);
+const showSuccess = (message: string) => {
+  show('#report-success', message);
+  window.setTimeout(() => show('#report-success', null), 5000);
+};
+
+const isoDate = (date: Date) => {
+  const pad = (value: number) => String(value).padStart(2, '0');
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
+};
+/** Fecha del input (día local) → ISO-8601: inicio del día para "desde" y fin del día para "hasta". */
+const dayToIso = (value: string, endOfDay: boolean) => {
+  if (!value) return null;
+  const [year, month, day] = value.split('-').map(Number);
+  const date = endOfDay ? new Date(year, month - 1, day, 23, 59, 59, 999) : new Date(year, month - 1, day, 0, 0, 0, 0);
+  return date.toISOString();
+};
+const orgName = (id: number | null) => id == null
+  ? t('tablero.todasOrganizaciones')
+  : organizations.find((organization) => organization.id === id)?.razonSocial ?? t('tablero.organizacionNumero', { id });
+const siteName = (id: number | null) => id == null
+  ? t('tablero.sinSede')
+  : sites.find((site) => site.id === id)?.nombre ?? t('tablero.sedeNumero', { id });
+
+const renderList = () => {
+  const body = document.querySelector<HTMLTableSectionElement>('#report-list');
+  if (!body) return;
+  body.innerHTML = reports.map((report) => `
+    <tr class="finding-row ${report.id === selectedId ? 'is-selected' : ''}" data-report-id="${report.id}" tabindex="0">
+      <td><code class="log-nowrap">${code('REP', report.id)}</code></td>
+      <td><strong>${escapeHtml(report.titulo)}</strong>${isAdmin ? `<small>${escapeHtml(orgName(report.organizacionId))}</small>` : ''}</td>
+      <td>${report.totalAuditorias}</td>
+      <td>${report.totalHallazgos}</td>
+      <td><span class="log-nowrap">${escapeHtml(formatDate(report.fechaGeneracion))}</span><small>${escapeHtml(report.generadoPor)}</small></td>
+    </tr>`).join('');
+  const count = document.querySelector('#report-count');
+  if (count) count.textContent = String(reports.length);
+  document.querySelector('#report-empty')?.classList.toggle('is-hidden', reports.length > 0);
+  body.querySelectorAll<HTMLElement>('[data-report-id]').forEach((row) => {
+    const open = () => void openReport(Number(row.dataset.reportId));
+    row.addEventListener('click', open);
+    row.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        open();
+      }
+    });
+  });
+};
+
+const reportContext = {
+  orgName,
+  siteName,
+  deviceName: (id: number) => devices.find((device) => device.id === id)?.identificador ?? `#${id}`,
+};
+
+const renderReport = (report: AuditReport) => {
+  if (!view) return;
+  const rep = code('REP', report.id);
+  view.innerHTML = `
+    <div class="report-toolbar report-no-print">
+      <div>
+        <span class="eyebrow">${t('reportes.vistaDocumento')}</span>
+        <strong>${rep}</strong>
+      </div>
+      <div class="report-actions">
+        <button id="report-print" type="button" class="button button-primary button-small">${t('reportes.descargarPdf')}</button>
+        <button id="report-csv" type="button" class="button button-ghost button-small">${t('reportes.descargarCsv')}</button>
+      </div>
+    </div>
+    ${reportDocumentHtml(report, reportContext)}`;
+  view.classList.remove('is-hidden');
+
+  // Pie de página del PDF con el número de reporte (se reemplaza al abrir otro reporte).
+  let printStyle = document.querySelector<HTMLStyleElement>('#report-print-style');
+  if (!printStyle) {
+    printStyle = document.createElement('style');
+    printStyle.id = 'report-print-style';
+    document.head.append(printStyle);
+  }
+  printStyle.textContent = printPageStyle(report);
+
+  document.querySelector('#report-print')?.addEventListener('click', () => {
+    // El título de la página es el nombre sugerido del PDF al guardarlo.
+    const previous = document.title;
+    document.title = `AuditNet ${rep} - ${report.fechaGeneracion.slice(0, 10)}`;
+    window.addEventListener('afterprint', () => { document.title = previous; }, { once: true });
+    window.print();
+  });
+  document.querySelector('#report-csv')?.addEventListener('click', () => void downloadCsv(report.id));
+};
+
+const downloadCsv = async (id: number) => {
+  showError(null);
+  const response = await auditFetch(`/api/reports/${id}/download`);
+  if (!response.ok) return showError(await readApiError(response));
+  const url = URL.createObjectURL(await response.blob());
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `${t('reportes.archivoCsv')}-${code('REP', id)}.csv`;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+};
+
+const openReport = async (id: number) => {
+  selectedId = id;
+  renderList();
+  const response = await auditFetch(`/api/reports/${id}`);
+  if (id !== selectedId) return;
+  if (!response.ok) return showError(await readApiError(response));
+  const report = await response.json() as AuditReport;
+  if (id !== selectedId) return;
+  renderReport(report);
+  scrollToView(view);
+};
+
+const loadReports = async () => {
+  const response = await auditFetch('/api/reports');
+  if (!response.ok) throw new Error(await readApiError(response));
+  reports = await response.json() as ReportSummary[];
+  renderList();
+};
+
+const loadReferences = async () => {
+  const [deviceResponse, visibleSites] = await Promise.all([auditFetch('/api/devices'), loadVisibleSites()]);
+  if (deviceResponse.ok) devices = await deviceResponse.json() as NetworkDevice[];
+  sites = visibleSites;
+  const deviceSelect = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
+  devices.forEach((device) => deviceSelect?.add(new Option(`${device.identificador} · ${device.nombre}`, String(device.id))));
+  if (!isAdmin) {
+    const own = getStoredUser()?.organizationId;
+    const response = own ? await authFetch(`/api/client-organizations/${own}`) : null;
+    if (response?.ok) organizations = [await response.json() as Organization];
+  } else {
+    const response = await authFetch('/api/client-organizations');
+    if (response.ok) organizations = await response.json() as Organization[];
+    const orgSelect = form?.querySelector<HTMLSelectElement>('[name=organizacionId]');
+    organizations.forEach((organization) => orgSelect?.add(new Option(organization.razonSocial, String(organization.id))));
+    document.querySelector('#report-org-filter')?.removeAttribute('hidden');
+  }
+};
+
+const setupForm = () => {
+  if (!form) return;
+  const today = new Date();
+  const monthAgo = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 30);
+  form.querySelector<HTMLInputElement>('[name=desde]')!.value = isoDate(monthAgo);
+  form.querySelector<HTMLInputElement>('[name=hasta]')!.value = isoDate(today);
+  const presetAudit = params.get('auditoria');
+  if (presetAudit) form.querySelector<HTMLInputElement>('[name=auditorias]')!.value = presetAudit;
+  if (!canGenerate) {
+    document.querySelector('#report-readonly')?.classList.remove('is-hidden');
+    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button')
+      .forEach((field) => { field.disabled = true; });
+  }
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    showError(null);
+    const data = new FormData(form);
+    const auditText = String(data.get('auditorias') ?? '').trim();
+    const auditIds = auditText ? auditText.split(/[\s,;]+/).filter(Boolean).map((value) => Number(value.replace(/^AUD-0*/i, ''))) : [];
+    if (auditIds.some((id) => !Number.isInteger(id) || id <= 0)) {
+      return showError(t('reportes.auditoriasInvalidas'));
+    }
+    const desde = dayToIso(String(data.get('desde') ?? ''), false);
+    const hasta = dayToIso(String(data.get('hasta') ?? ''), true);
+    if (auditIds.length === 0 && (!desde || !hasta)) {
+      return showError(t('reportes.faltaRango'));
+    }
+    if (desde && hasta && desde > hasta) return showError(t('bitacoras.rangoInvalido'));
+
+    const device = Number(data.get('dispositivoId')) || null;
+    const submit = document.querySelector<HTMLButtonElement>('#report-submit');
+    if (submit) submit.disabled = true;
+    try {
+      const response = await auditFetch('/api/reports/audits', jsonRequest('POST', {
+        organizacionId: Number(data.get('organizacionId')) || null,
+        desde,
+        hasta,
+        dispositivoIds: device ? [device] : [],
+        severidades: data.getAll('severidad'),
+        estados: data.getAll('estado'),
+        auditoriaIds: auditIds,
+      }));
+      if (!response.ok) return showError(await readApiError(response));
+      if (response.status !== 201) {
+        const body = await response.json() as { message?: string };
+        return showError(body.message ?? t('reportes.sinResultados'));
+      }
+      const report = await response.json() as AuditReport;
+      showSuccess(t('reportes.generado', { codigo: code('REP', report.id), auditorias: report.totalAuditorias, hallazgos: report.totalHallazgos }));
+      await loadReports();
+      selectedId = report.id;
+      renderList();
+      renderReport(report);
+      scrollToView(view);
+    } finally {
+      if (submit) submit.disabled = !canGenerate;
+    }
+  });
+};
+
+setupForm();
+loadReferences()
+  .catch(() => {})
+  .then(loadReports)
+  .then(() => {
+    const initial = Number(params.get('reporte')) || null;
+    if (initial) void openReport(initial);
+  })
+  .catch((error) => showError(error instanceof Error ? error.message : t('reportes.errorCargar')));
diff --git a/frontend/web-app/src/scripts/reset-password.ts b/frontend/web-app/src/scripts/reset-password.ts
new file mode 100644
index 0000000..e9c1e05
--- /dev/null
+++ b/frontend/web-app/src/scripts/reset-password.ts
@@ -0,0 +1,60 @@
+// Nueva contraseña desde el enlace del correo.
+import { MANAGEMENT_API_URL, readApiError } from '../lib/api';
+import { idiomaActual, t } from '../lib/i18n';
+import { PASSWORD_RULES, updatePasswordRules } from '../lib/password';
+
+const token = new URLSearchParams(window.location.search).get('token') ?? '';
+// El token no queda en la barra de direcciones ni en el historial.
+window.history.replaceState({}, '', '/reset-password');
+
+const form = document.querySelector<HTMLFormElement>('#reset-form');
+const fields = document.querySelector<HTMLFieldSetElement>('#reset-fields');
+const submit = document.querySelector<HTMLButtonElement>('#reset-submit');
+const errorBox = document.querySelector<HTMLElement>('#reset-error');
+const password = document.querySelector<HTMLInputElement>('#reset-password')!;
+const confirm = document.querySelector<HTMLInputElement>('#reset-confirm')!;
+const rules = document.querySelector<HTMLElement>('#reset-rules');
+
+// Esta pantalla no conoce el nombre de usuario: esa regla solo la controla el servidor, que avisa si no se cumple.
+if (rules) {
+  rules.innerHTML = PASSWORD_RULES.filter((rule) => rule.id !== 'username')
+    .map((rule) => `<li data-rule="${rule.id}">${rule.text}</li>`).join('');
+}
+const syncRules = () => updatePasswordRules(rules, password.value, '');
+password.addEventListener('input', syncRules);
+
+const fail = (message: string) => {
+  if (!errorBox) return;
+  errorBox.textContent = message;
+  errorBox.classList.remove('is-hidden');
+};
+
+if (!token) {
+  document.querySelector('#reset-missing')?.classList.remove('is-hidden');
+  if (fields) fields.disabled = true;
+  submit?.classList.add('is-hidden');
+}
+
+form?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  errorBox?.classList.add('is-hidden');
+  if (!syncRules()) return fail(t('restablecer.politica'));
+  if (password.value !== confirm.value) return fail(t('restablecer.distintas'));
+  if (submit) submit.disabled = true;
+  try {
+    const response = await fetch(`${MANAGEMENT_API_URL}/api/auth/password-reset`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'Accept-Language': idiomaActual() },
+      body: JSON.stringify({ token, password: password.value }),
+    });
+    if (!response.ok) throw new Error(await readApiError(response));
+    form.reset();
+    if (fields) fields.disabled = true;
+    submit?.classList.add('is-hidden');
+    document.querySelector('#reset-done')?.classList.remove('is-hidden');
+  } catch (error) {
+    fail(error instanceof Error ? error.message : t('restablecer.error'));
+  } finally {
+    if (submit) submit.disabled = false;
+  }
+});
diff --git a/frontend/web-app/src/scripts/results.ts b/frontend/web-app/src/scripts/results.ts
new file mode 100644
index 0000000..3fe60a6
--- /dev/null
+++ b/frontend/web-app/src/scripts/results.ts
@@ -0,0 +1,391 @@
+// Hallazgos: listado priorizado, evidencia y seguimiento.
+import { auditFetch, hasRole } from '../lib/auth';
+import {
+  FINDING_TRANSITIONS,
+  findingStatusNeedsComment,
+  jsonRequest,
+  readApiError,
+  type AuditFinding,
+  type ConfigurationBaseline,
+  type FindingStatus,
+  type FindingTracking,
+  type NetworkDevice,
+} from '../lib/api';
+import {
+  code,
+  escapeHtml,
+  findingStatusBadge,
+  findingStatusLabel,
+  formatDate,
+  localToIso,
+  plural,
+  severityClass,
+  severityCode,
+} from '../lib/format';
+import { etiqueta, t } from '../lib/i18n';
+import { crearPaginador } from '../lib/paginador';
+import { show } from '../lib/ui';
+import { evidencia } from '../lib/evidencia';
+
+let findings: AuditFinding[] = [];
+let devices: NetworkDevice[] = [];
+let baselines: ConfigurationBaseline[] = [];
+let selectedId: number | null = null;
+// Filtro por auditoría cuando se llega desde el historial (/results?auditoria=ID).
+const urlParams = new URLSearchParams(window.location.search);
+let auditFilter = Number(urlParams.get('auditoria')) || null;
+// Desde alertas, el tablero o la vista del cliente: ?hallazgo=ID abre ese hallazgo; ?estado=, ?severidad= y
+// ?dispositivo= precargan los filtros.
+const initialFinding = Number(urlParams.get('hallazgo')) || null;
+// Evita que una respuesta lenta pise a una más nueva (filtros o selección cambiados rápido).
+let loadSeq = 0;
+
+const canTrack = hasRole('ADMINISTRADOR_SISTEMA') || hasRole('ANALISTA_RED') || hasRole('AUDITOR_TECNICO');
+
+const form = document.querySelector<HTMLFormElement>('#finding-filters');
+// Se pagina en el navegador porque las métricas y la búsqueda rápida usan todos los hallazgos filtrados.
+const paginador = crearPaginador(document.querySelector<HTMLElement>('#finding-pager'), { alCambiar: () => render() });
+const search = document.querySelector<HTMLInputElement>('#finding-search');
+
+const deviceById = (id: number) => devices.find((item) => item.id === id);
+const baselineById = (id: number) => baselines.find((item) => item.id === id);
+
+const showError = (message: string | null) => show('#finding-error', message);
+const showSuccess = (message: string) => {
+  show('#finding-success', message);
+  window.setTimeout(() => show('#finding-success', null), 4200);
+};
+
+const buildQuery = () => {
+  const params = new URLSearchParams();
+  if (form) {
+    const data = new FormData(form);
+    for (const name of ['estado', 'severidad', 'dispositivoId', 'baselineId']) {
+      const value = String(data.get(name) ?? '');
+      if (value) params.set(name, value);
+    }
+    const desde = localToIso(String(data.get('desde') ?? ''));
+    const hasta = localToIso(String(data.get('hasta') ?? ''), true);
+    if (desde) params.set('desde', desde);
+    if (hasta) params.set('hasta', hasta);
+    if (desde && hasta && desde > hasta) throw new Error(t('bitacoras.rangoInvalido'));
+  }
+  if (auditFilter) params.set('auditoriaId', String(auditFilter));
+  const query = params.toString();
+  return query ? `?${query}` : '';
+};
+
+const renderMetrics = () => {
+  const set = (selector: string, value: number) => {
+    const node = document.querySelector<HTMLElement>(selector);
+    if (node) node.textContent = String(value);
+  };
+  const pending = findings.filter((f) => f.estado === 'ABIERTO' || f.estado === 'EN_REVISION');
+  set('#metric-pending', pending.length);
+  const overdue = pending.filter(isOverdue).length;
+  const note = document.querySelector('#metric-pending-note');
+  if (note) note.textContent = overdue ? t('hallazgos.abiertosVencidos', { n: overdue }) : t('hallazgos.abiertosRevision');
+  set('#metric-critical', pending.filter((f) => f.severidad === 'CRITICA' || f.severidad === 'ALTA').length);
+  set('#metric-review', findings.filter((f) => f.estado === 'EN_REVISION').length);
+  set('#metric-closed', findings.filter((f) => f.estado === 'RESUELTO' || f.estado === 'ACEPTADO').length);
+};
+
+const searchTerm = () => search?.value.trim().toLowerCase() ?? '';
+const visibleFindings = () => {
+  const term = searchTerm();
+  return findings.filter((finding) => {
+    if (!term) return true;
+    const device = deviceById(finding.dispositivoId);
+    const baseline = baselineById(finding.baselineId);
+    return [finding.codigoRegla, finding.nombreRegla, finding.evidencia, device?.identificador, device?.nombre, baseline?.nombre]
+      .join(' ').toLowerCase().includes(term);
+  });
+};
+
+// Plazo de corrección: lo calcula el servidor con la política de la organización.
+const isOverdue = (finding: AuditFinding) => Boolean(finding.venceEn) && Date.parse(finding.venceEn!) < Date.now();
+const overdueBadge = (finding: AuditFinding) =>
+  isOverdue(finding) ? `<span class="status-badge status-locked">${t('hallazgos.vencido')}</span>` : '';
+const dueText = (venceEn: string) => {
+  const days = Math.round((Date.parse(venceEn) - Date.now()) / 86_400_000);
+  if (days < 0) return `${formatDate(venceEn)} · ${plural(-days, 'hallazgos.vencidoHace')}`;
+  return `${formatDate(venceEn)} · ${days === 0 ? t('hallazgos.venceHoy') : plural(days, 'hallazgos.faltan')}`;
+};
+
+const render = () => {
+  const body = document.querySelector<HTMLTableSectionElement>('#finding-table-body');
+  if (!body) return;
+  const term = searchTerm();
+  const visible = visibleFindings();
+
+  body.innerHTML = paginador.recortar(visible).map((finding) => {
+    const device = deviceById(finding.dispositivoId);
+    const classes = ['finding-row'];
+    if (finding.id === selectedId) classes.push('is-selected');
+    if (finding.severidad === 'CRITICA' && (finding.estado === 'ABIERTO' || finding.estado === 'EN_REVISION')) {
+      classes.push('is-critical');
+    }
+    if (finding.estado === 'RESUELTO' || finding.estado === 'ACEPTADO') classes.push('is-closed');
+    return `
+      <tr class="${classes.join(' ')}" data-finding-id="${finding.id}" tabindex="0">
+        <td><code>${code('FND', finding.id)}</code></td>
+        <td><strong>${escapeHtml(finding.codigoRegla)}</strong><small>${escapeHtml(finding.nombreRegla)}</small></td>
+        <td>
+          <strong>${escapeHtml(device?.identificador ?? `#${finding.dispositivoId}`)}</strong>
+          <small>${escapeHtml(t('hallazgos.criticidad', { criticidad: severityCode(finding.criticidadDispositivo) }))}</small>
+        </td>
+        <td><span class="severity-badge ${severityClass(finding.severidad)}">${escapeHtml(severityCode(finding.severidad))}</span></td>
+        <td><span class="badge-row">${findingStatusBadge(finding.estado)}${overdueBadge(finding)}</span></td>
+        <td><span class="log-nowrap">${escapeHtml(formatDate(finding.fechaDeteccion))}</span></td>
+      </tr>`;
+  }).join('');
+
+  const count = document.querySelector<HTMLElement>('#finding-count');
+  if (count) count.textContent = term ? `${visible.length}/${findings.length}` : String(findings.length);
+  const emptyText = document.querySelector<HTMLElement>('#finding-empty-text');
+  if (emptyText) {
+    emptyText.textContent = findings.length === 0 && !term
+      ? t('hallazgos.sinDesvios')
+      : t('hallazgos.sinCoincidencias');
+  }
+  document.querySelector('#finding-empty')?.classList.toggle('is-hidden', visible.length > 0);
+
+  body.querySelectorAll<HTMLElement>('[data-finding-id]').forEach((row) => {
+    const select = () => void selectFinding(Number(row.dataset.findingId));
+    row.addEventListener('click', select);
+    row.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        select();
+      }
+    });
+  });
+};
+
+const trackingHtml = (history: FindingTracking[]) => history.length === 0
+  ? `<p class="log-muted">${escapeHtml(t('hallazgos.sinCambiosEstado'))}</p>`
+  : `<ol class="tracking-list">${history.map((item) => `
+      <li>
+        <div><code>${escapeHtml(etiqueta('hallazgo', item.estadoAnterior))} → ${escapeHtml(etiqueta('hallazgo', item.estadoNuevo))}</code>
+        <small>${escapeHtml(item.usuario)} · ${escapeHtml(formatDate(item.fecha))}</small></div>
+        ${item.comentario ? `<p>${escapeHtml(item.comentario)}</p>` : ''}
+      </li>`).join('')}</ol>`;
+
+const trackingFormHtml = (finding: AuditFinding) => {
+  if (!canTrack) {
+    return `<p class="log-muted">${escapeHtml(t('hallazgos.soloConsulta'))}</p>`;
+  }
+  const options = FINDING_TRANSITIONS[finding.estado]
+    .map((status) => `<option value="${status}">${escapeHtml(etiqueta('hallazgo', status))} · ${escapeHtml(findingStatusLabel(status))}</option>`)
+    .join('');
+  return `
+    <form id="tracking-form" class="tracking-form" novalidate>
+      <label class="log-filter">
+        <span>${t('hallazgos.nuevoEstado')}</span>
+        <select id="tracking-status" class="technical-select">${options}</select>
+      </label>
+      <label class="log-filter">
+        <span id="tracking-comment-label">${t('plan.comentario')}</span>
+        <textarea id="tracking-comment" class="technical-input tracking-comment" rows="3" maxlength="1000"
+          placeholder="${t('hallazgos.comentarioEjemplo')}"></textarea>
+      </label>
+      <div id="tracking-error" class="alert alert-error is-hidden"></div>
+      <button class="button button-primary button-small button-full" type="submit">${t('hallazgos.actualizarEstado')}</button>
+    </form>`;
+};
+
+const selectFinding = async (id: number) => {
+  selectedId = id;
+  render();
+
+  const [findingResponse, historyResponse] = await Promise.all([
+    auditFetch(`/api/findings/${id}`),
+    auditFetch(`/api/findings/${id}/history`),
+  ]);
+  if (id !== selectedId) return; // el usuario ya eligió otro hallazgo
+  if (!findingResponse.ok) return showError(await readApiError(findingResponse));
+  if (!historyResponse.ok) return showError(await readApiError(historyResponse));
+
+  const finding = await findingResponse.json() as AuditFinding;
+  const history = await historyResponse.json() as FindingTracking[];
+  if (id !== selectedId) return;
+  const device = deviceById(finding.dispositivoId);
+  const baseline = baselineById(finding.baselineId);
+  document.querySelector('#finding-inspector-empty')?.classList.add('is-hidden');
+
+  const content = document.querySelector<HTMLElement>('#finding-inspector-content');
+  if (!content) return;
+  content.innerHTML = `
+    <div class="inspector-identity">
+      <span class="inspector-code">${code('FND', finding.id)}</span>
+      <h3>${escapeHtml(finding.nombreRegla)}</h3>
+      <div class="badge-row">
+        <span class="severity-badge ${severityClass(finding.severidad)}">${escapeHtml(severityCode(finding.severidad))}</span>
+        ${findingStatusBadge(finding.estado)}
+        ${overdueBadge(finding)}
+      </div>
+    </div>
+
+    <dl class="technical-definition-list">
+      <div><dt>${t('hallazgos.regla')}</dt><dd>${escapeHtml(finding.codigoRegla)}</dd></div>
+      <div><dt>${t('reglas.condicionDetalle')}</dt><dd>${escapeHtml(etiqueta('condicion', finding.tipoRegla))}</dd></div>
+      <div><dt>${t('general.dispositivo')}</dt><dd>${escapeHtml(device?.identificador ?? `#${finding.dispositivoId}`)} · ${escapeHtml(t('hallazgos.criticidad', { criticidad: severityCode(finding.criticidadDispositivo) }))}</dd></div>
+      <div><dt>${t('general.baseline')}</dt><dd>${escapeHtml(baseline ? `${baseline.nombre} v${baseline.version}` : `#${finding.baselineId}`)}</dd></div>
+      <div><dt>${t('hallazgos.auditoria')}</dt><dd><a class="inline-link" href="/history?auditoria=${finding.auditoriaId}">${code('AUD', finding.auditoriaId)} →</a></dd></div>
+      <div><dt>${t('hallazgos.detectado')}</dt><dd>${escapeHtml(formatDate(finding.fechaDeteccion))}</dd></div>
+      ${finding.venceEn ? `<div><dt>${t('hallazgos.plazo')}</dt><dd>${escapeHtml(dueText(finding.venceEn))}</dd></div>` : ''}
+      <div><dt>${t('hallazgos.ultimoCambio')}</dt><dd>${finding.fechaEstado
+        ? `${escapeHtml(formatDate(finding.fechaEstado))} · ${escapeHtml(finding.usuarioEstado)}`
+        : escapeHtml(t('hallazgos.sinCambios'))}</dd></div>
+    </dl>
+
+    <div class="rule-expression-block">
+      <span>${t('hallazgos.patronBuscado')}</span>
+      <code>${escapeHtml(finding.patron)}</code>
+    </div>
+
+    <div class="finding-evidence-block">
+      <span>${t('hallazgos.evidencia')}</span>
+      <p>${escapeHtml(evidencia(finding.evidencia))}</p>
+    </div>
+
+    ${finding.impacto ? `
+    <div class="finding-evidence-block">
+      <span>${t('reglas.impacto')}</span>
+      <p>${escapeHtml(finding.impacto)}</p>
+    </div>` : ''}
+
+    <div class="rule-recommendation">
+      <span>${t('reglas.recomendacion')}</span>
+      <p>${escapeHtml(finding.recomendacion)}</p>
+    </div>
+
+    <div class="baseline-versions">
+      <span>${t('hallazgos.seguimiento')}</span>
+      ${trackingHtml(history)}
+    </div>
+
+    ${trackingFormHtml(finding)}
+  `;
+  content.classList.remove('is-hidden');
+  wireTrackingForm(finding);
+};
+
+const wireTrackingForm = (finding: AuditFinding) => {
+  const trackingForm = document.querySelector<HTMLFormElement>('#tracking-form');
+  const status = document.querySelector<HTMLSelectElement>('#tracking-status');
+  const comment = document.querySelector<HTMLTextAreaElement>('#tracking-comment');
+  if (!trackingForm || !status || !comment) return;
+
+  const syncLabel = () => {
+    const needs = findingStatusNeedsComment(status.value as FindingStatus);
+    const label = document.querySelector('#tracking-comment-label');
+    if (label) label.textContent = t(needs ? 'hallazgos.comentarioObligatorio' : 'hallazgos.comentarioOpcional');
+    comment.required = needs;
+  };
+  status.addEventListener('change', syncLabel);
+  syncLabel();
+
+  trackingForm.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    show('#tracking-error', null);
+    const nuevoEstado = status.value as FindingStatus;
+    if (findingStatusNeedsComment(nuevoEstado) && !comment.value.trim()) {
+      show('#tracking-error', t('hallazgos.faltaComentario', { estado: etiqueta('hallazgo', nuevoEstado) }));
+      return;
+    }
+    const response = await auditFetch(`/api/findings/${finding.id}/status`, jsonRequest('PATCH', {
+      estado: nuevoEstado,
+      comentario: comment.value.trim() || null,
+    }));
+    if (!response.ok) {
+      show('#tracking-error', await readApiError(response));
+      return;
+    }
+    const updated = await response.json() as AuditFinding;
+    findings = findings.map((item) => item.id === updated.id ? updated : item);
+    showSuccess(t('hallazgos.ahoraEsta', { codigo: code('FND', updated.id), estado: etiqueta('hallazgo', updated.estado) }));
+    renderMetrics();
+    await selectFinding(updated.id);
+  });
+};
+
+const loadFindings = async () => {
+  showError(null);
+  let query: string;
+  try {
+    query = buildQuery();
+  } catch (error) {
+    showError(error instanceof Error ? error.message : t('bitacoras.filtrosInvalidos'));
+    return;
+  }
+  const seq = ++loadSeq;
+  const response = await auditFetch(`/api/findings${query}`);
+  if (seq !== loadSeq) return;
+  if (!response.ok) {
+    showError(await readApiError(response));
+    return;
+  }
+  const data = await response.json() as AuditFinding[];
+  if (seq !== loadSeq) return;
+  findings = data;
+  paginador.reiniciar();
+  renderMetrics();
+  render();
+};
+
+const loadReferences = async () => {
+  const [deviceResponse, baselineResponse] = await Promise.all([
+    auditFetch('/api/devices'),
+    auditFetch('/api/baselines'),
+  ]);
+  for (const response of [deviceResponse, baselineResponse]) {
+    if (!response.ok) throw new Error(await readApiError(response));
+  }
+  devices = await deviceResponse.json() as NetworkDevice[];
+  baselines = await baselineResponse.json() as ConfigurationBaseline[];
+
+  const deviceSelect = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
+  devices.forEach((device) => deviceSelect?.add(new Option(`${device.identificador} · ${device.nombre}`, String(device.id))));
+  const baselineSelect = form?.querySelector<HTMLSelectElement>('[name=baselineId]');
+  baselines.forEach((baseline) => baselineSelect?.add(new Option(`${baseline.nombre} v${baseline.version}`, String(baseline.id))));
+
+  const preset: Record<string, string | null> = {
+    estado: urlParams.get('estado'),
+    severidad: urlParams.get('severidad'),
+    dispositivoId: urlParams.get('dispositivo'),
+  };
+  for (const [name, value] of Object.entries(preset)) {
+    const field = form?.querySelector<HTMLSelectElement>(`[name=${name}]`);
+    if (field && value && Array.from(field.options).some((option) => option.value === value)) field.value = value;
+  }
+};
+
+form?.addEventListener('submit', (event) => {
+  event.preventDefault();
+  void loadFindings();
+});
+document.querySelector('#finding-clear')?.addEventListener('click', () => {
+  form?.reset();
+  if (search) search.value = '';
+  // "Limpiar" también quita el filtro por auditoría que venía en la URL (?auditoria=ID).
+  auditFilter = null;
+  window.history.replaceState(null, '', window.location.pathname);
+  void loadFindings();
+});
+search?.addEventListener('input', () => {
+  paginador.reiniciar();
+  render();
+});
+
+loadReferences()
+  .then(loadFindings)
+  .then(() => {
+    if (auditFilter) showSuccess(t('hallazgos.mostrandoAuditoria', { auditoria: code('AUD', auditFilter) }));
+    if (initialFinding) {
+      // Si el hallazgo pedido está en otra página, se muestra esa página.
+      paginador.irAPosicion(visibleFindings().findIndex((finding) => finding.id === initialFinding));
+      void selectFinding(initialFinding);
+    }
+  })
+  .catch((error) => showError(error instanceof Error ? error.message : t('hallazgos.errorCargar')));
diff --git a/frontend/web-app/src/scripts/rules.ts b/frontend/web-app/src/scripts/rules.ts
new file mode 100644
index 0000000..c9ff25e
--- /dev/null
+++ b/frontend/web-app/src/scripts/rules.ts
@@ -0,0 +1,337 @@
+// Reglas: alta, edición y activación de los controles de cada baseline.
+import { auditFetch, authFetch } from '../lib/auth';
+import {
+  jsonRequest,
+  readApiError,
+  type BaselineRule,
+  type ConfigurationBaseline,
+  type Organization,
+  type RuleType,
+} from '../lib/api';
+import { plural, severityCode } from '../lib/format';
+import { etiqueta, t } from '../lib/i18n';
+import { confirmAction, notify, setText } from '../lib/ui';
+
+const state = {
+  rules: [] as BaselineRule[],
+  baselines: [] as ConfigurationBaseline[],
+  organizations: [] as Organization[],
+  current: null as BaselineRule | null,
+  editing: null as BaselineRule | null,
+};
+
+const body = document.querySelector<HTMLTableSectionElement>('#rules-body');
+const empty = document.querySelector<HTMLElement>('#rules-empty');
+const count = document.querySelector<HTMLElement>('#rule-count');
+const search = document.querySelector<HTMLInputElement>('#rule-search');
+const severityFilter = document.querySelector<HTMLSelectElement>('#rule-severity-filter');
+const statusFilter = document.querySelector<HTMLSelectElement>('#rule-status-filter');
+const dialog = document.querySelector<HTMLDialogElement>('#rule-dialog');
+const form = document.querySelector<HTMLFormElement>('#rule-form');
+const formError = document.querySelector<HTMLElement>('#rule-form-error');
+const baselineSelect = document.querySelector<HTMLSelectElement>('#rule-baseline');
+const typeSelect = document.querySelector<HTMLSelectElement>('#rule-type');
+const codeInput = document.querySelector<HTMLInputElement>('#rule-code');
+const expectedInput = document.querySelector<HTMLInputElement>('#rule-expected');
+
+const baselineFor = (id: number) => state.baselines.find((baseline) => baseline.id === id);
+const organizationFor = (id: number) => state.organizations.find((org) => org.id === id);
+
+const fieldValue = (selector: string) =>
+  (document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(selector)?.value ?? '').trim();
+
+const showMessage = (text: string, kind: 'success' | 'error' = 'success') => notify('#rule-message', text, kind, 5200);
+
+function severityClass(value: BaselineRule['severidad']): string {
+  if (value === 'CRITICA') return 'severity-critical';
+  if (value === 'ALTA') return 'severity-high';
+  if (value === 'MEDIA') return 'severity-medium';
+  return 'severity-low';
+}
+
+const conditionLabel = (value: RuleType) => etiqueta('condicion', value);
+const ruleStatus = (value: string) => etiqueta('regla', value);
+
+const conditionText = (rule: BaselineRule) =>
+  rule.tipo === 'VALOR_ESPERADO' ? `${rule.patron} = ${rule.valorEsperado ?? ''}` : rule.patron;
+
+const isFrozen = (rule: BaselineRule) => (baselineFor(rule.baselineId)?.auditorias ?? 0) > 0;
+
+function baselineLabel(baseline: ConfigurationBaseline): string {
+  const org = organizationFor(baseline.organizacionId);
+  return `${baseline.nombre} v${baseline.version} · ${org?.razonSocial ?? ''}`;
+}
+
+function filteredRules(): BaselineRule[] {
+  const query = search?.value.trim().toLowerCase() ?? '';
+  const severity = severityFilter?.value ?? '';
+  const status = statusFilter?.value ?? '';
+  return state.rules.filter((rule) => {
+    const baseline = baselineFor(rule.baselineId);
+    const haystack = [rule.codigo, rule.nombre, rule.descripcion, conditionText(rule), rule.impacto, baseline?.nombre ?? '']
+      .join(' ').toLowerCase();
+    return (!query || haystack.includes(query))
+      && (!severity || rule.severidad === severity)
+      && (!status || rule.estado === status);
+  });
+}
+
+function buildRow(rule: BaselineRule): HTMLTableRowElement {
+  const row = document.createElement('tr');
+  row.className = 'policy-row';
+  row.classList.toggle('is-selected', state.current?.id === rule.id);
+  row.tabIndex = 0;
+  row.dataset.ruleId = String(rule.id);
+  const baseline = baselineFor(rule.baselineId);
+
+  const code = document.createElement('td');
+  const codeNode = document.createElement('code');
+  codeNode.textContent = rule.codigo;
+  code.appendChild(codeNode);
+
+  const name = document.createElement('td');
+  const strong = document.createElement('strong');
+  strong.textContent = rule.nombre;
+  const small = document.createElement('small');
+  small.textContent = conditionText(rule);
+  name.append(strong, small);
+
+  const baselineCell = document.createElement('td');
+  baselineCell.textContent = baseline ? `${baseline.nombre} v${baseline.version}` : `#${rule.baselineId}`;
+
+  const type = document.createElement('td');
+  const typeCode = document.createElement('code');
+  typeCode.textContent = conditionLabel(rule.tipo);
+  type.appendChild(typeCode);
+
+  const severity = document.createElement('td');
+  const severityBadge = document.createElement('span');
+  severityBadge.className = `severity-badge ${severityClass(rule.severidad)}`;
+  severityBadge.textContent = severityCode(rule.severidad);
+  severity.appendChild(severityBadge);
+
+  const status = document.createElement('td');
+  const statusBadge = document.createElement('span');
+  statusBadge.className = `status-badge ${rule.estado === 'ACTIVA' ? 'status-ready' : 'status-next'}`;
+  statusBadge.textContent = ruleStatus(rule.estado);
+  status.appendChild(statusBadge);
+
+  row.append(code, name, baselineCell, type, severity, status);
+  const inspect = () => void inspectRule(rule.id);
+  row.addEventListener('click', inspect);
+  row.addEventListener('keydown', (event) => {
+    if (event.key === 'Enter' || event.key === ' ') inspect();
+  });
+  return row;
+}
+
+function render(): void {
+  const rules = filteredRules();
+  if (count) count.textContent = plural(state.rules.length, 'reglas.cantidad');
+  if (!body || !empty) return;
+  body.replaceChildren(...rules.map(buildRow));
+  empty.classList.toggle('is-hidden', rules.length > 0);
+  document.querySelector('.policy-table')?.classList.toggle('is-hidden', rules.length === 0);
+}
+
+async function inspectRule(id: number): Promise<void> {
+  const response = await auditFetch(`/api/rules/${id}`);
+  if (!response.ok) return showMessage(await readApiError(response), 'error');
+  showRule(await response.json() as BaselineRule);
+}
+
+function showRule(rule: BaselineRule): void {
+  state.current = rule;
+  document.querySelectorAll<HTMLElement>('.policy-row').forEach((row) => {
+    row.classList.toggle('is-selected', row.dataset.ruleId === String(rule.id));
+  });
+
+  const baseline = baselineFor(rule.baselineId);
+  const expected = rule.tipo === 'VALOR_ESPERADO';
+  const frozen = isFrozen(rule);
+  setText('#rule-inspector-code', rule.codigo);
+  setText('#rule-inspector-name', rule.nombre);
+  setText('#rule-inspector-status', ruleStatus(rule.estado));
+  setText('#rule-inspector-description', rule.descripcion);
+  setText('#rule-inspector-baseline', baseline ? baselineLabel(baseline) : `#${rule.baselineId}`);
+  setText('#rule-inspector-type', rule.tipo);
+  setText('#rule-inspector-severity', severityCode(rule.severidad));
+  setText('#rule-inspector-id', String(rule.id));
+  setText('#rule-inspector-pattern-label', t(expected ? 'reglas.parametro' : 'reglas.patron'));
+  setText('#rule-inspector-pattern', rule.patron);
+  setText('#rule-inspector-expected', rule.valorEsperado ?? '—');
+  setText('#rule-inspector-impact', rule.impacto);
+  setText('#rule-inspector-recommendation', rule.recomendacion);
+  setText('#rule-toggle', t(rule.estado === 'ACTIVA' ? 'reglas.desactivar' : 'baselines.activar'));
+  document.querySelector('#rule-inspector-expected-block')?.classList.toggle('is-hidden', !expected);
+  document.querySelector('#rule-inspector-frozen')?.classList.toggle('is-hidden', !frozen);
+
+  const editButton = document.querySelector<HTMLButtonElement>('#rule-edit');
+  if (editButton) {
+    editButton.disabled = frozen || baseline?.estado !== 'ACTIVO';
+    editButton.title = frozen
+      ? t('reglas.baselineUsada')
+      : baseline?.estado !== 'ACTIVO' ? t('reglas.baselineInactiva') : '';
+  }
+  const toggleButton = document.querySelector<HTMLButtonElement>('#rule-toggle');
+  if (toggleButton) {
+    // La baja lógica siempre se permite; reactivar agrega un criterio y requiere una baseline editable.
+    const blocked = rule.estado === 'INACTIVA' && (frozen || baseline?.estado !== 'ACTIVO');
+    toggleButton.disabled = blocked;
+    toggleButton.title = blocked ? t('reglas.reactivarAyuda') : '';
+  }
+  const status = document.querySelector('#rule-inspector-status');
+  if (status) status.className = `status-badge ${rule.estado === 'ACTIVA' ? 'status-ready' : 'status-next'}`;
+  document.querySelector('#rule-inspector-empty')?.classList.add('is-hidden');
+  document.querySelector('#rule-inspector-content')?.classList.remove('is-hidden');
+}
+
+function fillBaselineSelect(selected?: number): void {
+  if (!baselineSelect) return;
+  baselineSelect.replaceChildren(new Option(t('reglas.seleccionarBaseline'), ''));
+  state.baselines
+    .filter((baseline) => baseline.estado === 'ACTIVO' || baseline.id === selected)
+    .forEach((baseline) => {
+      const frozen = baseline.auditorias > 0;
+      const option = new Option(
+        `${baselineLabel(baseline)}${frozen ? ` · ${t('reglas.usadaEnAuditorias')}` : ''}`,
+        String(baseline.id),
+      );
+      option.disabled = frozen && baseline.id !== selected;
+      baselineSelect.add(option);
+    });
+  if (selected) {
+    baselineSelect.value = String(selected);
+    return;
+  }
+  const editable = state.baselines.filter((baseline) => baseline.estado === 'ACTIVO' && baseline.auditorias === 0);
+  if (editable.length === 1) baselineSelect.value = String(editable[0].id);
+}
+
+async function load(): Promise<void> {
+  const [rulesResponse, baselinesResponse, organizationsResponse] = await Promise.all([
+    auditFetch('/api/rules'),
+    auditFetch('/api/baselines'),
+    authFetch('/api/client-organizations'),
+  ]);
+  for (const response of [rulesResponse, baselinesResponse, organizationsResponse]) {
+    if (!response.ok) throw new Error(await readApiError(response));
+  }
+  state.rules = await rulesResponse.json() as BaselineRule[];
+  state.baselines = await baselinesResponse.json() as ConfigurationBaseline[];
+  state.organizations = await organizationsResponse.json() as Organization[];
+  render();
+}
+
+function syncTypeFields(): void {
+  const expected = typeSelect?.value === 'VALOR_ESPERADO';
+  document.querySelector('#rule-expected-field')?.classList.toggle('is-hidden', !expected);
+  if (expectedInput) expectedInput.required = expected;
+  setText('#rule-pattern-label', t(expected ? 'reglas.parametroObligatorio' : 'reglas.patronObligatorio'));
+  const pattern = document.querySelector<HTMLInputElement>('#rule-pattern');
+  if (pattern) pattern.placeholder = expected ? 'logging buffered' : 'ip ssh version 2';
+}
+
+function openRuleDialog(rule: BaselineRule | null): void {
+  form?.reset();
+  formError?.classList.add('is-hidden');
+  state.editing = rule;
+  fillBaselineSelect(rule?.baselineId);
+  if (baselineSelect) baselineSelect.disabled = rule !== null;
+  if (codeInput) codeInput.disabled = rule !== null;
+
+  setText('#rule-dialog-eyebrow', t(rule ? 'reglas.editarRegla' : 'reglas.nuevaReglaTitulo'));
+  setText('#rule-dialog-title', rule ? t('dispositivos.editarIdentificador', { identificador: rule.codigo }) : t('reglas.crearRegla'));
+  setText('#rule-dialog-subtitle', rule
+    ? t('reglas.edicionAyuda')
+    : t('reglas.convertiCondicionConfiguracionControl'));
+  setText('#rule-submit', t(rule ? 'general.guardarCambios' : 'reglas.crearRegla'));
+
+  if (rule) {
+    const set = (selector: string, value: string) => {
+      const node = document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(selector);
+      if (node) node.value = value;
+    };
+    set('#rule-code', rule.codigo);
+    set('#rule-name', rule.nombre);
+    set('#rule-type', rule.tipo);
+    set('#rule-severity', rule.severidad);
+    set('#rule-pattern', rule.patron);
+    set('#rule-expected', rule.valorEsperado ?? '');
+    set('#rule-description', rule.descripcion);
+    set('#rule-impact', rule.impacto);
+    set('#rule-recommendation', rule.recomendacion);
+  }
+  syncTypeFields();
+  dialog?.showModal();
+}
+
+document.querySelector('#open-rule-dialog')?.addEventListener('click', () => openRuleDialog(null));
+document.querySelector('#rule-edit')?.addEventListener('click', () => {
+  if (state.current) openRuleDialog(state.current);
+});
+document.querySelector('#close-rule-dialog')?.addEventListener('click', () => dialog?.close());
+document.querySelector('#cancel-rule-dialog')?.addEventListener('click', () => dialog?.close());
+typeSelect?.addEventListener('change', syncTypeFields);
+search?.addEventListener('input', render);
+severityFilter?.addEventListener('change', render);
+statusFilter?.addEventListener('change', render);
+
+form?.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  formError?.classList.add('is-hidden');
+  const tipo = fieldValue('#rule-type') as RuleType;
+  const datos = {
+    nombre: fieldValue('#rule-name'),
+    descripcion: fieldValue('#rule-description'),
+    tipo,
+    patron: fieldValue('#rule-pattern'),
+    valorEsperado: tipo === 'VALOR_ESPERADO' ? fieldValue('#rule-expected') : null,
+    severidad: fieldValue('#rule-severity'),
+    impacto: fieldValue('#rule-impact'),
+    recomendacion: fieldValue('#rule-recommendation'),
+  };
+
+  const editing = state.editing;
+  const response = editing
+    ? await auditFetch(`/api/rules/${editing.id}`, jsonRequest('PUT', datos))
+    : await auditFetch(`/api/baselines/${Number(baselineSelect?.value)}/rules`,
+      jsonRequest('POST', { codigo: fieldValue('#rule-code'), ...datos }));
+  if (!response.ok) {
+    if (formError) {
+      formError.textContent = await readApiError(response);
+      formError.classList.remove('is-hidden');
+    }
+    return;
+  }
+  const saved = await response.json() as BaselineRule;
+  dialog?.close();
+  showMessage(t(editing ? 'reglas.actualizada' : 'reglas.creada', { codigo: saved.codigo }));
+  await load();
+  showRule(saved);
+});
+
+document.querySelector('#rule-toggle')?.addEventListener('click', async () => {
+  const rule = state.current;
+  if (!rule) return;
+  const deactivate = rule.estado === 'ACTIVA';
+  const question = deactivate
+    ? t('reglas.confirmarDesactivar', { codigo: rule.codigo })
+    : t('reglas.confirmarActivar', { codigo: rule.codigo });
+  if (!await confirmAction(t('general.confirmasOperacion'), question, t(deactivate ? 'reglas.desactivar' : 'baselines.activar'))) return;
+
+  const response = await auditFetch(`/api/rules/${rule.id}/status`,
+    jsonRequest('PATCH', { estado: deactivate ? 'INACTIVA' : 'ACTIVA' }));
+  if (!response.ok) {
+    showMessage(await readApiError(response), 'error');
+    return;
+  }
+  const saved = await response.json() as BaselineRule;
+  showMessage(t('reglas.ahoraEsta', { codigo: saved.codigo, estado: ruleStatus(saved.estado) }));
+  await load();
+  showRule(saved);
+});
+
+load().catch((error) => {
+  showMessage(error instanceof Error ? error.message : t('reglas.errorCargar'), 'error');
+});
diff --git a/frontend/web-app/src/scripts/users.ts b/frontend/web-app/src/scripts/users.ts
new file mode 100644
index 0000000..3d0c145
