+    assert _tema(pagina) == "claro", "se recuerda aunque el sistema esté en oscuro"
+
+    pagina.click("#account-theme [data-opcion-tema=sistema]")
+    assert _tema(pagina) == "oscuro"
+    assert pagina.evaluate("localStorage.getItem('auditnet.tema')") is None
