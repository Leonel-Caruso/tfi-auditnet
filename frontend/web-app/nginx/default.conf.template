# Sirve el sitio de Astro y enruta /api/... a cada servicio en el mismo origen
# (backends sin exponer y sin CORS). La imagen de nginx completa con envsubst
# ${MANAGEMENT_UPSTREAM} y ${CORE_UPSTREAM} al iniciar el contenedor.

# /_astro/ lleva hash en el nombre y se cachea un año. El HTML se revalida siempre: una página vieja
# pediría archivos /_astro/ que ya no existen tras un deploy. /api/ no se guarda en disco.
map $uri $auditnet_cache_control {
    ~^/_astro/  "public, max-age=31536000, immutable";
    ~^/(fonts|icons)/  "public, max-age=604800";
    ~^/api/     "no-store";
    default     "no-cache";
}

# Signo "$" literal para robots.txt ("Allow: /$" = solo la raíz); nginx no permite escribirlo directo en return.
geo $auditnet_dolar {
    default "$";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Detrás de Container Apps el HTTPS lo termina Azure: las redirecciones
    # deben ser relativas para no apuntar a http://...:8080
    absolute_redirect off;

    # Tamaño máximo de una configuración importada (.txt / .cfg)
    client_max_body_size 5m;

    # /api/ va con "gzip off" por riesgo tipo BREACH (token junto a datos del usuario).
    # "gzip_proxied any" porque la entrada de Azure puede agregar el encabezado Via.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/css application/javascript text/javascript image/svg+xml application/manifest+json text/plain application/xml text/xml;

    # Astro deja __ORIGEN_PUBLICO__ en canonical / Open Graph y nginx pone el dominio real.
    sub_filter_once off;
    sub_filter '__ORIGEN_PUBLICO__' 'https://$host';

    # HSTS sin includeSubDomains: *.azurecontainerapps.io no es nuestro. Por HTTP local se ignora.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control $auditnet_cache_control always;

    # X-Request-ID ($request_id) permite seguir una operación en las bitácoras de ambos servicios.

    # audit-core-service. Cuelgan de /api/client-organizations: van antes que la regex de
    # management-service porque nginx usa la primera que coincide.
    location ~ ^/api/client-organizations/[0-9]+/(audit-status|review-policy)/?$ {
        proxy_pass ${CORE_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 90s;
        gzip off;
    }

    # Revisión periódica: la llama la tarea programada de Azure, que está fuera de este entorno. audit-core exige el
    # secreto de tareas (X-AuditNet-Tarea); el resto de /internal no se publica.
    location = /internal/review/run {
        limit_except POST { deny all; }
        proxy_pass ${CORE_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        gzip off;
    }

    # management-service
    location ~ ^/api/(auth|users|roles|client-organizations|sites|plans|management|admin)(/|$) {
        proxy_pass ${MANAGEMENT_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 90s;
        gzip off;
    }

    # audit-core-service: el resto de la API
    location /api/ {
        proxy_pass ${CORE_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 90s;
        gzip off;
    }

    # Solo se indexa la pantalla de acceso; sus estilos, scripts e íconos quedan permitidos para renderizarla.
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nAllow: /login\nAllow: /${auditnet_dolar}\nAllow: /_astro/\nAllow: /fonts/\nAllow: /icons/\nAllow: /favicon\nAllow: /manifest.webmanifest\nDisallow: /\n\nSitemap: https://$host/sitemap.xml\n";
    }
    location = /sitemap.xml {
        default_type application/xml;
        return 200 '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n  <url><loc>https://$host/login</loc><changefreq>monthly</changefreq><priority>1.0</priority></url>\n</urlset>\n';
    }

    # Si ya hay sesión, el login redirige al tablero.
    location = / {
        return 302 /login;
    }

    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
    }

    # /devices -> /devices/index.html sin redirección
    location / {
        try_files $uri $uri/index.html $uri.html =404;
    }
}
