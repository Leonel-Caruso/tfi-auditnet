# =====================================================================
# AuditNet · Frontend + API Gateway (nginx)
# ---------------------------------------------------------------------
# 1. Sirve el sitio estático generado por Astro.
# 2. Actúa como API Gateway simple: el navegador llama siempre al mismo
#    origen (/api/...) y nginx deriva cada ruta al servicio que corresponde.
#    Así los backends no se exponen a Internet y no hace falta CORS.
#
# ${MANAGEMENT_UPSTREAM} y ${CORE_UPSTREAM} se completan al iniciar el
# contenedor (envsubst de la imagen oficial de nginx). Ejemplo:
#   MANAGEMENT_UPSTREAM=https://ca-auditnet-management.internal.<dominio>
# =====================================================================

# Caché del navegador:
# - /_astro/: archivos con hash en el nombre; cambian de nombre en cada build, se pueden guardar un año.
# - Páginas HTML: siempre se revalidan. Si el navegador usara una página vieja, pediría archivos /_astro/
#   que ya no existen después de un deploy y la pantalla se vería sin estilos ni scripts.
# - /api/: no se agrega nada (valor vacío = sin encabezado).
map $uri $auditnet_cache_control {
    ~^/_astro/  "public, max-age=31536000, immutable";
    ~^/api/     "";
    default     "no-cache";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Detrás de Container Apps el HTTPS lo termina Azure: las redirecciones
    # deben ser relativas para no apuntar a http://...:8080
    absolute_redirect off;

    # Tamaño máximo de una configuración importada (.txt / .cfg)
    client_max_body_size 5m;

    # Encabezados de seguridad básicos
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control $auditnet_cache_control always;

    # Identificador de correlación: nginx genera uno por solicitud ($request_id) y lo envía a los
    # servicios en X-Request-ID; las bitácoras lo guardan para seguir una operación de punta a punta.

    # ---- management-service: acceso, usuarios, roles, organizaciones, sedes y bitácoras (admin)
    location ~ ^/api/(auth|users|roles|client-organizations|sites|management|admin)(/|$) {
        proxy_pass ${MANAGEMENT_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 90s;
    }

    # ---- audit-core-service: el resto de la API (dispositivos, baselines,
    #      reglas, configuraciones, auditorías y hallazgos)
    location /api/ {
        proxy_pass ${CORE_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 90s;
    }

    # ---- Sitio estático de Astro (/devices -> /devices/index.html, sin redirecciones)
    location / {
        try_files $uri $uri/index.html $uri.html =404;
    }
}
