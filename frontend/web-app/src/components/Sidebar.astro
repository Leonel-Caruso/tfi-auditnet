---
import { es, type Clave } from '../i18n';

// En el build estático la ruta termina en '/' (ej. /logs/): se normaliza para comparar.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const ADMIN = 'ADMINISTRADOR_SISTEMA';
const ADMIN_ORGANIZACION = 'ADMINISTRADOR_ORGANIZACION';

// roles: perfiles que ven el ítem (sin roles lo ven todos).
const railItems = [
  { href: '/dashboard', code: '~/' },
  { href: '/client-status', code: 'CLI' },
  { separator: true },
  { href: '/organizations', code: 'ORG', roles: [ADMIN, ADMIN_ORGANIZACION] },
  { href: '/users', code: 'USR', roles: [ADMIN, ADMIN_ORGANIZACION] },
  { href: '/plan', code: 'PLN', roles: [ADMIN_ORGANIZACION, 'RESPONSABLE_GESTION_IT'] },
  { href: '/plans', code: 'PLN', roles: [ADMIN] },
  { href: '/logs', code: 'BIT', roles: [ADMIN] },
  { href: '/admin', code: 'ADM', roles: [ADMIN] },
  { separator: true },
  { href: '/devices', code: 'DEV' },
  { href: '/baselines', code: 'BL' },
  { href: '/rules', code: 'RUL' },
  { href: '/audits', code: 'RUN' },
  { href: '/history', code: 'HIS' },
  { href: '/results', code: 'LOG' },
  { href: '/alerts', code: 'ALR' },
  { href: '/reports', code: 'REP' },
];

const clave = (href?: string) => `menu.${href?.slice(1)}` as Clave;
const etiqueta = (href?: string) => es[clave(href)];
---

<aside class="command-rail" aria-label={es['consola.navegacion']} data-i18n-aria-label="consola.navegacion">
  <a class="rail-brand" href="/dashboard" aria-label={es['consola.inicio']} data-i18n-aria-label="consola.inicio" title="AuditNet">
    <span>A_</span>
  </a>

  <nav class="rail-nav">
    {railItems.map((item) => item.separator ? (
      <div class="rail-separator" aria-hidden="true"></div>
    ) : (
      <a
        href={item.href}
        class:list={["rail-link", currentPath === item.href && "is-active"]}
        data-label={etiqueta(item.href)}
        data-i18n-label={clave(item.href)}
        data-roles={item.roles?.join(',')}
        aria-label={etiqueta(item.href)}
        data-i18n-aria-label={clave(item.href)}
        title={etiqueta(item.href)}
        data-i18n-title={clave(item.href)}
      >
        <span>{item.code}</span>
      </a>
    ))}
  </nav>

  <div class="rail-runtime" aria-label={es['consola.estadoLocal']} data-i18n-aria-label="consola.estadoLocal">
    <span class="rail-status-dot is-online" title={es['consola.apiDisponible']} data-i18n-title="consola.apiDisponible"></span>
    <span class="rail-runtime-label">LOC</span>
  </div>
</aside>

<script>
  // Marca si quedan ítems ocultos arriba o abajo y centra el ítem actual. Se calcula con ResizeObserver porque
  // la consola recién se muestra al validar la sesión.
  const nav = document.querySelector<HTMLElement>('.rail-nav');
  if (nav) {
    let centered = false;
    const sync = () => {
      if (nav.clientHeight === 0) return;
      if (!centered) {
        centered = true;
        const active = nav.querySelector<HTMLElement>('.rail-link.is-active');
        if (active && nav.scrollHeight > nav.clientHeight) {
          const offset = active.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
          nav.scrollTop = Math.max(0, offset - (nav.clientHeight - active.offsetHeight) / 2);
        }
      }
      nav.classList.toggle('has-more-top', nav.scrollTop > 2);
      nav.classList.toggle('has-more-bottom', nav.scrollTop + nav.clientHeight < nav.scrollHeight - 2);
    };
    nav.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(nav);
    // Al validar la sesión se ocultan los ítems que el perfil no usa y cambia el alto.
    new MutationObserver(sync).observe(nav, { attributes: true, subtree: true, attributeFilter: ['hidden'] });
  }
</script>
