---
// En el build estático la ruta termina en '/' (ej. /logs/): se normaliza para comparar.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const ADMIN = 'ADMINISTRADOR_SISTEMA';
const ADMIN_ORGANIZACION = 'ADMINISTRADOR_ORGANIZACION';

// roles: perfiles que ven el ítem (sin roles lo ven todos).
const railItems = [
  { href: '/dashboard', label: 'Tablero de control', code: '~/' },
  { href: '/client-status', label: 'Estado del cliente', code: 'CLI' },
  { separator: true },
  { href: '/organizations', label: 'Organizaciones y sedes', code: 'ORG', roles: [ADMIN, ADMIN_ORGANIZACION] },
  { href: '/users', label: 'Usuarios', code: 'USR', roles: [ADMIN, ADMIN_ORGANIZACION] },
  { href: '/plan', label: 'Mi plan', code: 'PLN', roles: [ADMIN_ORGANIZACION, 'RESPONSABLE_GESTION_IT'] },
  { href: '/plans', label: 'Planes y solicitudes', code: 'PLN', roles: [ADMIN] },
  { href: '/logs', label: 'Bitácoras', code: 'BIT', roles: [ADMIN] },
  { href: '/admin', label: 'Panel de administración', code: 'ADM', roles: [ADMIN] },
  { separator: true },
  { href: '/devices', label: 'Dispositivos', code: 'DEV' },
  { href: '/baselines', label: 'Baselines', code: 'BL' },
  { href: '/rules', label: 'Reglas', code: 'RUL' },
  { href: '/audits', label: 'Auditorías', code: 'RUN' },
  { href: '/history', label: 'Historial de auditorías', code: 'HIS' },
  { href: '/results', label: 'Hallazgos', code: 'LOG' },
  { href: '/alerts', label: 'Alertas críticas', code: 'ALR' },
  { href: '/reports', label: 'Reportes', code: 'REP' },
];
---

<aside class="command-rail" aria-label="Navegación principal">
  <a class="rail-brand" href="/dashboard" aria-label="AuditNet · Inicio" title="AuditNet">
    <span>A_</span>
  </a>

  <nav class="rail-nav">
    {railItems.map((item) => item.separator ? (
      <div class="rail-separator" aria-hidden="true"></div>
    ) : (
      <a
        href={item.href}
        class:list={["rail-link", currentPath === item.href && "is-active"]}
        data-label={item.label}
        data-roles={item.roles?.join(',')}
        aria-label={item.label}
        title={item.label}
      >
        <span>{item.code}</span>
      </a>
    ))}
  </nav>

  <div class="rail-runtime" aria-label="Estado local">
    <span class="rail-status-dot is-online" title="API disponible"></span>
    <span class="rail-runtime-label">LOC</span>
  </div>
</aside>

<script>
  // Marca si quedan ítems ocultos arriba o abajo y centra el ítem actual. Se calcula con ResizeObserver porque
  // la consola recién se muestra al validar la sesión.
  const nav = document.querySelector<HTMLElement>('.rail-nav');
  if (nav) {
    let centered = false;
    const sync = () => {
      if (nav.clientHeight === 0) return;
      if (!centered) {
        centered = true;
        const active = nav.querySelector<HTMLElement>('.rail-link.is-active');
        if (active && nav.scrollHeight > nav.clientHeight) {
          const offset = active.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
          nav.scrollTop = Math.max(0, offset - (nav.clientHeight - active.offsetHeight) / 2);
        }
      }
      nav.classList.toggle('has-more-top', nav.scrollTop > 2);
      nav.classList.toggle('has-more-bottom', nav.scrollTop + nav.clientHeight < nav.scrollHeight - 2);
    };
    nav.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(nav);
    // Al validar la sesión se ocultan los ítems que el perfil no usa y cambia el alto.
    new MutationObserver(sync).observe(nav, { attributes: true, subtree: true, attributeFilter: ['hidden'] });
  }
</script>
