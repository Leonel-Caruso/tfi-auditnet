---
// En el build estático la ruta termina en '/' (ej. /logs/): se normaliza para comparar.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const labels: Record<string, string> = {
  '/dashboard': 'inicio',
  '/organizations': 'organizaciones',
  '/users': 'usuarios',
  '/plan': 'mi plan',
  '/plans': 'planes',
  '/logs': 'bitácoras',
  '/devices': 'dispositivos',
  '/baselines': 'baselines',
  '/rules': 'reglas',
  '/audits': 'auditorías',
  '/history': 'historial',
  '/results': 'hallazgos',
  '/alerts': 'alertas',
  '/client-status': 'estado del cliente',
  '/reports': 'reportes',
  '/admin': 'administración',
  '/account': 'mi cuenta',
};
const currentLabel = labels[path] ?? 'consola';
---

<header class="console-header">
  <div class="console-breadcrumb" aria-label="Ubicación actual">
    <strong>AuditNet</strong>
    <span>/</span>
    <code>{currentLabel}</code>
  </div>

  <div class="command-palette-shell">
    <span class="command-prefix">&gt;</span>
    <input
      id="command-palette"
      class="command-palette"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="ir a módulo..."
      aria-label="Navegar a un módulo"
    />
    <kbd>Enter</kbd>
  </div>

  <div class="header-actions">
    <div class="service-state" title="Conexión con los servicios">
      <span class="service-dot"></span>
      <code id="topbar-connection">conectando</code>
    </div>

    <div class="compact-user">
      <button id="user-menu-button" class="compact-user-button" type="button" aria-expanded="false" aria-controls="user-popover">
        <span class="compact-user-avatar" id="user-avatar">U_</span>
        <span class="compact-user-handle" id="user-handle">usuario</span>
        <span class="compact-user-caret">⌄</span>
      </button>

      <div id="user-popover" class="user-popover is-hidden">
        <div class="user-popover-copy">
          <strong id="user-name">Usuario</strong>
          <code id="user-role">sin perfil</code>
        </div>
        <div class="user-popover-divider"></div>
        <a class="user-popover-action" href="/account">Mi cuenta</a>
        <button id="logout-button" class="user-popover-action" type="button">Cerrar sesión</button>
      </div>
    </div>
  </div>
</header>
