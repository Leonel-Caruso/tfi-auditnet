---
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
import HeadMeta from '../components/HeadMeta.astro';
import { es } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: string;
  /**
   * Prefijo de las claves del encabezado en los diccionarios: con "cuenta" se usan cuenta.titulo, cuenta.seccion y
   * cuenta.descripcion. Sin prefijo, el encabezado queda en español.
   */
  i18n?: string;
}

const {
  title,
  description = 'Plataforma de auditoría y control de configuraciones de red.',
  section = 'Consola',
  i18n,
} = Astro.props;
const clave = (campo: string) => (i18n ? `${i18n}.${campo}` : undefined);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <HeadMeta title={`${title} · AuditNet`} description={description} tituloClave={clave('titulo')} />
  </head>
  <body class="app-body">
    <div id="session-loading" class="session-loading">
      <div class="spinner"></div>
      <span data-i18n="consola.validando">{es['consola.validando']}</span>
    </div>

    <div id="protected-shell" class="app-shell is-hidden">
      <Sidebar />
      <div class="app-content">
        <Topbar />
        <main class="page-content">
          <div class="page-heading">
            <div>
              <span class="eyebrow" data-i18n={clave('seccion')}>{section}</span>
              <h1 data-i18n={clave('titulo')}>{title}</h1>
              <p data-i18n={clave('descripcion')}>{description}</p>
            </div>
          </div>
          <slot />
        </main>
        <ConfirmDialog />
      </div>
    </div>

    <script>
      import { getStoredUser, logout, saveLanguage, saveTheme, verifySession } from '../lib/auth';
      import { PROFILE_ORDER, ROLE_LABEL } from '../lib/api';
      import { enhanceDateInputs } from '../lib/datepicker';
      import { conectarSelectorIdioma, mostrarTraducida, t } from '../lib/i18n';
      import { enlacesManual } from '../lib/manual';
      import { conectarSelectorTema } from '../lib/tema';

      mostrarTraducida();

      // Calendario propio en todos los campos de fecha.
      enhanceDateInputs(document);

      async function initializeShell() {
        try {
          const current = await verifySession();
          const stored = getStoredUser();
          const roles = current.roles ?? stored?.roles ?? [];
          const isAdmin = roles.includes('ADMINISTRADOR_SISTEMA');

          document.querySelectorAll('[data-admin-only="true"]').forEach((element) => {
            if (!isAdmin) element.setAttribute('hidden', '');
          });

          document.querySelectorAll<HTMLElement>('[data-roles]').forEach((element) => {
            const allowed = (element.dataset.roles ?? '')
              .split(',')
              .map((role) => role.trim())
              .filter(Boolean);
            if (!allowed.some((role) => roles.includes(role))) {
              element.setAttribute('hidden', '');
            }
          });

          const displayName = stored?.nombre || current.username;
          const nameNode = document.querySelector('#user-name');
          const roleNode = document.querySelector('#user-role');
          const avatarNode = document.querySelector('#user-avatar');
          const handleNode = document.querySelector('#user-handle');
          const connectionNode = document.querySelector('#topbar-connection');

          if (nameNode) nameNode.textContent = displayName;
          // Con varios perfiles se muestra el de mayor alcance.
          const mainRole = [...roles].sort((a, b) => PROFILE_ORDER.indexOf(a) - PROFILE_ORDER.indexOf(b))[0];
          if (roleNode) roleNode.textContent = mainRole ? ROLE_LABEL[mainRole] ?? mainRole : t('perfil.ninguno');
          if (avatarNode) avatarNode.textContent = `${displayName.slice(0, 1).toUpperCase()}_`;
          if (handleNode) handleNode.textContent = stored?.username ?? current.username;
          if (connectionNode) {
            connectionNode.textContent = t('consola.enLinea');
            connectionNode.classList.add('is-online');
          }

          const manuales = document.querySelector('#user-manuals');
          if (manuales) manuales.innerHTML = enlacesManual('user-popover-action', 'manual.enlace');

          document.querySelector('#session-loading')?.classList.add('is-hidden');
          document.querySelector('#protected-shell')?.classList.remove('is-hidden');
        } catch {
          // authFetch/verifySession redirige a /login cuando corresponde.
        }
      }

      conectarSelectorIdioma(document.querySelector('#user-popover') ?? document, saveLanguage);
      conectarSelectorTema(saveTheme);

      const userMenuButton = document.querySelector<HTMLButtonElement>('#user-menu-button');
      const userPopover = document.querySelector<HTMLElement>('#user-popover');

      userMenuButton?.addEventListener('click', () => {
        const willOpen = userPopover?.classList.contains('is-hidden') ?? true;
        userPopover?.classList.toggle('is-hidden', !willOpen);
        userMenuButton.setAttribute('aria-expanded', String(willOpen));
      });

      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (!userMenuButton?.contains(target) && !userPopover?.contains(target)) {
          userPopover?.classList.add('is-hidden');
          userMenuButton?.setAttribute('aria-expanded', 'false');
        }
      });

      const commandPalette = document.querySelector<HTMLInputElement>('#command-palette');
      const commandRoutes: Record<string, string> = {
        inicio: '/dashboard', home: '/dashboard', dashboard: '/dashboard',
        organizaciones: '/organizations', organizacion: '/organizations', org: '/organizations', sedes: '/organizations',
        usuarios: '/users', usuario: '/users', usr: '/users',
        plan: '/plan', 'mi plan': '/plan', planes: '/plans', solicitudes: '/plans',
        bitacoras: '/logs', bitacora: '/logs', 'bitácoras': '/logs', 'bitácora': '/logs', bit: '/logs', logs: '/logs',
        dispositivos: '/devices', dispositivo: '/devices', dev: '/devices', devices: '/devices',
        baselines: '/baselines', baseline: '/baselines', bl: '/baselines',
        reglas: '/rules', regla: '/rules', rul: '/rules', rules: '/rules',
        auditorias: '/audits', auditoria: '/audits', run: '/audits', audits: '/audits',
        historial: '/history', his: '/history', history: '/history',
        hallazgos: '/results', hallazgo: '/results', resultados: '/results', log: '/results', findings: '/results',
        alertas: '/alerts', alerta: '/alerts', alr: '/alerts', alerts: '/alerts',
        reportes: '/reports', reporte: '/reports', rep: '/reports', reports: '/reports',
        cliente: '/client-status', cli: '/client-status', estado: '/client-status', tablero: '/dashboard',
        admin: '/admin', adm: '/admin', panel: '/admin', salud: '/admin',
        cuenta: '/account', 'mi cuenta': '/account', contraseña: '/account', password: '/account',
        account: '/account', 'my account': '/account', conta: '/account', 'minha conta': '/account',
        users: '/users', 'usuários': '/users', organizations: '/organizations', 'organizações': '/organizations',
        achados: '/results', relatorios: '/reports', 'relatórios': '/reports',
        painel: '/dashboard', idioma: '/account', language: '/account'
      };

      commandPalette?.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        const command = commandPalette.value.trim().toLowerCase();
        const route = commandRoutes[command];
        if (route) window.location.assign(route);
        else {
          commandPalette.classList.add('is-invalid');
          window.setTimeout(() => commandPalette.classList.remove('is-invalid'), 450);
        }
      });

      document.querySelector('#logout-button')?.addEventListener('click', logout);
      initializeShell();
    </script>
  </body>
</html>
