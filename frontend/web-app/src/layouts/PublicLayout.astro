---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Acceso seguro a la consola de auditoría de configuraciones de red.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · AuditConfig</title>
  </head>
  <body class="public-body">
    <slot />
  </body>
</html>
