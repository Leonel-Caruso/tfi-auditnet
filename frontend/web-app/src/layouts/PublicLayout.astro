---
import HeadMeta from '../components/HeadMeta.astro';
import SelectorIdioma from '../components/SelectorIdioma.astro';
import SelectorTema from '../components/SelectorTema.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  indexable?: boolean;
  path?: string;
  /** Clave del título en los diccionarios. */
  tituloClave?: string;
}

const {
  title,
  description = 'Acceso seguro a la consola de auditoría de configuraciones de red.',
  indexable = false,
  path,
  tituloClave,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <HeadMeta title={`${title} · AuditNet`} description={description} indexable={indexable} path={path}
      tituloClave={tituloClave} />
  </head>
  <body class="public-body">
    <div class="public-switches">
      <SelectorTema />
      <SelectorIdioma class="language-switch-public" />
    </div>
    <slot />

    <script>
      import { conectarSelectorIdioma, mostrarTraducida } from '../lib/i18n';
      import { conectarSelectorTema } from '../lib/tema';

      mostrarTraducida();
      conectarSelectorIdioma(document.querySelector('.language-switch-public') ?? document);
      conectarSelectorTema();
    </script>
  </body>
</html>
