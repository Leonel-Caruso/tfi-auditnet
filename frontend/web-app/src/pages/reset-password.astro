---
import PublicLayout from '../layouts/PublicLayout.astro';
import AccessBrand from '../components/AccessBrand.astro';
import es from '../i18n/es';
---

<PublicLayout title={es['restablecer.metaTitulo']} tituloClave="restablecer.metaTitulo"
  description="Elegí una contraseña nueva para tu cuenta." path="/reset-password">
  <main class="login-screen">
    <AccessBrand titulo="restablecer.titular" texto="restablecer.bajada" />

    <section class="login-form-panel">
      <form id="reset-form" class="login-card" novalidate>
        <div class="login-card-heading">
          <span class="eyebrow" data-i18n="recuperar.seccion">{es['recuperar.seccion']}</span>
          <h2 data-i18n="restablecer.titulo">{es['restablecer.titulo']}</h2>
          <p data-i18n="restablecer.ayuda">{es['restablecer.ayuda']}</p>
        </div>

        <div id="reset-missing" class="alert alert-error is-hidden" role="alert"
          data-i18n="restablecer.incompleto">{es['restablecer.incompleto']}</div>

        <fieldset id="reset-fields" class="plain-fieldset">
          <label class="field">
            <span data-i18n="restablecer.nueva">{es['restablecer.nueva']}</span>
            <input id="reset-password" type="password" autocomplete="new-password" maxlength="72" required />
          </label>
          <ul id="reset-rules" class="password-rules"></ul>
          <label class="field">
            <span data-i18n="restablecer.repetir">{es['restablecer.repetir']}</span>
            <input id="reset-confirm" type="password" autocomplete="new-password" maxlength="72" required />
          </label>
        </fieldset>

        <div id="reset-error" class="alert alert-error is-hidden" role="alert"></div>
        <div id="reset-done" class="alert alert-success is-hidden" role="status"
          data-i18n="restablecer.listo">{es['restablecer.listo']}</div>

        <button id="reset-submit" class="button button-primary button-full" type="submit"
          data-i18n="restablecer.guardar">{es['restablecer.guardar']}</button>
        <a id="reset-login" class="login-link login-link-center" href="/login"
          data-i18n="restablecer.irLogin">{es['restablecer.irLogin']}</a>
        <a class="login-link login-link-center" href="/recover"
          data-i18n="restablecer.otroEnlace">{es['restablecer.otroEnlace']}</a>
      </form>
    </section>
  </main>

  <script>
    import { MANAGEMENT_API_URL, readApiError } from '../lib/api';
    import { idiomaActual, t } from '../lib/i18n';
    import { PASSWORD_RULES, updatePasswordRules } from '../lib/password';

    const token = new URLSearchParams(window.location.search).get('token') ?? '';
    // El token no queda en la barra de direcciones ni en el historial.
    window.history.replaceState({}, '', '/reset-password');

    const form = document.querySelector<HTMLFormElement>('#reset-form');
    const fields = document.querySelector<HTMLFieldSetElement>('#reset-fields');
    const submit = document.querySelector<HTMLButtonElement>('#reset-submit');
    const errorBox = document.querySelector<HTMLElement>('#reset-error');
    const password = document.querySelector<HTMLInputElement>('#reset-password')!;
    const confirm = document.querySelector<HTMLInputElement>('#reset-confirm')!;
    const rules = document.querySelector<HTMLElement>('#reset-rules');

    // Esta pantalla no conoce el nombre de usuario: esa regla solo la controla el servidor, que avisa si no se cumple.
    if (rules) {
      rules.innerHTML = PASSWORD_RULES.filter((rule) => rule.id !== 'username')
        .map((rule) => `<li data-rule="${rule.id}">${rule.text}</li>`).join('');
    }
    const syncRules = () => updatePasswordRules(rules, password.value, '');
    password.addEventListener('input', syncRules);

    const fail = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove('is-hidden');
    };

    if (!token) {
      document.querySelector('#reset-missing')?.classList.remove('is-hidden');
      if (fields) fields.disabled = true;
      submit?.classList.add('is-hidden');
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('is-hidden');
      if (!syncRules()) return fail(t('restablecer.politica'));
      if (password.value !== confirm.value) return fail(t('restablecer.distintas'));
      if (submit) submit.disabled = true;
      try {
        const response = await fetch(`${MANAGEMENT_API_URL}/api/auth/password-reset`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept-Language': idiomaActual() },
          body: JSON.stringify({ token, password: password.value }),
        });
        if (!response.ok) throw new Error(await readApiError(response));
        form.reset();
        if (fields) fields.disabled = true;
        submit?.classList.add('is-hidden');
        document.querySelector('#reset-done')?.classList.remove('is-hidden');
      } catch (error) {
        fail(error instanceof Error ? error.message : t('restablecer.error'));
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</PublicLayout>
