---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['hallazgos.titulo']} section={es['hallazgos.seccion']} description={es['hallazgos.descripcion']}
  i18n="hallazgos"
>
  <div id="finding-error" class="alert alert-error is-hidden" role="alert"></div>
  <div id="finding-success" class="alert alert-success is-hidden" role="status"></div>

  <form id="finding-filters" class="panel compact-panel log-filters" novalidate>
    <div class="log-filter-grid">
      <label class="log-filter">
        <span data-i18n="general.estado">{es['general.estado']}</span>
        <select name="estado" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          <option value="PENDIENTES" data-i18n="hallazgos.pendientesAbiertoRevision">{es['hallazgos.pendientesAbiertoRevision']}</option>
          <option value="VENCIDOS" data-i18n="hallazgos.vencidosSuperaronPlazo">{es['hallazgos.vencidosSuperaronPlazo']}</option>
          <option value="ABIERTO" data-i18n="hallazgoTexto.ABIERTO">{es['hallazgoTexto.ABIERTO']}</option>
          <option value="EN_REVISION" data-i18n="hallazgoTexto.EN_REVISION">{es['hallazgoTexto.EN_REVISION']}</option>
          <option value="RESUELTO" data-i18n="hallazgoTexto.RESUELTO">{es['hallazgoTexto.RESUELTO']}</option>
          <option value="ACEPTADO" data-i18n="hallazgoTexto.ACEPTADO">{es['hallazgoTexto.ACEPTADO']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.severidad">{es['general.severidad']}</span>
        <select name="severidad" class="technical-select">
          <option value="" data-i18n="general.todas">{es['general.todas']}</option>
          <option value="CRITICA" data-i18n="historial.critica">{es['historial.critica']}</option>
          <option value="ALTA" data-i18n="historial.alta">{es['historial.alta']}</option>
          <option value="MEDIA" data-i18n="historial.media">{es['historial.media']}</option>
          <option value="BAJA" data-i18n="historial.baja">{es['historial.baja']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.dispositivo">{es['general.dispositivo']}</span>
        <select name="dispositivoId" class="technical-select"><option value="" data-i18n="general.todos">{es['general.todos']}</option></select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.baseline">{es['general.baseline']}</span>
        <select name="baselineId" class="technical-select"><option value="" data-i18n="general.todas">{es['general.todas']}</option></select>
      </label>
      <label class="log-filter">
        <span data-i18n="hallazgos.detectadoDesde">{es['hallazgos.detectadoDesde']}</span>
        <input name="desde" class="technical-input" type="datetime-local" />
      </label>
      <label class="log-filter">
        <span data-i18n="general.hasta">{es['general.hasta']}</span>
        <input name="hasta" class="technical-input" type="datetime-local" data-time="end" />
      </label>
    </div>
    <div class="log-filter-actions">
      <div class="terminal-search">
        <span>&gt;</span>
        <input id="finding-search" type="search" autocomplete="off" placeholder={es['hallazgos.buscarReglaDispositivoEvidencia']} data-i18n-placeholder="hallazgos.buscarReglaDispositivoEvidencia" />
      </div>
      <button type="button" id="finding-clear" class="button button-ghost button-small" data-i18n="general.limpiar">{es['general.limpiar']}</button>
      <button type="submit" class="button button-primary button-small" data-i18n="general.consultar">{es['general.consultar']}</button>
    </div>
  </form>

  <section class="finding-summary-grid">
    <article class="metric-card">
      <span class="metric-label" data-i18n="hallazgos.pendientesTitulo">{es['hallazgos.pendientesTitulo']}</span>
      <strong id="metric-pending">0</strong>
      <small id="metric-pending-note" data-i18n="hallazgos.abiertosRevision">{es['hallazgos.abiertosRevision']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="tablero.criticosAltos">{es['tablero.criticosAltos']}</span>
      <strong id="metric-critical">0</strong>
      <small data-i18n="hallazgos.requierenMaximaPrioridad">{es['hallazgos.requierenMaximaPrioridad']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="hallazgoTexto.EN_REVISION">{es['hallazgoTexto.EN_REVISION']}</span>
      <strong id="metric-review">0</strong>
      <small data-i18n="hallazgos.alguienTrabajando">{es['hallazgos.alguienTrabajando']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="hallazgos.cerradosTitulo">{es['hallazgos.cerradosTitulo']}</span>
      <strong id="metric-closed">0</strong>
      <small data-i18n="hallazgos.resueltosRiesgoAceptado">{es['hallazgos.resueltosRiesgoAceptado']}</small>
    </article>
  </section>

  <section class="finding-workspace log-workspace">
    <article class="panel finding-list-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="hallazgos.evidenciaAuditoria">{es['hallazgos.evidenciaAuditoria']}</span>
          <h2 data-i18n="hallazgos.hallazgosPriorizados">{es['hallazgos.hallazgosPriorizados']}</h2>
        </div>
        <div class="log-heading-meta">
          <span id="finding-count" class="counter-chip">—</span>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead>
            <tr>
              <th data-i18n="hallazgos.colHallazgo">{es['hallazgos.colHallazgo']}</th>
              <th data-i18n="general.colRegla">{es['general.colRegla']}</th>
              <th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th>
              <th data-i18n="general.colSeveridad">{es['general.colSeveridad']}</th>
              <th data-i18n="general.colEstado">{es['general.colEstado']}</th>
              <th data-i18n="hallazgos.colDetectado">{es['hallazgos.colDetectado']}</th>
            </tr>
          </thead>
          <tbody id="finding-table-body"></tbody>
        </table>
        <div id="finding-empty" class="empty-state compact-empty is-hidden">
          <div>
            <code data-i18n="hallazgos.ceroHallazgos">{es['hallazgos.ceroHallazgos']}</code>
            <p id="finding-empty-text" data-i18n="hallazgos.hayHallazgosFiltrosActuales">{es['hallazgos.hayHallazgosFiltrosActuales']}</p>
          </div>
        </div>
      </div>
      <nav id="finding-pager" class="pager is-hidden" aria-label={es['hallazgos.paginasHallazgos']} data-i18n-aria-label="hallazgos.paginasHallazgos"></nav>
    </article>

    <aside class="panel finding-inspector" aria-live="polite">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="hallazgos.hallazgoSeleccionado">{es['hallazgos.hallazgoSeleccionado']}</span>
          <h2 data-i18n="hallazgos.detalleSeguimiento">{es['hallazgos.detalleSeguimiento']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="finding-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="hallazgos.seleccionaHallazgoRevisarEvidencia">{es['hallazgos.seleccionaHallazgoRevisarEvidencia']}</p>
      </div>

      <div id="finding-inspector-content" class="inspector-content is-hidden"></div>
    </aside>
  </section>

  <script>
    import { auditFetch, hasRole } from '../lib/auth';
    import {
      FINDING_TRANSITIONS,
      findingStatusNeedsComment,
      jsonRequest,
      readApiError,
      type AuditFinding,
      type ConfigurationBaseline,
      type FindingStatus,
      type FindingTracking,
      type NetworkDevice,
    } from '../lib/api';
    import {
      code,
      escapeHtml,
      findingStatusBadge,
      findingStatusLabel,
      formatDate,
      localToIso,
      plural,
      severityClass,
      severityCode,
    } from '../lib/format';
    import { etiqueta, t } from '../lib/i18n';
    import { crearPaginador } from '../lib/paginador';

    let findings: AuditFinding[] = [];
    let devices: NetworkDevice[] = [];
    let baselines: ConfigurationBaseline[] = [];
    let selectedId: number | null = null;
    // Filtro por auditoría cuando se llega desde el historial (/results?auditoria=ID).
    const urlParams = new URLSearchParams(window.location.search);
    let auditFilter = Number(urlParams.get('auditoria')) || null;
    // Desde alertas, el tablero o la vista del cliente: ?hallazgo=ID abre ese hallazgo; ?estado=, ?severidad= y
    // ?dispositivo= precargan los filtros.
    const initialFinding = Number(urlParams.get('hallazgo')) || null;
    // Evita que una respuesta lenta pise a una más nueva (filtros o selección cambiados rápido).
    let loadSeq = 0;

    const canTrack = hasRole('ADMINISTRADOR_SISTEMA') || hasRole('ANALISTA_RED') || hasRole('AUDITOR_TECNICO');

    const form = document.querySelector<HTMLFormElement>('#finding-filters');
    // Se pagina en el navegador porque las métricas y la búsqueda rápida usan todos los hallazgos filtrados.
    const paginador = crearPaginador(document.querySelector<HTMLElement>('#finding-pager'), { alCambiar: () => render() });
    const search = document.querySelector<HTMLInputElement>('#finding-search');

    const deviceById = (id: number) => devices.find((item) => item.id === id);
    const baselineById = (id: number) => baselines.find((item) => item.id === id);

    const show = (selector: string, message: string | null) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (!node) return;
      node.textContent = message ?? '';
      node.classList.toggle('is-hidden', !message);
    };
    const showError = (message: string | null) => show('#finding-error', message);
    const showSuccess = (message: string) => {
      show('#finding-success', message);
      window.setTimeout(() => show('#finding-success', null), 4200);
    };

    const buildQuery = () => {
      const params = new URLSearchParams();
      if (form) {
        const data = new FormData(form);
        for (const name of ['estado', 'severidad', 'dispositivoId', 'baselineId']) {
          const value = String(data.get(name) ?? '');
          if (value) params.set(name, value);
        }
        const desde = localToIso(String(data.get('desde') ?? ''));
        const hasta = localToIso(String(data.get('hasta') ?? ''), true);
        if (desde) params.set('desde', desde);
        if (hasta) params.set('hasta', hasta);
        if (desde && hasta && desde > hasta) throw new Error(t('bitacoras.rangoInvalido'));
      }
      if (auditFilter) params.set('auditoriaId', String(auditFilter));
      const query = params.toString();
      return query ? `?${query}` : '';
    };

    const renderMetrics = () => {
      const set = (selector: string, value: number) => {
        const node = document.querySelector<HTMLElement>(selector);
        if (node) node.textContent = String(value);
      };
      const pending = findings.filter((f) => f.estado === 'ABIERTO' || f.estado === 'EN_REVISION');
      set('#metric-pending', pending.length);
      const overdue = pending.filter(isOverdue).length;
      const note = document.querySelector('#metric-pending-note');
      if (note) note.textContent = overdue ? t('hallazgos.abiertosVencidos', { n: overdue }) : t('hallazgos.abiertosRevision');
      set('#metric-critical', pending.filter((f) => f.severidad === 'CRITICA' || f.severidad === 'ALTA').length);
      set('#metric-review', findings.filter((f) => f.estado === 'EN_REVISION').length);
      set('#metric-closed', findings.filter((f) => f.estado === 'RESUELTO' || f.estado === 'ACEPTADO').length);
    };

    const searchTerm = () => search?.value.trim().toLowerCase() ?? '';
    const visibleFindings = () => {
      const term = searchTerm();
      return findings.filter((finding) => {
        if (!term) return true;
        const device = deviceById(finding.dispositivoId);
        const baseline = baselineById(finding.baselineId);
        return [finding.codigoRegla, finding.nombreRegla, finding.evidencia, device?.identificador, device?.nombre, baseline?.nombre]
          .join(' ').toLowerCase().includes(term);
      });
    };

    // Plazo de corrección: lo calcula el servidor con la política de la organización.
    const isOverdue = (finding: AuditFinding) => Boolean(finding.venceEn) && Date.parse(finding.venceEn!) < Date.now();
    const overdueBadge = (finding: AuditFinding) =>
      isOverdue(finding) ? `<span class="status-badge status-locked">${t('hallazgos.vencido')}</span>` : '';
    const dueText = (venceEn: string) => {
      const days = Math.round((Date.parse(venceEn) - Date.now()) / 86_400_000);
      if (days < 0) return `${formatDate(venceEn)} · ${plural(-days, 'hallazgos.vencidoHace')}`;
      return `${formatDate(venceEn)} · ${days === 0 ? t('hallazgos.venceHoy') : plural(days, 'hallazgos.faltan')}`;
    };

    const render = () => {
      const body = document.querySelector<HTMLTableSectionElement>('#finding-table-body');
      if (!body) return;
      const term = searchTerm();
      const visible = visibleFindings();

      body.innerHTML = paginador.recortar(visible).map((finding) => {
        const device = deviceById(finding.dispositivoId);
        const classes = ['finding-row'];
        if (finding.id === selectedId) classes.push('is-selected');
        if (finding.severidad === 'CRITICA' && (finding.estado === 'ABIERTO' || finding.estado === 'EN_REVISION')) {
          classes.push('is-critical');
        }
        if (finding.estado === 'RESUELTO' || finding.estado === 'ACEPTADO') classes.push('is-closed');
        return `
          <tr class="${classes.join(' ')}" data-finding-id="${finding.id}" tabindex="0">
            <td><code>${code('FND', finding.id)}</code></td>
            <td><strong>${escapeHtml(finding.codigoRegla)}</strong><small>${escapeHtml(finding.nombreRegla)}</small></td>
            <td>
              <strong>${escapeHtml(device?.identificador ?? `#${finding.dispositivoId}`)}</strong>
              <small>${escapeHtml(t('hallazgos.criticidad', { criticidad: severityCode(finding.criticidadDispositivo) }))}</small>
            </td>
            <td><span class="severity-badge ${severityClass(finding.severidad)}">${escapeHtml(severityCode(finding.severidad))}</span></td>
            <td><span class="badge-row">${findingStatusBadge(finding.estado)}${overdueBadge(finding)}</span></td>
            <td><span class="log-nowrap">${escapeHtml(formatDate(finding.fechaDeteccion))}</span></td>
          </tr>`;
      }).join('');

      const count = document.querySelector<HTMLElement>('#finding-count');
      if (count) count.textContent = term ? `${visible.length}/${findings.length}` : String(findings.length);
      const emptyText = document.querySelector<HTMLElement>('#finding-empty-text');
      if (emptyText) {
        emptyText.textContent = findings.length === 0 && !term
          ? t('hallazgos.sinDesvios')
          : t('hallazgos.sinCoincidencias');
      }
      document.querySelector('#finding-empty')?.classList.toggle('is-hidden', visible.length > 0);

      body.querySelectorAll<HTMLElement>('[data-finding-id]').forEach((row) => {
        const select = () => void selectFinding(Number(row.dataset.findingId));
        row.addEventListener('click', select);
        row.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            select();
          }
        });
      });
    };

    const trackingHtml = (history: FindingTracking[]) => history.length === 0
      ? `<p class="log-muted">${escapeHtml(t('hallazgos.sinCambiosEstado'))}</p>`
      : `<ol class="tracking-list">${history.map((item) => `
          <li>
            <div><code>${escapeHtml(etiqueta('hallazgo', item.estadoAnterior))} → ${escapeHtml(etiqueta('hallazgo', item.estadoNuevo))}</code>
            <small>${escapeHtml(item.usuario)} · ${escapeHtml(formatDate(item.fecha))}</small></div>
            ${item.comentario ? `<p>${escapeHtml(item.comentario)}</p>` : ''}
          </li>`).join('')}</ol>`;

    const trackingFormHtml = (finding: AuditFinding) => {
      if (!canTrack) {
        return `<p class="log-muted">${escapeHtml(t('hallazgos.soloConsulta'))}</p>`;
      }
      const options = FINDING_TRANSITIONS[finding.estado]
        .map((status) => `<option value="${status}">${escapeHtml(etiqueta('hallazgo', status))} · ${escapeHtml(findingStatusLabel(status))}</option>`)
        .join('');
      return `
        <form id="tracking-form" class="tracking-form" novalidate>
          <label class="log-filter">
            <span>${t('hallazgos.nuevoEstado')}</span>
            <select id="tracking-status" class="technical-select">${options}</select>
          </label>
          <label class="log-filter">
            <span id="tracking-comment-label">${t('plan.comentario')}</span>
            <textarea id="tracking-comment" class="technical-input tracking-comment" rows="3" maxlength="1000"
              placeholder="${t('hallazgos.comentarioEjemplo')}"></textarea>
          </label>
          <div id="tracking-error" class="alert alert-error is-hidden"></div>
          <button class="button button-primary button-small button-full" type="submit">${t('hallazgos.actualizarEstado')}</button>
        </form>`;
    };

    const selectFinding = async (id: number) => {
      selectedId = id;
      render();

      const [findingResponse, historyResponse] = await Promise.all([
        auditFetch(`/api/findings/${id}`),
        auditFetch(`/api/findings/${id}/history`),
      ]);
      if (id !== selectedId) return; // el usuario ya eligió otro hallazgo
      if (!findingResponse.ok) return showError(await readApiError(findingResponse));
      if (!historyResponse.ok) return showError(await readApiError(historyResponse));

      const finding = await findingResponse.json() as AuditFinding;
      const history = await historyResponse.json() as FindingTracking[];
      if (id !== selectedId) return;
      const device = deviceById(finding.dispositivoId);
      const baseline = baselineById(finding.baselineId);
      document.querySelector('#finding-inspector-empty')?.classList.add('is-hidden');

      const content = document.querySelector<HTMLElement>('#finding-inspector-content');
      if (!content) return;
      content.innerHTML = `
        <div class="inspector-identity">
          <span class="inspector-code">${code('FND', finding.id)}</span>
          <h3>${escapeHtml(finding.nombreRegla)}</h3>
          <div class="badge-row">
            <span class="severity-badge ${severityClass(finding.severidad)}">${escapeHtml(severityCode(finding.severidad))}</span>
            ${findingStatusBadge(finding.estado)}
            ${overdueBadge(finding)}
          </div>
        </div>

        <dl class="technical-definition-list">
          <div><dt>${t('hallazgos.regla')}</dt><dd>${escapeHtml(finding.codigoRegla)}</dd></div>
          <div><dt>${t('reglas.condicionDetalle')}</dt><dd>${escapeHtml(etiqueta('condicion', finding.tipoRegla))}</dd></div>
          <div><dt>${t('general.dispositivo')}</dt><dd>${escapeHtml(device?.identificador ?? `#${finding.dispositivoId}`)} · ${escapeHtml(t('hallazgos.criticidad', { criticidad: severityCode(finding.criticidadDispositivo) }))}</dd></div>
          <div><dt>${t('general.baseline')}</dt><dd>${escapeHtml(baseline ? `${baseline.nombre} v${baseline.version}` : `#${finding.baselineId}`)}</dd></div>
          <div><dt>${t('hallazgos.auditoria')}</dt><dd><a class="inline-link" href="/history?auditoria=${finding.auditoriaId}">${code('AUD', finding.auditoriaId)} →</a></dd></div>
          <div><dt>${t('hallazgos.detectado')}</dt><dd>${escapeHtml(formatDate(finding.fechaDeteccion))}</dd></div>
          ${finding.venceEn ? `<div><dt>${t('hallazgos.plazo')}</dt><dd>${escapeHtml(dueText(finding.venceEn))}</dd></div>` : ''}
          <div><dt>${t('hallazgos.ultimoCambio')}</dt><dd>${finding.fechaEstado
            ? `${escapeHtml(formatDate(finding.fechaEstado))} · ${escapeHtml(finding.usuarioEstado)}`
            : escapeHtml(t('hallazgos.sinCambios'))}</dd></div>
        </dl>

        <div class="rule-expression-block">
          <span>${t('hallazgos.patronBuscado')}</span>
          <code>${escapeHtml(finding.patron)}</code>
        </div>

        <div class="finding-evidence-block">
          <span>${t('hallazgos.evidencia')}</span>
          <p>${escapeHtml(finding.evidencia)}</p>
        </div>

        ${finding.impacto ? `
        <div class="finding-evidence-block">
          <span>${t('reglas.impacto')}</span>
          <p>${escapeHtml(finding.impacto)}</p>
        </div>` : ''}

        <div class="rule-recommendation">
          <span>${t('reglas.recomendacion')}</span>
          <p>${escapeHtml(finding.recomendacion)}</p>
        </div>

        <div class="baseline-versions">
          <span>${t('hallazgos.seguimiento')}</span>
          ${trackingHtml(history)}
        </div>

        ${trackingFormHtml(finding)}
      `;
      content.classList.remove('is-hidden');
      wireTrackingForm(finding);
    };

    const wireTrackingForm = (finding: AuditFinding) => {
      const trackingForm = document.querySelector<HTMLFormElement>('#tracking-form');
      const status = document.querySelector<HTMLSelectElement>('#tracking-status');
      const comment = document.querySelector<HTMLTextAreaElement>('#tracking-comment');
      if (!trackingForm || !status || !comment) return;

      const syncLabel = () => {
        const needs = findingStatusNeedsComment(status.value as FindingStatus);
        const label = document.querySelector('#tracking-comment-label');
        if (label) label.textContent = t(needs ? 'hallazgos.comentarioObligatorio' : 'hallazgos.comentarioOpcional');
        comment.required = needs;
      };
      status.addEventListener('change', syncLabel);
      syncLabel();

      trackingForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        show('#tracking-error', null);
        const nuevoEstado = status.value as FindingStatus;
        if (findingStatusNeedsComment(nuevoEstado) && !comment.value.trim()) {
          show('#tracking-error', t('hallazgos.faltaComentario', { estado: etiqueta('hallazgo', nuevoEstado) }));
          return;
        }
        const response = await auditFetch(`/api/findings/${finding.id}/status`, jsonRequest('PATCH', {
          estado: nuevoEstado,
          comentario: comment.value.trim() || null,
        }));
        if (!response.ok) {
          show('#tracking-error', await readApiError(response));
          return;
        }
        const updated = await response.json() as AuditFinding;
        findings = findings.map((item) => item.id === updated.id ? updated : item);
        showSuccess(t('hallazgos.ahoraEsta', { codigo: code('FND', updated.id), estado: etiqueta('hallazgo', updated.estado) }));
        renderMetrics();
        await selectFinding(updated.id);
      });
    };

    const loadFindings = async () => {
      showError(null);
      let query: string;
      try {
        query = buildQuery();
      } catch (error) {
        showError(error instanceof Error ? error.message : t('bitacoras.filtrosInvalidos'));
        return;
      }
      const seq = ++loadSeq;
      const response = await auditFetch(`/api/findings${query}`);
      if (seq !== loadSeq) return;
      if (!response.ok) {
        showError(await readApiError(response));
        return;
      }
      const data = await response.json() as AuditFinding[];
      if (seq !== loadSeq) return;
      findings = data;
      paginador.reiniciar();
      renderMetrics();
      render();
    };

    const loadReferences = async () => {
      const [deviceResponse, baselineResponse] = await Promise.all([
        auditFetch('/api/devices'),
        auditFetch('/api/baselines'),
      ]);
      for (const response of [deviceResponse, baselineResponse]) {
        if (!response.ok) throw new Error(await readApiError(response));
      }
      devices = await deviceResponse.json() as NetworkDevice[];
      baselines = await baselineResponse.json() as ConfigurationBaseline[];

      const deviceSelect = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
      devices.forEach((device) => deviceSelect?.add(new Option(`${device.identificador} · ${device.nombre}`, String(device.id))));
      const baselineSelect = form?.querySelector<HTMLSelectElement>('[name=baselineId]');
      baselines.forEach((baseline) => baselineSelect?.add(new Option(`${baseline.nombre} v${baseline.version}`, String(baseline.id))));

      const preset: Record<string, string | null> = {
        estado: urlParams.get('estado'),
        severidad: urlParams.get('severidad'),
        dispositivoId: urlParams.get('dispositivo'),
      };
      for (const [name, value] of Object.entries(preset)) {
        const field = form?.querySelector<HTMLSelectElement>(`[name=${name}]`);
        if (field && value && Array.from(field.options).some((option) => option.value === value)) field.value = value;
      }
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      void loadFindings();
    });
    document.querySelector('#finding-clear')?.addEventListener('click', () => {
      form?.reset();
      if (search) search.value = '';
      // "Limpiar" también quita el filtro por auditoría que venía en la URL (?auditoria=ID).
      auditFilter = null;
      window.history.replaceState(null, '', window.location.pathname);
      void loadFindings();
    });
    search?.addEventListener('input', () => {
      paginador.reiniciar();
      render();
    });

    loadReferences()
      .then(loadFindings)
      .then(() => {
        if (auditFilter) showSuccess(t('hallazgos.mostrandoAuditoria', { auditoria: code('AUD', auditFilter) }));
        if (initialFinding) {
          // Si el hallazgo pedido está en otra página, se muestra esa página.
          paginador.irAPosicion(visibleFindings().findIndex((finding) => finding.id === initialFinding));
          void selectFinding(initialFinding);
        }
      })
      .catch((error) => showError(error instanceof Error ? error.message : t('hallazgos.errorCargar')));
  </script>
</MasterLayout>
