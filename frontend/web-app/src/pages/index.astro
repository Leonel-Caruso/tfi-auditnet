---
import HeadMeta from '../components/HeadMeta.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <HeadMeta title="AuditNet" description="Plataforma de auditoría y control de configuraciones de red." />
  </head>
  <body class="redirect-page">
    <div class="spinner"></div>
    <p>Abriendo la consola…</p>
    <script>
      const hasToken = Boolean(sessionStorage.getItem('tfi.auth.token'));
      window.location.replace(hasToken ? '/dashboard' : '/login');
    </script>
  </body>
</html>
