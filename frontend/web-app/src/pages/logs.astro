---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
import { SYSTEM_EVENTS } from '../lib/api';
---

<MasterLayout
  title={es['bitacoras.titulo']} section={es['bitacoras.seccion']} description={es['bitacoras.descripcion']}
  i18n="bitacoras"
>
  <div id="log-error" class="alert alert-error is-hidden" role="alert"></div>

  <nav class="log-tabs" role="tablist" aria-label={es['bitacoras.bitacorasTitulo']} data-i18n-aria-label="bitacoras.bitacorasTitulo">
    <button type="button" class="log-tab" role="tab" id="tab-sistema" data-tab="sistema" aria-controls="log-panel" aria-selected="true">
      <code>SYS</code>
      <span data-i18n="bitacoras.auditoriaSistema">{es['bitacoras.auditoriaSistema']}</span>
      <small data-i18n="bitacoras.accesosSeguridadPostgresql">{es['bitacoras.accesosSeguridadPostgresql']}</small>
    </button>
    <button type="button" class="log-tab" role="tab" id="tab-transacciones" data-tab="transacciones" aria-controls="log-panel" aria-selected="false" tabindex="-1">
      <code>TRX</code>
      <span data-i18n="bitacoras.transacciones">{es['bitacoras.transacciones']}</span>
      <small data-i18n="bitacoras.operacionesNegocioPostgresql">{es['bitacoras.operacionesNegocioPostgresql']}</small>
    </button>
    <button type="button" class="log-tab" role="tab" id="tab-excepciones" data-tab="excepciones" aria-controls="log-panel" aria-selected="false" tabindex="-1">
      <code>EXC</code>
      <span data-i18n="bitacoras.excepciones">{es['bitacoras.excepciones']}</span>
      <small data-i18n="bitacoras.erroresInesperadosMongodb">{es['bitacoras.erroresInesperadosMongodb']}</small>
    </button>
  </nav>

  <form id="log-filters" class="panel compact-panel log-filters" novalidate>
    <div class="log-filter-grid">
      <label class="log-filter" data-tabs="sistema">
        <span data-i18n="bitacoras.evento">{es['bitacoras.evento']}</span>
        <select name="evento" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          {SYSTEM_EVENTS.map((event) => <option value={event}>{event}</option>)}
        </select>
      </label>
      <label class="log-filter" data-tabs="sistema">
        <span data-i18n="bitacoras.resultado">{es['bitacoras.resultado']}</span>
        <select name="resultado" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          <option value="EXITO">EXITO</option>
          <option value="FALLO">FALLO</option>
        </select>
      </label>
      <label class="log-filter" data-tabs="transacciones">
        <span data-i18n="bitacoras.entidad">{es['bitacoras.entidad']}</span>
        <select name="entidad" class="technical-select">
          <option value="" data-i18n="general.todas">{es['general.todas']}</option>
          <option value="ORGANIZACION">ORGANIZACION</option>
          <option value="SEDE" data-i18n="general.colSede">{es['general.colSede']}</option>
          <option value="PLAN">PLAN</option>
          <option value="SOLICITUD_PLAN">SOLICITUD_PLAN</option>
          <option value="CATALOGO_PLAN">CATALOGO_PLAN</option>
          <option value="TIPO_DISPOSITIVO">TIPO_DISPOSITIVO</option>
          <option value="DISPOSITIVO" data-i18n="general.colDispositivo">{es['general.colDispositivo']}</option>
          <option value="BASELINE" data-i18n="general.colBaseline">{es['general.colBaseline']}</option>
          <option value="REGLA" data-i18n="general.colRegla">{es['general.colRegla']}</option>
          <option value="CONFIGURACION">CONFIGURACION</option>
          <option value="AUDITORIA">AUDITORIA</option>
          <option value="HALLAZGO">HALLAZGO</option>
          <option value="ALERTA">ALERTA</option>
          <option value="REPORTE">REPORTE</option>
          <option value="RESPALDO">RESPALDO</option>
          <option value="ARCHIVO">ARCHIVO</option>
        </select>
      </label>
      <label class="log-filter" data-tabs="transacciones">
        <span data-i18n="bitacoras.idEntidad">{es['bitacoras.idEntidad']}</span>
        <input name="entidadId" class="technical-input" type="number" min="1" step="1" inputmode="numeric" placeholder={es['bitacoras.ej']} data-i18n-placeholder="bitacoras.ej" />
      </label>
      <label class="log-filter" data-tabs="transacciones">
        <span data-i18n="bitacoras.operacion">{es['bitacoras.operacion']}</span>
        <select name="operacion" class="technical-select">
          <option value="" data-i18n="general.todas">{es['general.todas']}</option>
          <option value="ALTA" data-i18n="severidad.ALTA">{es['severidad.ALTA']}</option>
          <option value="MODIFICACION">MODIFICACION</option>
          <option value="CAMBIO_ESTADO">CAMBIO_ESTADO</option>
          <option value="BAJA_LOGICA">BAJA_LOGICA</option>
          <option value="IMPORTACION">IMPORTACION</option>
          <option value="EJECUCION">EJECUCION</option>
          <option value="EXPORTACION">EXPORTACION</option>
        </select>
      </label>
      <label class="log-filter" data-tabs="sistema,transacciones">
        <span data-i18n="bitacoras.actor">{es['bitacoras.actor']}</span>
        <input name="actor" class="technical-input" type="text" maxlength="160" autocomplete="off" placeholder={es['bitacoras.usuario']} data-i18n-placeholder="bitacoras.usuario" />
      </label>
      <label class="log-filter" data-tabs="excepciones">
        <span data-i18n="bitacoras.servicio">{es['bitacoras.servicio']}</span>
        <select name="servicio" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          <option value="management-service">management-service</option>
          <option value="audit-core-service">audit-core-service</option>
        </select>
      </label>
      <label class="log-filter" data-tabs="excepciones">
        <span data-i18n="bitacoras.nivel">{es['bitacoras.nivel']}</span>
        <select name="nivel" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          <option value="ERROR">ERROR</option>
          <option value="WARN">WARN</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.desde">{es['general.desde']}</span>
        <input name="desde" class="technical-input" type="datetime-local" />
      </label>
      <label class="log-filter">
        <span data-i18n="general.hasta">{es['general.hasta']}</span>
        <input name="hasta" class="technical-input" type="datetime-local" data-time="end" />
      </label>
      <label class="log-filter">
        <span data-i18n="bitacoras.limite">{es['bitacoras.limite']}</span>
        <select name="limite" class="technical-select">
          <option value="50">50</option>
          <option value="100" selected>100</option>
          <option value="500">500</option>
        </select>
      </label>
    </div>

    <div class="log-filter-actions">
      <div class="terminal-search">
        <span>&gt;</span>
        <input id="log-search" type="search" autocomplete="off" placeholder={es['bitacoras.filtrarCargadoCodigoSeguimiento']} data-i18n-placeholder="bitacoras.filtrarCargadoCodigoSeguimiento" aria-label={es['bitacoras.filtrarRegistrosCargados']} data-i18n-aria-label="bitacoras.filtrarRegistrosCargados" />
      </div>
      <button type="button" id="log-clear" class="button button-ghost button-small" data-i18n="general.limpiar">{es['general.limpiar']}</button>
      <button type="submit" id="log-submit" class="button button-primary button-small" data-i18n="general.consultar">{es['general.consultar']}</button>
    </div>
  </form>

  <section class="finding-workspace log-workspace">
    <article id="log-panel" class="panel finding-list-panel" role="tabpanel" aria-labelledby="tab-sistema">
      <div class="panel-heading">
        <div>
          <span id="log-eyebrow" class="eyebrow" data-i18n="bitacoras.bitacoraSistema">{es['bitacoras.bitacoraSistema']}</span>
          <h2 id="log-title" data-i18n="bitacoras.auditoriaSistema">{es['bitacoras.auditoriaSistema']}</h2>
        </div>
        <div class="log-heading-meta">
          <span id="log-count" class="counter-chip">—</span>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead id="log-head"></thead>
          <tbody id="log-body"></tbody>
        </table>
        <div id="log-loading" class="log-loading is-hidden"><div class="skeleton-row"></div><div class="skeleton-row"></div></div>
        <div id="log-empty" class="empty-state compact-empty is-hidden">
          <div>
            <code data-i18n="bitacoras.ceroRegistros">{es['bitacoras.ceroRegistros']}</code>
            <p data-i18n="bitacoras.hayRegistrosFiltrosActuales">{es['bitacoras.hayRegistrosFiltrosActuales']}</p>
          </div>
        </div>
      </div>
      <nav id="log-pager" class="pager is-hidden" aria-label={es['bitacoras.paginasBitacora']} data-i18n-aria-label="bitacoras.paginasBitacora"></nav>
    </article>

    <aside class="panel finding-inspector" aria-live="polite">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="bitacoras.registroSeleccionado">{es['bitacoras.registroSeleccionado']}</span>
          <h2 data-i18n="bitacoras.detalleRegistro">{es['bitacoras.detalleRegistro']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="log-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="bitacoras.seleccionaRegistroVerTodos">{es['bitacoras.seleccionaRegistroVerTodos']}</p>
      </div>

      <div id="log-inspector-content" class="inspector-content is-hidden"></div>
    </aside>
  </section>

  <script src="../scripts/logs.ts"></script>
</MasterLayout>
