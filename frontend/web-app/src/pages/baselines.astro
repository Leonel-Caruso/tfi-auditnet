---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['baselines.titulo']} section={es['baselines.seccion']} description={es['baselines.descripcion']}
  i18n="baselines"
>
  <section id="baseline-message" class="alert is-hidden" role="status"></section>

  <section class="policy-toolbar panel compact-panel">
    <div class="device-toolbar-copy">
      <span class="eyebrow" data-i18n="baselines.baselinesTitulo">{es['baselines.baselinesTitulo']}</span>
      <div>
        <strong id="baseline-count" data-i18n="baselines.ceroBaselines">{es['baselines.ceroBaselines']}</strong>
        <span data-i18n="baselines.modelosConfiguracionEsperada">{es['baselines.modelosConfiguracionEsperada']}</span>
      </div>
    </div>

    <div class="device-toolbar-actions">
      <label class="terminal-search">
        <span>&gt;</span>
        <input id="baseline-search" type="search" placeholder={es['baselines.buscarBaselineOrganizacionTipo']} data-i18n-placeholder="baselines.buscarBaselineOrganizacionTipo" />
      </label>
      <select id="baseline-status-filter" class="technical-select" aria-label={es['general.filtrarEstado']} data-i18n-aria-label="general.filtrarEstado">
        <option value="" data-i18n="general.estadoTodos">{es['general.estadoTodos']}</option>
        <option value="ACTIVO" data-i18n="baselines.estadoActivo">{es['baselines.estadoActivo']}</option>
        <option value="INACTIVO" data-i18n="baselines.estadoInactivo">{es['baselines.estadoInactivo']}</option>
      </select>
      <button
        id="open-baseline-dialog"
        class="button button-primary device-create-action"
        type="button"
        data-roles="ADMINISTRADOR_SISTEMA,AUDITOR_TECNICO"
       data-i18n="baselines.nuevaBaseline">{es['baselines.nuevaBaseline']}</button>
    </div>
  </section>

  <section class="policy-workspace">
    <article class="panel policy-list-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="baselines.estadoEsperado">{es['baselines.estadoEsperado']}</span>
          <h2 data-i18n="baselines.modelosVersiones">{es['baselines.modelosVersiones']}</h2>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table policy-table">
          <thead>
            <tr>
              <th data-i18n="baselines.colBaseline">{es['baselines.colBaseline']}</th>
              <th data-i18n="baselines.colOrganizacion">{es['baselines.colOrganizacion']}</th>
              <th data-i18n="baselines.colTipo">{es['baselines.colTipo']}</th>
              <th data-i18n="baselines.colVersion">{es['baselines.colVersion']}</th>
              <th data-i18n="baselines.colReglas">{es['baselines.colReglas']}</th>
              <th data-i18n="baselines.colUso">{es['baselines.colUso']}</th>
              <th data-i18n="baselines.colEstado">{es['baselines.colEstado']}</th>
            </tr>
          </thead>
          <tbody id="baselines-body">
            <tr><td colspan="7"><div class="skeleton-row"></div></td></tr>
          </tbody>
        </table>
      </div>

      <div id="baselines-empty" class="empty-state compact-empty is-hidden">
        <div>
          <code data-i18n="baselines.ceroBaselines">{es['baselines.ceroBaselines']}</code>
          <p data-i18n="baselines.todaviaHayModelosBaseline">{es['baselines.todaviaHayModelosBaseline']}</p>
        </div>
      </div>
    </article>

    <aside class="panel policy-inspector" aria-label={es['baselines.detalleBaseline']} data-i18n-aria-label="baselines.detalleBaseline">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="baselines.baselineSeleccionada">{es['baselines.baselineSeleccionada']}</span>
          <h2 data-i18n="baselines.detalleModelo">{es['baselines.detalleModelo']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="baseline-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="baselines.seleccionaModeloConsultarAlcance">{es['baselines.seleccionaModeloConsultarAlcance']}</p>
      </div>

      <div id="baseline-inspector-content" class="inspector-content is-hidden">
        <div class="inspector-identity">
          <span id="baseline-inspector-code" class="inspector-code">BL-</span>
          <h3 id="baseline-inspector-name">—</h3>
          <span id="baseline-inspector-status" class="status-badge status-ready">—</span>
        </div>

        <p id="baseline-inspector-description" class="policy-description">—</p>

        <dl class="technical-definition-list">
          <div><dt data-i18n="general.organizacion">{es['general.organizacion']}</dt><dd id="baseline-inspector-organization">—</dd></div>
          <div><dt data-i18n="dispositivos.tipoDispositivo">{es['dispositivos.tipoDispositivo']}</dt><dd id="baseline-inspector-type">—</dd></div>
          <div><dt data-i18n="baselines.versionDetalle">{es['baselines.versionDetalle']}</dt><dd id="baseline-inspector-version">—</dd></div>
          <div><dt data-i18n="baselines.reglasDetalle">{es['baselines.reglasDetalle']}</dt><dd id="baseline-inspector-rules">—</dd></div>
          <div><dt data-i18n="baselines.auditorias">{es['baselines.auditorias']}</dt><dd id="baseline-inspector-audits">—</dd></div>
          <div><dt data-i18n="general.identificador">{es['general.identificador']}</dt><dd id="baseline-inspector-id">—</dd></div>
        </dl>

        <div class="inspector-footnote">
          <code id="baseline-inspector-policy" data-i18n="baselines.baselineReglas">{es['baselines.baselineReglas']}</code>
          <span id="baseline-inspector-policy-text" data-i18n="baselines.esteModeloSeraReferencia">{es['baselines.esteModeloSeraReferencia']}</span>
        </div>

        <div class="baseline-versions">
          <span data-i18n="baselines.versiones">{es['baselines.versiones']}</span>
          <div id="baseline-inspector-versions" class="baseline-version-list"></div>
        </div>

        <div class="inspector-actions" data-roles="ADMINISTRADOR_SISTEMA,AUDITOR_TECNICO">
          <button id="baseline-edit" class="button button-ghost button-small" type="button" data-i18n="general.editarDescripcion">{es['general.editarDescripcion']}</button>
          <button id="baseline-version" class="button button-primary button-small" type="button" data-i18n="baselines.nuevaVersion">{es['baselines.nuevaVersion']}</button>
          <button id="baseline-toggle" class="button button-ghost button-small" type="button" data-i18n="baselines.desactivar">{es['baselines.desactivar']}</button>
        </div>
      </div>
    </aside>
  </section>

  <dialog id="baseline-dialog" class="technical-dialog">
    <form id="baseline-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="baselines.nuevaBaselineTitulo">{es['baselines.nuevaBaselineTitulo']}</span>
          <h2 data-i18n="baselines.crearBaseline">{es['baselines.crearBaseline']}</h2>
          <p data-i18n="baselines.definiModeloConfiguracionEsperado">{es['baselines.definiModeloConfiguracionEsperado']}</p>
        </div>
        <button id="close-baseline-dialog" class="dialog-close" type="button" aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field">
          <span data-i18n="general.nombreObligatorio">{es['general.nombreObligatorio']}</span>
          <input id="baseline-name" type="text" maxlength="140" placeholder={es['baselines.hardeningCiscoIosXe']} data-i18n-placeholder="baselines.hardeningCiscoIosXe" required />
        </label>

        <label class="field">
          <span data-i18n="dispositivos.tipoDispositivoObligatorio">{es['dispositivos.tipoDispositivoObligatorio']}</span>
          <select id="baseline-device-type" class="form-select" required>
            <option value="" data-i18n="dispositivos.seleccionarTipo">{es['dispositivos.seleccionarTipo']}</option>
          </select>
        </label>

        <label class="field">
          <span data-i18n="general.organizacionObligatorio">{es['general.organizacionObligatorio']}</span>
          <select id="baseline-organization" class="form-select" required>
            <option value="" data-i18n="dispositivos.seleccionarOrganizacion">{es['dispositivos.seleccionarOrganizacion']}</option>
          </select>
        </label>

        <div class="device-form-context">
          <code data-i18n="baselines.versionInicial">{es['baselines.versionInicial']}</code>
          <span data-i18n="baselines.primeraVersionAsignaAutomaticamente">{es['baselines.primeraVersionAsignaAutomaticamente']}</span>
        </div>

        <label class="field field-span-2">
          <span data-i18n="general.descripcionObligatorio">{es['general.descripcionObligatorio']}</span>
          <textarea id="baseline-description" rows="4" maxlength="500" placeholder={es['baselines.controlesMinimosEsperadosRouters']} data-i18n-placeholder="baselines.controlesMinimosEsperadosRouters" required></textarea>
        </label>
      </div>

      <div id="baseline-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button id="cancel-baseline-dialog" class="button button-ghost" type="button" data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="baselines.crearBaseline">{es['baselines.crearBaseline']}</button>
      </div>
    </form>
  </dialog>

  <dialog id="baseline-change-dialog" class="technical-dialog">
    <form id="baseline-change-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span id="baseline-change-eyebrow" class="eyebrow" data-i18n="baselines.editarBaseline">{es['baselines.editarBaseline']}</span>
          <h2 id="baseline-change-title" data-i18n="general.editarDescripcion">{es['general.editarDescripcion']}</h2>
          <p id="baseline-change-subtitle">—</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field field-span-2">
          <span data-i18n="general.descripcionObligatorio">{es['general.descripcionObligatorio']}</span>
          <textarea id="baseline-change-description" rows="4" maxlength="500" required></textarea>
        </label>
        <div id="baseline-change-context" class="device-form-context field-span-2">
          <code id="baseline-change-code">—</code>
          <span id="baseline-change-text">—</span>
        </div>
      </div>

      <div id="baseline-change-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button id="baseline-change-submit" class="button button-primary" type="submit" data-i18n="general.guardar">{es['general.guardar']}</button>
      </div>
    </form>
  </dialog>

  <script src="../scripts/baselines.ts"></script>
</MasterLayout>
