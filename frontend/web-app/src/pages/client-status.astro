---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['cliente.titulo']} section={es['cliente.seccion']} description={es['cliente.descripcion']}
  i18n="cliente"
>
  <div id="client-error" class="alert alert-error is-hidden" role="alert"></div>

  <section class="panel compact-panel dashboard-scope">
    <div>
      <span class="eyebrow" data-i18n="cliente.organizacionCliente">{es['cliente.organizacionCliente']}</span>
      <h2 id="client-title" data-i18n="cliente.estadoGeneralAuditoria">{es['cliente.estadoGeneralAuditoria']}</h2>
    </div>
    <div class="dashboard-scope-actions">
      <label class="log-filter" id="client-org-filter" hidden>
        <span data-i18n="general.organizacion">{es['general.organizacion']}</span>
        <select id="client-org" class="technical-select"></select>
      </label>
    </div>
  </section>

  <div id="client-risk"></div>

  <section id="client-kpis" class="metric-grid dashboard-kpis" aria-live="polite"></section>

  <section class="panel dashboard-row">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="cliente.sedes">{es['cliente.sedes']}</span>
        <h2 data-i18n="cliente.riesgoSede">{es['cliente.riesgoSede']}</h2>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data-table log-table">
        <thead>
          <tr><th data-i18n="general.colSede">{es['general.colSede']}</th><th data-i18n="general.colRiesgo">{es['general.colRiesgo']}</th><th data-i18n="cliente.colDispositivos">{es['cliente.colDispositivos']}</th><th data-i18n="cliente.colAuditados">{es['cliente.colAuditados']}</th><th data-i18n="general.colPendientes">{es['general.colPendientes']}</th><th data-i18n="cliente.colCriticos">{es['cliente.colCriticos']}</th><th data-i18n="general.colAlertas">{es['general.colAlertas']}</th></tr>
        </thead>
        <tbody id="client-sites"></tbody>
      </table>
      <div id="client-sites-empty" class="empty-state compact-empty is-hidden">
        <div><code data-i18n="cliente.ceroDispositivos">{es['cliente.ceroDispositivos']}</code><p data-i18n="cliente.organizacionTodaviaTieneDispositivos">{es['cliente.organizacionTodaviaTieneDispositivos']}</p></div>
      </div>
    </div>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cliente.hallazgos">{es['cliente.hallazgos']}</span>
          <h2 data-i18n="cliente.hallazgosPendientesSeveridad">{es['cliente.hallazgosPendientesSeveridad']}</h2>
        </div>
      </div>
      <div id="client-severity"></div>
    </article>
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cliente.historico">{es['cliente.historico']}</span>
          <h2 data-i18n="cliente.auditoriasRecientes">{es['cliente.auditoriasRecientes']}</h2>
        </div>
      </div>
      <div id="client-recent"></div>
      <div class="panel-heading client-reports-heading">
        <div>
          <span class="eyebrow" data-i18n="cliente.evidencia">{es['cliente.evidencia']}</span>
          <h2 data-i18n="cliente.reportesDisponibles">{es['cliente.reportesDisponibles']}</h2>
        </div>
        <a class="inline-link" href="/reports" data-i18n="cliente.reportes">{es['cliente.reportes']}</a>
      </div>
      <div id="client-reports"></div>
    </article>
  </section>

  <section class="panel dashboard-row">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="cliente.dispositivosTitulo">{es['cliente.dispositivosTitulo']}</span>
        <h2 data-i18n="cliente.dispositivosNivelRiesgo">{es['cliente.dispositivosNivelRiesgo']}</h2>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data-table log-table">
        <thead>
          <tr><th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th><th data-i18n="general.colSede">{es['general.colSede']}</th><th data-i18n="cliente.colCriticidad">{es['cliente.colCriticidad']}</th><th data-i18n="general.colRiesgo">{es['general.colRiesgo']}</th><th data-i18n="general.colPendientes">{es['general.colPendientes']}</th><th data-i18n="general.colAlertas">{es['general.colAlertas']}</th><th data-i18n="cliente.colUltimaAuditoria">{es['cliente.colUltimaAuditoria']}</th></tr>
        </thead>
        <tbody id="client-devices"></tbody>
      </table>
    </div>
  </section>

  <script>
    import { auditFetch, authFetch, getStoredUser, hasRole } from '../lib/auth';
    import { readApiError, type ClientAuditStatus, type NetworkDevice, type Organization, type ReviewStatus, type Site, type SiteRisk } from '../lib/api';
    import { code, escapeHtml, formatDate, riskBadge } from '../lib/format';
    import { deviceRiskRowsHtml, kpiHtml, recentAuditsHtml, riskBannerHtml, severityChartHtml, wireTooltips } from '../lib/dashboard-view';
    import { t } from '../lib/i18n';

    const isAdmin = hasRole('ADMINISTRADOR_SISTEMA');
    const params = new URLSearchParams(window.location.search);
    let organizations: Organization[] = [];
    let devices: NetworkDevice[] = [];
    let sites: Site[] = [];
    let loadSeq = 0;

    const set = (selector: string, html: string) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (node) node.innerHTML = html;
    };
    const showError = (message: string | null) => {
      const node = document.querySelector<HTMLElement>('#client-error');
      if (!node) return;
      node.textContent = message ?? '';
      node.classList.toggle('is-hidden', !message);
    };

    const siteRowsHtml = (rows: SiteRisk[]) => rows.map((row) => {
      const name = row.sedeId == null
        ? t('cliente.sinSedeAsignada')
        : sites.find((site) => site.id === row.sedeId)?.nombre ?? t('tablero.sedeNumero', { id: row.sedeId });
      return `
        <tr class="${row.nivel === 'ALTO' ? 'is-critical' : ''}">
          <td><strong>${escapeHtml(name)}</strong></td>
          <td>${riskBadge(row.nivel)}</td>
          <td>${row.dispositivos}</td>
          <td>${row.auditados}/${row.dispositivos}</td>
          <td>${row.pendientes}</td>
          <td>${row.criticosPendientes}</td>
          <td>${row.alertasVigentes > 0 && row.sedeId != null
            ? `<a class="inline-link" href="/alerts?sede=${row.sedeId}">${row.alertasVigentes} →</a>`
            : row.alertasVigentes}</td>
        </tr>`;
    }).join('');

    const load = async (organizationId: number) => {
      showError(null);
      const seq = ++loadSeq;
      const [statusResponse, siteResponse, deviceResponse, reviewResponse] = await Promise.all([
        auditFetch(`/api/client-organizations/${organizationId}/audit-status`),
        authFetch(`/api/client-organizations/${organizationId}/sites`),
        auditFetch('/api/devices'),
        auditFetch(`/api/review/status?organizationId=${organizationId}`),
      ]);
      if (seq !== loadSeq) return;
      if (!statusResponse.ok) {
        showError(await readApiError(statusResponse));
        return;
      }
      const status = await statusResponse.json() as ClientAuditStatus;
      sites = siteResponse.ok ? await siteResponse.json() as Site[] : [];
      devices = deviceResponse.ok ? await deviceResponse.json() as NetworkDevice[] : [];
      const review = reviewResponse.ok ? await reviewResponse.json() as ReviewStatus : null;
      if (seq !== loadSeq) return;

      const organization = organizations.find((item) => item.id === organizationId);
      const title = document.querySelector('#client-title');
      if (title) title.textContent = organization ? organization.razonSocial : t('dispositivos.organizacionNumero', { id: organizationId });

      const summary = status.resumen;
      set('#client-risk', riskBannerHtml(summary, organization?.razonSocial ?? t('general.organizacion')));
      set('#client-kpis', kpiHtml(summary, review));
      set('#client-sites', siteRowsHtml(status.sedes));
      document.querySelector('#client-sites-empty')?.classList.toggle('is-hidden', status.sedes.length > 0);
      set('#client-severity', severityChartHtml(summary));
      set('#client-recent', recentAuditsHtml(summary.auditoriasRecientes,
        (id) => devices.find((device) => device.id === id)?.identificador ?? `#${id}`));
      set('#client-devices', deviceRiskRowsHtml(status.dispositivos, sites));
      set('#client-reports', status.reportes.length === 0
        ? `<p class="log-muted">${escapeHtml(t('cliente.sinReportes'))}</p>`
        : `<ul class="compare-list">${status.reportes.map((report) => `
            <li class="compare-item">
              <a class="inline-link" href="/reports?reporte=${report.id}"><code>${code('REP', report.id)}</code></a>
              <span>${escapeHtml(report.titulo)}</span>
              <small>${escapeHtml(formatDate(report.fechaGeneracion))}</small>
            </li>`).join('')}</ul>`);
      if (!siteResponse.ok) showError(t('cliente.errorSedes'));
      wireTooltips(document);
    };

    const start = async () => {
      if (isAdmin) {
        const response = await authFetch('/api/client-organizations');
        if (!response.ok) throw new Error(await readApiError(response));
        organizations = await response.json() as Organization[];
        if (organizations.length === 0) throw new Error(t('cliente.sinOrganizaciones'));
        const select = document.querySelector<HTMLSelectElement>('#client-org');
        organizations.forEach((organization) => select?.add(new Option(organization.razonSocial, String(organization.id))));
        const requested = Number(params.get('organizacion'));
        const initial = organizations.some((item) => item.id === requested) ? requested : organizations[0].id;
        if (select) {
          select.value = String(initial);
          select.addEventListener('change', () => {
            window.history.replaceState(null, '', `?organizacion=${select.value}`);
            void load(Number(select.value));
          });
        }
        document.querySelector('#client-org-filter')?.removeAttribute('hidden');
        await load(initial);
        return;
      }
      const own = getStoredUser()?.organizationId;
      if (!own) throw new Error(t('tablero.sinOrganizacion'));
      const response = await authFetch(`/api/client-organizations/${own}`);
      if (response.ok) organizations = [await response.json() as Organization];
      await load(own);
    };

    start().catch((error) => showError(error instanceof Error ? error.message : t('cliente.errorEstado')));
  </script>
</MasterLayout>
