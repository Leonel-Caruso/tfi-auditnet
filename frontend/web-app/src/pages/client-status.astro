---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['cliente.titulo']} section={es['cliente.seccion']} description={es['cliente.descripcion']}
  i18n="cliente"
>
  <div id="client-error" class="alert alert-error is-hidden" role="alert"></div>

  <section class="panel compact-panel dashboard-scope">
    <div>
      <span class="eyebrow" data-i18n="cliente.organizacionCliente">{es['cliente.organizacionCliente']}</span>
      <h2 id="client-title" data-i18n="cliente.estadoGeneralAuditoria">{es['cliente.estadoGeneralAuditoria']}</h2>
    </div>
    <div class="dashboard-scope-actions">
      <label class="log-filter" id="client-org-filter" hidden>
        <span data-i18n="general.organizacion">{es['general.organizacion']}</span>
        <select id="client-org" class="technical-select"></select>
      </label>
    </div>
  </section>

  <div id="client-risk"></div>

  <section id="client-kpis" class="metric-grid dashboard-kpis" aria-live="polite"></section>

  <section class="panel dashboard-row">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="cliente.sedes">{es['cliente.sedes']}</span>
        <h2 data-i18n="cliente.riesgoSede">{es['cliente.riesgoSede']}</h2>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data-table log-table">
        <thead>
          <tr><th data-i18n="general.colSede">{es['general.colSede']}</th><th data-i18n="general.colRiesgo">{es['general.colRiesgo']}</th><th data-i18n="cliente.colDispositivos">{es['cliente.colDispositivos']}</th><th data-i18n="cliente.colAuditados">{es['cliente.colAuditados']}</th><th data-i18n="general.colPendientes">{es['general.colPendientes']}</th><th data-i18n="cliente.colCriticos">{es['cliente.colCriticos']}</th><th data-i18n="general.colAlertas">{es['general.colAlertas']}</th></tr>
        </thead>
        <tbody id="client-sites"></tbody>
      </table>
      <div id="client-sites-empty" class="empty-state compact-empty is-hidden">
        <div><code data-i18n="cliente.ceroDispositivos">{es['cliente.ceroDispositivos']}</code><p data-i18n="cliente.organizacionTodaviaTieneDispositivos">{es['cliente.organizacionTodaviaTieneDispositivos']}</p></div>
      </div>
    </div>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cliente.hallazgos">{es['cliente.hallazgos']}</span>
          <h2 data-i18n="cliente.hallazgosPendientesSeveridad">{es['cliente.hallazgosPendientesSeveridad']}</h2>
        </div>
      </div>
      <div id="client-severity"></div>
    </article>
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cliente.historico">{es['cliente.historico']}</span>
          <h2 data-i18n="cliente.auditoriasRecientes">{es['cliente.auditoriasRecientes']}</h2>
        </div>
      </div>
      <div id="client-recent"></div>
      <div class="panel-heading client-reports-heading">
        <div>
          <span class="eyebrow" data-i18n="cliente.evidencia">{es['cliente.evidencia']}</span>
          <h2 data-i18n="cliente.reportesDisponibles">{es['cliente.reportesDisponibles']}</h2>
        </div>
        <a class="inline-link" href="/reports" data-i18n="cliente.reportes">{es['cliente.reportes']}</a>
      </div>
      <div id="client-reports"></div>
    </article>
  </section>

  <section class="panel dashboard-row">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="cliente.dispositivosTitulo">{es['cliente.dispositivosTitulo']}</span>
        <h2 data-i18n="cliente.dispositivosNivelRiesgo">{es['cliente.dispositivosNivelRiesgo']}</h2>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data-table log-table">
        <thead>
          <tr><th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th><th data-i18n="general.colSede">{es['general.colSede']}</th><th data-i18n="cliente.colCriticidad">{es['cliente.colCriticidad']}</th><th data-i18n="general.colRiesgo">{es['general.colRiesgo']}</th><th data-i18n="general.colPendientes">{es['general.colPendientes']}</th><th data-i18n="general.colAlertas">{es['general.colAlertas']}</th><th data-i18n="cliente.colUltimaAuditoria">{es['cliente.colUltimaAuditoria']}</th></tr>
        </thead>
        <tbody id="client-devices"></tbody>
      </table>
    </div>
  </section>

  <script src="../scripts/client-status.ts"></script>
</MasterLayout>
