---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['reportes.titulo']} section={es['reportes.seccion']} description={es['reportes.descripcion']}
  i18n="reportes"
>
  <div id="report-error" class="alert alert-error is-hidden report-no-print" role="alert"></div>
  <div id="report-success" class="alert alert-success is-hidden report-no-print" role="status"></div>

  <section class="report-workspace report-no-print">
    <form id="report-form" class="panel compact-panel" novalidate>
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="reportes.nuevoReporte">{es['reportes.nuevoReporte']}</span>
          <h2 data-i18n="reportes.criterios">{es['reportes.criterios']}</h2>
        </div>
      </div>
      <p id="report-readonly" class="log-muted is-hidden" data-i18n="reportes.perfilPuedeConsultarDescargar">{es['reportes.perfilPuedeConsultarDescargar']}</p>
      <div class="log-filter-grid report-criteria">
        <label class="log-filter">
          <span data-i18n="general.desde">{es['general.desde']}</span>
          <input name="desde" class="technical-input" type="date" />
        </label>
        <label class="log-filter">
          <span data-i18n="general.hasta">{es['general.hasta']}</span>
          <input name="hasta" class="technical-input" type="date" />
        </label>
        <label class="log-filter" id="report-org-filter" hidden>
          <span data-i18n="general.organizacion">{es['general.organizacion']}</span>
          <select name="organizacionId" class="technical-select"><option value="" data-i18n="general.todas">{es['general.todas']}</option></select>
        </label>
        <label class="log-filter">
          <span data-i18n="general.dispositivo">{es['general.dispositivo']}</span>
          <select name="dispositivoId" class="technical-select"><option value="" data-i18n="general.todos">{es['general.todos']}</option></select>
        </label>
        <label class="log-filter">
          <span data-i18n="reportes.auditoriasEspecificas">{es['reportes.auditoriasEspecificas']}</span>
          <input name="auditorias" class="technical-input" type="text" inputmode="numeric" placeholder={es['reportes.ejOpcional']} data-i18n-placeholder="reportes.ejOpcional" />
        </label>
      </div>
      <fieldset class="report-checks">
        <legend data-i18n="reportes.severidadHallazgos">{es['reportes.severidadHallazgos']}</legend>
        <label><input type="checkbox" name="severidad" value="CRITICA" /><span data-i18n="severidad.CRITICA">{es['severidad.CRITICA']}</span></label>
        <label><input type="checkbox" name="severidad" value="ALTA" /><span data-i18n="severidad.ALTA">{es['severidad.ALTA']}</span></label>
        <label><input type="checkbox" name="severidad" value="MEDIA" /><span data-i18n="severidad.MEDIA">{es['severidad.MEDIA']}</span></label>
        <label><input type="checkbox" name="severidad" value="BAJA" /><span data-i18n="severidad.BAJA">{es['severidad.BAJA']}</span></label>
      </fieldset>
      <fieldset class="report-checks">
        <legend data-i18n="reportes.estadoHallazgos">{es['reportes.estadoHallazgos']}</legend>
        <label><input type="checkbox" name="estado" value="ABIERTO" /><span data-i18n="hallazgo.ABIERTO">{es['hallazgo.ABIERTO']}</span></label>
        <label><input type="checkbox" name="estado" value="EN_REVISION" /><span data-i18n="hallazgo.EN_REVISION">{es['hallazgo.EN_REVISION']}</span></label>
        <label><input type="checkbox" name="estado" value="RESUELTO" /><span data-i18n="hallazgo.RESUELTO">{es['hallazgo.RESUELTO']}</span></label>
        <label><input type="checkbox" name="estado" value="ACEPTADO" /><span data-i18n="hallazgo.ACEPTADO">{es['hallazgo.ACEPTADO']}</span></label>
      </fieldset>
      <p class="technical-hint" data-i18n="reportes.sinMarcarTodosAuditorias">{es['reportes.sinMarcarTodosAuditorias']}</p>
      <button id="report-submit" type="submit" class="button button-primary button-full" data-i18n="reportes.generarReporte">{es['reportes.generarReporte']}</button>
    </form>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="reportes.disponibles">{es['reportes.disponibles']}</span>
          <h2 data-i18n="reportes.reportesGenerados">{es['reportes.reportesGenerados']}</h2>
        </div>
        <span id="report-count" class="counter-chip">—</span>
      </div>
      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead>
            <tr><th data-i18n="reportes.colReporte">{es['reportes.colReporte']}</th><th data-i18n="reportes.colTitulo">{es['reportes.colTitulo']}</th><th data-i18n="reportes.colAuditorias">{es['reportes.colAuditorias']}</th><th data-i18n="general.colHallazgos">{es['general.colHallazgos']}</th><th data-i18n="reportes.colGenerado">{es['reportes.colGenerado']}</th></tr>
          </thead>
          <tbody id="report-list"></tbody>
        </table>
        <div id="report-empty" class="empty-state compact-empty is-hidden">
          <div><code data-i18n="reportes.ceroReportes">{es['reportes.ceroReportes']}</code><p data-i18n="reportes.todaviaGeneraronReportes">{es['reportes.todaviaGeneraronReportes']}</p></div>
        </div>
      </div>
    </article>
  </section>

  <article id="report-view" class="panel report-document is-hidden" aria-live="polite"></article>

  <script src="../scripts/reports.ts"></script>
</MasterLayout>
