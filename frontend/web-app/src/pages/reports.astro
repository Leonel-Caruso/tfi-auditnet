---
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title="Reportes de auditoría"
  section="Resultados y trazabilidad"
  description="Reporte formal con auditorías, dispositivos, hallazgos, severidad, impacto y evidencia (CU-006-001). Se guarda como foto fija y se descarga en PDF o CSV."
>
  <div id="report-error" class="alert alert-error is-hidden report-no-print" role="alert"></div>
  <div id="report-success" class="alert alert-success is-hidden report-no-print" role="status"></div>

  <section class="report-workspace report-no-print">
    <form id="report-form" class="panel compact-panel" novalidate>
      <div class="panel-heading">
        <div>
          <span class="eyebrow">Nuevo reporte</span>
          <h2>Criterios</h2>
        </div>
      </div>
      <p id="report-readonly" class="log-muted is-hidden">Tu perfil puede consultar y descargar reportes, pero no generarlos.</p>
      <div class="log-filter-grid report-criteria">
        <label class="log-filter">
          <span>desde</span>
          <input name="desde" class="technical-input" type="date" />
        </label>
        <label class="log-filter">
          <span>hasta</span>
          <input name="hasta" class="technical-input" type="date" />
        </label>
        <label class="log-filter" id="report-org-filter" hidden>
          <span>organización</span>
          <select name="organizacionId" class="technical-select"><option value="">todas</option></select>
        </label>
        <label class="log-filter">
          <span>dispositivo</span>
          <select name="dispositivoId" class="technical-select"><option value="">todos</option></select>
        </label>
        <label class="log-filter">
          <span>auditorías específicas</span>
          <input name="auditorias" class="technical-input" type="text" inputmode="numeric" placeholder="ej: 12, 15 (opcional)" />
        </label>
      </div>
      <fieldset class="report-checks">
        <legend>severidad de los hallazgos</legend>
        <label><input type="checkbox" name="severidad" value="CRITICA" />CRITICA</label>
        <label><input type="checkbox" name="severidad" value="ALTA" />ALTA</label>
        <label><input type="checkbox" name="severidad" value="MEDIA" />MEDIA</label>
        <label><input type="checkbox" name="severidad" value="BAJA" />BAJA</label>
      </fieldset>
      <fieldset class="report-checks">
        <legend>estado de los hallazgos</legend>
        <label><input type="checkbox" name="estado" value="ABIERTO" />ABIERTO</label>
        <label><input type="checkbox" name="estado" value="EN_REVISION" />EN_REVISION</label>
        <label><input type="checkbox" name="estado" value="RESUELTO" />RESUELTO</label>
        <label><input type="checkbox" name="estado" value="ACEPTADO" />ACEPTADO</label>
      </fieldset>
      <p class="technical-hint">Sin marcar = todos. Con auditorías específicas, las fechas son opcionales.</p>
      <button id="report-submit" type="submit" class="button button-primary button-full">Generar reporte</button>
    </form>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">Disponibles</span>
          <h2>Reportes generados</h2>
        </div>
        <span id="report-count" class="counter-chip">—</span>
      </div>
      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead>
            <tr><th>REPORTE</th><th>TÍTULO</th><th>AUDITORÍAS</th><th>HALLAZGOS</th><th>GENERADO</th></tr>
          </thead>
          <tbody id="report-list"></tbody>
        </table>
        <div id="report-empty" class="empty-state compact-empty is-hidden">
          <div><code>reports.count = 0</code><p>Todavía no se generaron reportes.</p></div>
        </div>
      </div>
    </article>
  </section>

  <article id="report-view" class="panel report-document is-hidden" aria-live="polite"></article>

  <script>
    import { auditFetch, authFetch, getStoredUser, hasRole } from '../lib/auth';
    import {
      jsonRequest,
      readApiError,
      type AuditReport,
      type NetworkDevice,
      type Organization,
      type ReportSummary,
      type Site,
    } from '../lib/api';
    import { code, escapeHtml, findingStatusBadge, formatDate, severityClass } from '../lib/format';
    import { loadVisibleSites } from '../lib/sites';

    const isAdmin = hasRole('ADMINISTRADOR_SISTEMA');
    // CU-006-001: generan el administrador, el analista de redes y el auditor técnico; el resto consulta.
    const canGenerate = isAdmin || hasRole('ANALISTA_RED') || hasRole('AUDITOR_TECNICO');
    const params = new URLSearchParams(window.location.search);

    let reports: ReportSummary[] = [];
    let devices: NetworkDevice[] = [];
    let sites: Site[] = [];
    let organizations: Organization[] = [];
    let selectedId: number | null = null;

    const form = document.querySelector<HTMLFormElement>('#report-form');
    const view = document.querySelector<HTMLElement>('#report-view');

    const show = (selector: string, message: string | null) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (!node) return;
      node.textContent = message ?? '';
      node.classList.toggle('is-hidden', !message);
    };
    const showError = (message: string | null) => show('#report-error', message);
    const showSuccess = (message: string) => {
      show('#report-success', message);
      window.setTimeout(() => show('#report-success', null), 5000);
    };

    const isoDate = (date: Date) => {
      const pad = (value: number) => String(value).padStart(2, '0');
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
    };
    /** Fecha del input (día local) → ISO-8601: inicio del día para "desde" y fin del día para "hasta". */
    const dayToIso = (value: string, endOfDay: boolean) => {
      if (!value) return null;
      const [year, month, day] = value.split('-').map(Number);
      const date = endOfDay ? new Date(year, month - 1, day, 23, 59, 59, 999) : new Date(year, month - 1, day, 0, 0, 0, 0);
      return date.toISOString();
    };
    const orgName = (id: number | null) => id == null
      ? 'todas las organizaciones'
      : organizations.find((organization) => organization.id === id)?.razonSocial ?? `organización #${id}`;
    const siteName = (id: number | null) => id == null ? 'sin sede' : sites.find((site) => site.id === id)?.nombre ?? `sede #${id}`;

    const renderList = () => {
      const body = document.querySelector<HTMLTableSectionElement>('#report-list');
      if (!body) return;
      body.innerHTML = reports.map((report) => `
        <tr class="finding-row ${report.id === selectedId ? 'is-selected' : ''}" data-report-id="${report.id}" tabindex="0">
          <td><code class="log-nowrap">${code('REP', report.id)}</code></td>
          <td><strong>${escapeHtml(report.titulo)}</strong>${isAdmin ? `<small>${escapeHtml(orgName(report.organizacionId))}</small>` : ''}</td>
          <td>${report.totalAuditorias}</td>
          <td>${report.totalHallazgos}</td>
          <td><span class="log-nowrap">${escapeHtml(formatDate(report.fechaGeneracion))}</span><small>${escapeHtml(report.generadoPor)}</small></td>
        </tr>`).join('');
      const count = document.querySelector('#report-count');
      if (count) count.textContent = String(reports.length);
      document.querySelector('#report-empty')?.classList.toggle('is-hidden', reports.length > 0);
      body.querySelectorAll<HTMLElement>('[data-report-id]').forEach((row) => {
        const open = () => void openReport(Number(row.dataset.reportId));
        row.addEventListener('click', open);
        row.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            open();
          }
        });
      });
    };

    const criteriaText = (report: AuditReport) => {
      const criteria = report.criterios;
      const parts = [
        `organización: ${orgName(criteria.organizacionId)}`,
        criteria.desde || criteria.hasta
          ? `período: ${criteria.desde ? formatDate(criteria.desde) : '—'} a ${criteria.hasta ? formatDate(criteria.hasta) : '—'}`
          : null,
        criteria.auditoriaIds.length ? `auditorías: ${criteria.auditoriaIds.map((id) => code('AUD', id)).join(', ')}` : null,
        criteria.dispositivoIds.length
          ? `dispositivos: ${criteria.dispositivoIds.map((id) => devices.find((device) => device.id === id)?.identificador ?? `#${id}`).join(', ')}`
          : 'dispositivos: todos',
        `severidades: ${criteria.severidades.length ? criteria.severidades.join(', ') : 'todas'}`,
        `estados: ${criteria.estados.length ? criteria.estados.join(', ') : 'todos'}`,
      ];
      return parts.filter(Boolean).map((part) => `<li>${escapeHtml(part)}</li>`).join('');
    };

    const renderReport = (report: AuditReport) => {
      if (!view) return;
      const { resumen, auditorias, hallazgos, inconsistencias } = report.contenido;
      const severityRows = Object.entries(resumen.hallazgosPorSeveridad)
        .map(([severity, total]) => `<span class="severity-badge ${severityClass(severity)}">${escapeHtml(severity)}: ${total}</span>`)
        .join('');
      view.innerHTML = `
        <header class="report-header">
          <div>
            <span class="eyebrow">Reporte de auditoría · ${code('REP', report.id)}</span>
            <h2>${escapeHtml(report.titulo)}</h2>
            <p>Generado el ${escapeHtml(formatDate(report.fechaGeneracion))} por <strong>${escapeHtml(report.generadoPor)}</strong> · AuditNet</p>
          </div>
          <div class="report-actions report-no-print">
            <button id="report-print" type="button" class="button button-primary button-small">Descargar PDF</button>
            <button id="report-csv" type="button" class="button button-ghost button-small">Descargar CSV</button>
          </div>
        </header>

        <section class="report-section">
          <h3>Criterios</h3>
          <ul class="report-criteria-list">${criteriaText(report)}</ul>
        </section>

        <section class="report-section">
          <h3>Resumen</h3>
          <div class="report-kpis">
            <div><span>resultado general</span><strong class="${resumen.resultadoGeneral === 'CON_DESVIOS' ? 'is-alert' : ''}">${resumen.resultadoGeneral === 'CON_DESVIOS' ? 'Con desvíos' : 'Sin desvíos'}</strong></div>
            <div><span>auditorías</span><strong>${resumen.auditorias}</strong></div>
            <div><span>dispositivos</span><strong>${resumen.dispositivos}</strong></div>
            <div><span>cumplimiento</span><strong>${resumen.cumplimiento == null ? '—' : `${resumen.cumplimiento}%`}</strong><small>${resumen.reglasCumplidas}/${resumen.reglasEvaluadas} reglas</small></div>
            <div><span>hallazgos</span><strong>${resumen.hallazgos}</strong><small>${resumen.hallazgosPendientes} pendientes</small></div>
            <div><span>severidad máxima</span><strong>${escapeHtml(resumen.severidadMaxima)}</strong></div>
          </div>
          <div class="badge-row report-severity">${severityRows}</div>
        </section>

        ${inconsistencias.length ? `
        <section class="report-section">
          <div class="alert alert-error"><strong>Datos incompletos:</strong> ${inconsistencias.map(escapeHtml).join(' ')}</div>
        </section>` : ''}

        <section class="report-section">
          <h3>Auditorías incluidas</h3>
          <div class="table-wrap">
            <table class="data-table">
              <thead><tr><th>AUDITORÍA</th><th>FECHA</th><th>DISPOSITIVO</th><th>BASELINE</th><th>CONFIG.</th><th>REGLAS</th><th>HALLAZGOS</th><th>RESULTADO</th></tr></thead>
              <tbody>${auditorias.map((audit) => `
                <tr>
                  <td><a class="inline-link" href="/history?auditoria=${audit.id}">${code('AUD', audit.id)}</a><small>${escapeHtml(audit.ejecutadoPor)}</small></td>
                  <td><span class="log-nowrap">${escapeHtml(formatDate(audit.fechaEjecucion))}</span></td>
                  <td><strong>${escapeHtml(audit.dispositivoIdentificador ?? `#${audit.dispositivoId}`)}</strong><small>${escapeHtml(audit.criticidadDispositivo ?? '')} · ${escapeHtml(siteName(audit.sedeId))}</small></td>
                  <td>${escapeHtml(audit.baselineNombre ?? `#${audit.baselineId}`)}${audit.baselineVersion ? ` v${audit.baselineVersion}` : ''}</td>
                  <td>${code('CFG', audit.configuracionId)}${audit.configuracionVersion ? ` · v${audit.configuracionVersion}` : ''}</td>
                  <td>${audit.reglasCumplidas}/${audit.totalReglas}</td>
                  <td>${audit.totalHallazgos}</td>
                  <td>${escapeHtml(audit.resultado)}</td>
                </tr>`).join('')}</tbody>
            </table>
          </div>
        </section>

        <section class="report-section">
          <h3>Hallazgos (${hallazgos.length})</h3>
          ${hallazgos.length === 0 ? '<p class="log-muted">No hay hallazgos que cumplan los criterios.</p>' : hallazgos.map((finding) => `
            <article class="report-finding">
              <div class="report-finding-head">
                <span class="severity-badge ${severityClass(finding.severidad)}">${escapeHtml(finding.severidad)}</span>
                <strong>${escapeHtml(finding.codigoRegla)} · ${escapeHtml(finding.nombreRegla)}</strong>
                ${findingStatusBadge(finding.estado)}
              </div>
              <p class="report-finding-meta">${code('FND', finding.id)} · ${escapeHtml(finding.dispositivoIdentificador ?? `#${finding.dispositivoId}`)} · ${code('AUD', finding.auditoriaId)} · detectado ${escapeHtml(formatDate(finding.fechaDeteccion))}</p>
              ${finding.impacto ? `<p><span>Impacto:</span> ${escapeHtml(finding.impacto)}</p>` : ''}
              <p><span>Evidencia:</span></p>
              <pre>${escapeHtml(finding.evidencia)}</pre>
              <p><span>Recomendación:</span> ${escapeHtml(finding.recomendacion)}</p>
            </article>`).join('')}
        </section>

        <footer class="report-footer">
          Foto fija generada el ${escapeHtml(formatDate(report.fechaGeneracion))}: el estado de los hallazgos es el de ese momento
          y el reporte no cambia aunque cambien los datos de origen.
        </footer>`;
      view.classList.remove('is-hidden');

      document.querySelector('#report-print')?.addEventListener('click', () => window.print());
      document.querySelector('#report-csv')?.addEventListener('click', () => void downloadCsv(report.id));
    };

    const downloadCsv = async (id: number) => {
      showError(null);
      const response = await auditFetch(`/api/reports/${id}/download`);
      if (!response.ok) return showError(await readApiError(response));
      const url = URL.createObjectURL(await response.blob());
      const link = document.createElement('a');
      link.href = url;
      link.download = `reporte-${code('REP', id)}.csv`;
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    const openReport = async (id: number) => {
      selectedId = id;
      renderList();
      const response = await auditFetch(`/api/reports/${id}`);
      if (id !== selectedId) return;
      if (!response.ok) return showError(await readApiError(response));
      const report = await response.json() as AuditReport;
      if (id !== selectedId) return;
      renderReport(report);
      view?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const loadReports = async () => {
      const response = await auditFetch('/api/reports');
      if (!response.ok) throw new Error(await readApiError(response));
      reports = await response.json() as ReportSummary[];
      renderList();
    };

    const loadReferences = async () => {
      const [deviceResponse, visibleSites] = await Promise.all([auditFetch('/api/devices'), loadVisibleSites()]);
      if (deviceResponse.ok) devices = await deviceResponse.json() as NetworkDevice[];
      sites = visibleSites;
      const deviceSelect = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
      devices.forEach((device) => deviceSelect?.add(new Option(`${device.identificador} · ${device.nombre}`, String(device.id))));
      if (!isAdmin) {
        const own = getStoredUser()?.organizationId;
        const response = own ? await authFetch(`/api/client-organizations/${own}`) : null;
        if (response?.ok) organizations = [await response.json() as Organization];
      } else {
        const response = await authFetch('/api/client-organizations');
        if (response.ok) organizations = await response.json() as Organization[];
        const orgSelect = form?.querySelector<HTMLSelectElement>('[name=organizacionId]');
        organizations.forEach((organization) => orgSelect?.add(new Option(organization.razonSocial, String(organization.id))));
        document.querySelector('#report-org-filter')?.removeAttribute('hidden');
      }
    };

    const setupForm = () => {
      if (!form) return;
      const today = new Date();
      const monthAgo = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 30);
      form.querySelector<HTMLInputElement>('[name=desde]')!.value = isoDate(monthAgo);
      form.querySelector<HTMLInputElement>('[name=hasta]')!.value = isoDate(today);
      const presetAudit = params.get('auditoria');
      if (presetAudit) form.querySelector<HTMLInputElement>('[name=auditorias]')!.value = presetAudit;
      if (!canGenerate) {
        document.querySelector('#report-readonly')?.classList.remove('is-hidden');
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button')
          .forEach((field) => { field.disabled = true; });
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        showError(null);
        const data = new FormData(form);
        const auditText = String(data.get('auditorias') ?? '').trim();
        const auditIds = auditText ? auditText.split(/[\s,;]+/).filter(Boolean).map((value) => Number(value.replace(/^AUD-0*/i, ''))) : [];
        if (auditIds.some((id) => !Number.isInteger(id) || id <= 0)) {
          return showError('Las auditorías específicas deben ser números separados por coma (ej: 12, 15).');
        }
        const desde = dayToIso(String(data.get('desde') ?? ''), false);
        const hasta = dayToIso(String(data.get('hasta') ?? ''), true);
        if (auditIds.length === 0 && (!desde || !hasta)) {
          return showError('Indicá el rango de fechas (desde y hasta) o auditorías específicas.');
        }
        if (desde && hasta && desde > hasta) return showError("La fecha 'desde' no puede ser posterior a 'hasta'.");

        const device = Number(data.get('dispositivoId')) || null;
        const submit = document.querySelector<HTMLButtonElement>('#report-submit');
        if (submit) submit.disabled = true;
        try {
          const response = await auditFetch('/api/reports/audits', jsonRequest('POST', {
            organizacionId: Number(data.get('organizacionId')) || null,
            desde,
            hasta,
            dispositivoIds: device ? [device] : [],
            severidades: data.getAll('severidad'),
            estados: data.getAll('estado'),
            auditoriaIds: auditIds,
          }));
          if (!response.ok) return showError(await readApiError(response));
          if (response.status !== 201) {
            const body = await response.json() as { message?: string };
            return showError(body.message ?? 'No hay resultados para reportar.');
          }
          const report = await response.json() as AuditReport;
          showSuccess(`${code('REP', report.id)} generado: ${report.totalAuditorias} auditorías y ${report.totalHallazgos} hallazgos.`);
          await loadReports();
          selectedId = report.id;
          renderList();
          renderReport(report);
          view?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } finally {
          if (submit) submit.disabled = !canGenerate;
        }
      });
    };

    setupForm();
    loadReferences()
      .catch(() => {})
      .then(loadReports)
      .then(() => {
        const initial = Number(params.get('reporte')) || null;
        if (initial) void openReport(initial);
      })
      .catch((error) => showError(error instanceof Error ? error.message : 'No se pudieron cargar los reportes.'));
  </script>
</MasterLayout>
