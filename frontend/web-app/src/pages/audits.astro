---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['auditorias.titulo']} section={es['auditorias.seccion']} description={es['auditorias.descripcion']}
  i18n="auditorias"
>
  <div id="audit-success" class="alert alert-success is-hidden"></div>
  <div id="audit-error" class="alert alert-error is-hidden"></div>

  <section class="panel compact-panel audit-toolbar">
    <div class="device-toolbar-copy">
      <span class="eyebrow" data-i18n="auditorias.auditoriasTitulo">{es['auditorias.auditoriasTitulo']}</span>
      <div>
        <strong id="configuration-count" data-i18n="auditorias.ceroConfiguraciones">{es['auditorias.ceroConfiguraciones']}</strong>
        <span data-i18n="auditorias.versionesAuditablesDisponibles">{es['auditorias.versionesAuditablesDisponibles']}</span>
      </div>
    </div>
    <div class="device-toolbar-actions">
      <div class="terminal-search">
        <span>&gt;</span>
        <input id="audit-search" type="search" placeholder={es['auditorias.buscarDispositivoVersionUsuario']} data-i18n-placeholder="auditorias.buscarDispositivoVersionUsuario" />
      </div>
      <button id="open-config-dialog" class="button button-primary device-create-action" type="button" data-i18n="auditorias.cargarConfiguracion">{es['auditorias.cargarConfiguracion']}</button>
    </div>
  </section>

  <section class="audit-workspace">
    <div class="audit-main-column">
      <article class="panel audit-panel">
        <div class="panel-heading">
          <div>
            <span class="eyebrow" data-i18n="auditorias.configuracionesTitulo">{es['auditorias.configuracionesTitulo']}</span>
            <h2 data-i18n="auditorias.configuracionesAuditables">{es['auditorias.configuracionesAuditables']}</h2>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table audit-table">
            <thead>
              <tr>
                <th data-i18n="auditorias.colConfig">{es['auditorias.colConfig']}</th>
                <th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th>
                <th data-i18n="auditorias.colVersion">{es['auditorias.colVersion']}</th>
                <th data-i18n="auditorias.colFormato">{es['auditorias.colFormato']}</th>
                <th data-i18n="auditorias.colImportadaPor">{es['auditorias.colImportadaPor']}</th>
                <th data-i18n="general.colFecha">{es['general.colFecha']}</th>
              </tr>
            </thead>
            <tbody id="configuration-table-body"></tbody>
          </table>
          <div id="configuration-empty" class="empty-state compact-empty">
            <div>
              <code data-i18n="auditorias.ceroConfiguraciones">{es['auditorias.ceroConfiguraciones']}</code>
              <p data-i18n="auditorias.todaviaHayConfiguracionesImportadas">{es['auditorias.todaviaHayConfiguracionesImportadas']}</p>
            </div>
          </div>
        </div>
      </article>

      <article class="panel audit-panel">
        <div class="panel-heading">
          <div>
            <span class="eyebrow" data-i18n="auditorias.ejecuciones">{es['auditorias.ejecuciones']}</span>
            <h2 data-i18n="auditorias.auditoriasEjecutadas">{es['auditorias.auditoriasEjecutadas']}</h2>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table audit-table">
            <thead>
              <tr>
                <th data-i18n="auditorias.colAudit">{es['auditorias.colAudit']}</th>
                <th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th>
                <th data-i18n="general.colBaseline">{es['general.colBaseline']}</th>
                <th data-i18n="auditorias.colReglas">{es['auditorias.colReglas']}</th>
                <th data-i18n="auditorias.colCumple">{es['auditorias.colCumple']}</th>
                <th data-i18n="general.colHallazgos">{es['general.colHallazgos']}</th>
                <th data-i18n="general.colResultado">{es['general.colResultado']}</th>
              </tr>
            </thead>
            <tbody id="audit-table-body"></tbody>
          </table>
          <div id="audit-empty" class="empty-state compact-empty">
            <div>
              <code data-i18n="auditorias.ceroAuditorias">{es['auditorias.ceroAuditorias']}</code>
              <p data-i18n="auditorias.hayAuditoriasEjecutadasTodavia">{es['auditorias.hayAuditoriasEjecutadasTodavia']}</p>
            </div>
          </div>
        </div>
      </article>
    </div>

    <aside class="panel audit-inspector">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="auditorias.auditoriaSeleccionada">{es['auditorias.auditoriaSeleccionada']}</span>
          <h2 data-i18n="auditorias.contextoAuditoria">{es['auditorias.contextoAuditoria']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="audit-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="auditorias.seleccionaConfiguracionRevisarContexto">{es['auditorias.seleccionaConfiguracionRevisarContexto']}</p>
      </div>

      <div id="audit-inspector-content" class="inspector-content is-hidden"></div>
    </aside>
  </section>

  <dialog id="config-dialog" class="technical-dialog">
    <form id="config-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="auditorias.importarConfiguracion">{es['auditorias.importarConfiguracion']}</span>
          <h2 data-i18n="auditorias.cargarConfiguracionTitulo">{es['auditorias.cargarConfiguracionTitulo']}</h2>
          <p data-i18n="auditorias.importaRunningConfigMediante">{es['auditorias.importaRunningConfigMediante']}</p>
        </div>
        <button id="close-config-dialog" class="dialog-close" type="button" aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field field-span-2">
          <span data-i18n="auditorias.dispositivoObligatorio">{es['auditorias.dispositivoObligatorio']}</span>
          <select id="config-device" class="form-select" required>
            <option value="" data-i18n="auditorias.seleccionarDispositivo">{es['auditorias.seleccionarDispositivo']}</option>
          </select>
        </label>

        <label class="field field-span-2">
          <span data-i18n="auditorias.archivoOpcional">{es['auditorias.archivoOpcional']}</span>
          <input id="config-file" type="file" accept=".txt,.cfg,text/plain" />
        </label>

        <label class="field field-span-2">
          <span data-i18n="auditorias.configuracionRunningConfigObligatorio">{es['auditorias.configuracionRunningConfigObligatorio']}</span>
          <textarea
            id="config-content"
            class="mono-input config-editor"
            rows="14"
            placeholder="hostname RTR-CORE-01&#10;ip ssh version 2&#10;line vty 0 4&#10; transport input telnet ssh"
            required
          ></textarea>
        </label>
      </div>

      <div class="rule-help">
        <code data-i18n="auditorias.original">{es['auditorias.original']}</code>
        <span data-i18n="auditorias.conservaExactamenteContenidoRecibido">{es['auditorias.conservaExactamenteContenidoRecibido']}</span>
        <code data-i18n="auditorias.normalizada">{es['auditorias.normalizada']}</code>
        <span data-i18n="auditorias.generaCopiaNormalizadaComparar">{es['auditorias.generaCopiaNormalizadaComparar']}</span>
      </div>

      <div class="dialog-actions">
        <button id="cancel-config" class="button button-ghost" type="button" data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="auditorias.importarConfiguracion">{es['auditorias.importarConfiguracion']}</button>
      </div>
    </form>
  </dialog>

  <script src="../scripts/audits.ts"></script>
</MasterLayout>
