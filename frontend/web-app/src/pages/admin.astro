---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['admin.titulo']} section={es['admin.seccion']} description={es['admin.descripcion']}
  i18n="admin"
>
  <div id="admin-error" class="alert alert-error is-hidden" role="alert"></div>

  <section class="panel compact-panel dashboard-scope">
    <div>
      <span class="eyebrow" data-i18n="admin.estadoPlataforma">{es['admin.estadoPlataforma']}</span>
      <h2 id="admin-overall" data-i18n="admin.verificandoServicios">{es['admin.verificandoServicios']}</h2>
    </div>
    <div class="dashboard-scope-actions">
      <span id="admin-checked" class="technical-hint"></span>
      <button id="admin-refresh" class="button button-ghost button-small" type="button" data-i18n="admin.actualizar">{es['admin.actualizar']}</button>
    </div>
  </section>

  <section class="panel compact-panel dashboard-scope">
    <div>
      <span class="eyebrow" data-i18n="admin.planes">{es['admin.planes']}</span>
      <h2 id="admin-plan-requests" data-i18n="admin.solicitudesCambioPlan">{es['admin.solicitudesCambioPlan']}</h2>
    </div>
    <a class="inline-link" href="/plans" data-i18n="organizaciones.resolver">{es['organizaciones.resolver']}</a>
  </section>

  <section class="health-grid" id="admin-health">
    <article class="panel" data-service="management"><div class="skeleton-row"></div></article>
    <article class="panel" data-service="core"><div class="skeleton-row"></div></article>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="admin.infraestructura">{es['admin.infraestructura']}</span>
        <h2 data-i18n="admin.gatewayMensajeria">{es['admin.gatewayMensajeria']}</h2>
      </div>
    </div>
    <div class="health-components" style="margin-top: 0;">
      <div class="health-component">
        <span class="health-dot"></span>
        <div><strong data-i18n="admin.gatewayWebNginx">{es['admin.gatewayWebNginx']}</strong><small data-i18n="admin.sirveConsolaDerivaApi">{es['admin.sirveConsolaDerivaApi']}</small></div>
        <code data-i18n="consola.enLinea">{es['consola.enLinea']}</code>
      </div>
      <div class="health-component">
        <span class="health-dot is-na"></span>
        <div><strong data-i18n="admin.colasMensajeria">{es['admin.colasMensajeria']}</strong><small data-i18n="admin.colasNoAplica">{es['admin.colasNoAplica']}</small></div>
        <code data-i18n="admin.noAplica">{es['admin.noAplica']}</code>
      </div>
    </div>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="admin.correo">{es['admin.correo']}</span>
          <h2 data-i18n="admin.bandejaSalida">{es['admin.bandejaSalida']}</h2>
        </div>
        <span id="mail-provider" class="status-badge status-next">—</span>
      </div>
      <div id="mail-totals" class="storage-totals"></div>
      <div class="storage-pending">
        <p id="mail-note" class="log-muted" data-i18n="admin.avisosEnvianSolosGuardarse">{es['admin.avisosEnvianSolosGuardarse']}</p>
        <button id="mail-dispatch" class="button button-ghost button-small" type="button" disabled data-i18n="admin.enviarPendientes">{es['admin.enviarPendientes']}</button>
      </div>
      <div class="table-wrap">
        <table class="data-table log-table">
          <thead><tr><th data-i18n="general.colFecha">{es['general.colFecha']}</th><th data-i18n="admin.colAviso">{es['admin.colAviso']}</th><th data-i18n="admin.colDestinatario">{es['admin.colDestinatario']}</th><th data-i18n="general.colEstado">{es['general.colEstado']}</th></tr></thead>
          <tbody id="mail-list"></tbody>
        </table>
        <div id="mail-empty" class="empty-state compact-empty is-hidden">
          <div><code data-i18n="admin.ceroCorreos">{es['admin.ceroCorreos']}</code><p data-i18n="admin.todaviaGeneroNingunAviso">{es['admin.todaviaGeneroNingunAviso']}</p></div>
        </div>
      </div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="admin.revisionPeriodica">{es['admin.revisionPeriodica']}</span>
          <h2 data-i18n="admin.vencimientosReAuditorias">{es['admin.vencimientosReAuditorias']}</h2>
        </div>
        <button id="review-run" class="button button-primary button-small" type="button" data-i18n="admin.ejecutarRevisionAhora">{es['admin.ejecutarRevisionAhora']}</button>
      </div>
      <p class="log-muted" data-i18n="admin.trabajoProgramadoEjecutaTodos">{es['admin.trabajoProgramadoEjecutaTodos']}</p>
      <div id="review-result" class="review-result is-hidden"></div>
    </article>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="admin.almacenamiento">{es['admin.almacenamiento']}</span>
          <h2 data-i18n="admin.repositorioArchivos">{es['admin.repositorioArchivos']}</h2>
        </div>
        <span id="storage-state" class="status-badge status-next">—</span>
      </div>
      <p id="storage-summary" class="log-muted" data-i18n="admin.configuracionesImportadasReportesGenerados">{es['admin.configuracionesImportadasReportesGenerados']}</p>
      <div id="storage-totals" class="storage-totals"></div>
      <div class="storage-pending">
        <p id="storage-pending" class="log-muted"></p>
        <button id="storage-sync" class="button button-ghost button-small" type="button" disabled data-i18n="admin.subirPendientes">{es['admin.subirPendientes']}</button>
      </div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="admin.respaldos">{es['admin.respaldos']}</span>
          <h2 data-i18n="admin.copiasBaseDatos">{es['admin.copiasBaseDatos']}</h2>
        </div>
        <button id="backup-create" class="button button-primary button-small" type="button" data-i18n="admin.generarRespaldo">{es['admin.generarRespaldo']}</button>
      </div>
      <div class="table-wrap">
        <table class="data-table log-table">
          <thead><tr><th data-i18n="admin.colRespaldo">{es['admin.colRespaldo']}</th><th data-i18n="admin.colTamano">{es['admin.colTamano']}</th><th aria-label={es['admin.descargar']} data-i18n-aria-label="admin.descargar"></th></tr></thead>
          <tbody id="backup-list"></tbody>
        </table>
        <div id="backup-empty" class="empty-state compact-empty is-hidden">
          <div><code data-i18n="admin.ceroRespaldos">{es['admin.ceroRespaldos']}</code><p data-i18n="admin.todaviaGeneroNingunRespaldo">{es['admin.todaviaGeneroNingunRespaldo']}</p></div>
        </div>
      </div>
      <p class="log-muted" style="margin-top: 12px;" data-i18n="admin.cadaRespaldoTraeDatos">{es['admin.cadaRespaldoTraeDatos']}</p>
    </article>
  </section>

  <dialog id="admin-confirm" class="technical-dialog" style="width: min(480px, calc(100vw - 32px));">
    <form method="dialog" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="admin.respaldoTitulo">{es['admin.respaldoTitulo']}</span>
          <h2 data-i18n="admin.generarRespaldoAhora">{es['admin.generarRespaldoAhora']}</h2>
          <p data-i18n="admin.copianDatosTodasTablas">{es['admin.copianDatosTodasTablas']}</p>
        </div>
      </div>
      <div class="dialog-actions">
        <button class="button button-ghost" value="cancel" data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" value="ok" data-i18n="admin.generar">{es['admin.generar']}</button>
      </div>
    </form>
  </dialog>

  <section class="metric-grid" id="admin-security-kpis">
    <article class="metric-card"><span class="metric-label" data-i18n="general.cargando">{es['general.cargando']}</span><strong>—</strong><small data-i18n="general.consultando">{es['general.consultando']}</small></article>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="admin.seguridad">{es['admin.seguridad']}</span>
          <h2 data-i18n="admin.eventosUltimasHoras">{es['admin.eventosUltimasHoras']}</h2>
        </div>
        <a class="inline-link" href="/logs#sistema" data-i18n="admin.bitacoraSistema">{es['admin.bitacoraSistema']}</a>
      </div>
      <div id="admin-events" class="event-counts"></div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="admin.rechazos">{es['admin.rechazos']}</span>
          <h2 data-i18n="admin.ultimosAccesosOperacionesRechazadas">{es['admin.ultimosAccesosOperacionesRechazadas']}</h2>
        </div>
        <a class="inline-link" href="/logs?resultado=FALLO#sistema" data-i18n="admin.verTodos">{es['admin.verTodos']}</a>
      </div>
      <div class="table-wrap">
        <table class="data-table log-table">
          <thead><tr><th data-i18n="general.colFecha">{es['general.colFecha']}</th><th data-i18n="bitacoras.colEvento">{es['bitacoras.colEvento']}</th><th data-i18n="bitacoras.colActor">{es['bitacoras.colActor']}</th><th data-i18n="general.colDetalle">{es['general.colDetalle']}</th></tr></thead>
          <tbody id="admin-rejections"></tbody>
        </table>
        <div id="admin-rejections-empty" class="empty-state compact-empty is-hidden">
          <div><code>fallos.24h = 0</code><p data-i18n="admin.huboRechazosUltimasHoras">{es['admin.huboRechazosUltimasHoras']}</p></div>
        </div>
      </div>
    </article>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="admin.bitacoras">{es['admin.bitacoras']}</span>
        <h2 data-i18n="admin.registrosPlataforma">{es['admin.registrosPlataforma']}</h2>
      </div>
    </div>
    <nav class="log-tabs" aria-label={es['admin.bitacoras']} data-i18n-aria-label="admin.bitacoras" style="margin-bottom: 0;">
      <a class="log-tab" href="/logs#sistema"><code>SYS</code><span data-i18n="admin.sistema">{es['admin.sistema']}</span><small data-i18n="bitacoras.accesosSeguridadPostgresql">{es['bitacoras.accesosSeguridadPostgresql']}</small></a>
      <a class="log-tab" href="/logs#transacciones"><code>TRX</code><span data-i18n="bitacoras.transacciones">{es['bitacoras.transacciones']}</span><small data-i18n="bitacoras.operacionesNegocioPostgresql">{es['bitacoras.operacionesNegocioPostgresql']}</small></a>
      <a class="log-tab" href="/logs#excepciones"><code>EXC</code><span data-i18n="bitacoras.excepciones">{es['bitacoras.excepciones']}</span><small data-i18n="bitacoras.erroresInesperadosMongodb">{es['bitacoras.erroresInesperadosMongodb']}</small></a>
    </nav>
  </section>

  <script src="../scripts/admin.ts"></script>
</MasterLayout>
