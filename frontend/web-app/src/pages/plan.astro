---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['plan.titulo']} section={es['plan.seccion']} description={es['plan.descripcion']}
  i18n="plan"
>
  <div id="plan-error" class="alert alert-error is-hidden" role="alert"></div>
  <div id="plan-message" class="alert alert-success is-hidden" role="status"></div>
  <div id="plan-expiry" class="alert is-hidden" role="status"></div>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="plan.planActual">{es['plan.planActual']}</span>
          <h2 id="plan-name">—</h2>
        </div>
        <code id="plan-price" class="counter-chip">—</code>
      </div>
      <div id="plan-current" class="plan-summary"><div class="skeleton-row"></div></div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="plan.cambioPlan">{es['plan.cambioPlan']}</span>
          <h2 data-i18n="plan.solicitud">{es['plan.solicitud']}</h2>
        </div>
        <button id="request-open" class="button button-primary button-small" type="button" disabled
          data-roles="ADMINISTRADOR_ORGANIZACION" data-i18n="plan.solicitarCambio">{es['plan.solicitarCambio']}</button>
      </div>
      <div id="plan-pending"><div class="skeleton-row"></div></div>
    </article>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="plan.catalogo">{es['plan.catalogo']}</span>
        <h2 data-i18n="plan.planesDisponibles">{es['plan.planesDisponibles']}</h2>
      </div>
    </div>
    <div id="plan-catalog" class="plan-catalog"><div class="skeleton-row"></div></div>
    <p class="log-muted" style="margin-top: 12px;" data-i18n="plan.preciosReferenciaMesPlataforma">{es['plan.preciosReferenciaMesPlataforma']}</p>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="plan.historial">{es['plan.historial']}</span>
        <h2 data-i18n="plan.solicitudesAnteriores">{es['plan.solicitudesAnteriores']}</h2>
      </div>
    </div>
    <ul id="plan-history" class="request-list"></ul>
    <div id="plan-history-empty" class="empty-state compact-empty is-hidden">
      <div><code data-i18n="plan.ceroSolicitudes">{es['plan.ceroSolicitudes']}</code><p data-i18n="plan.todaviaPidioNingunCambio">{es['plan.todaviaPidioNingunCambio']}</p></div>
    </div>
  </section>

  <dialog id="request-dialog" class="technical-dialog" style="width: min(560px, calc(100vw - 32px));">
    <form id="request-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="plan.cambioPlan">{es['plan.cambioPlan']}</span>
          <h2 data-i18n="plan.solicitarOtroPlan">{es['plan.solicitarOtroPlan']}</h2>
          <p data-i18n="plan.administradorSistemaRevisaTe">{es['plan.administradorSistemaRevisaTe']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>
      <label class="field">
        <span data-i18n="plan.planPedido">{es['plan.planPedido']}</span>
        <select id="request-plan" class="form-select"></select>
      </label>
      <p id="request-conditions" class="log-muted" style="margin: -6px 0 14px;"></p>
      <fieldset class="radio-row">
        <legend class="log-muted" data-i18n="plan.modalidad">{es['plan.modalidad']}</legend>
        <label><input type="radio" name="modalidad" value="MENSUAL" checked /> <span data-i18n="modalidad.MENSUAL">{es['modalidad.MENSUAL']}</span></label>
        <label><input type="radio" name="modalidad" value="ANUAL" /> <span data-i18n="modalidad.ANUAL">{es['modalidad.ANUAL']}</span></label>
      </fieldset>
      <label class="field">
        <span data-i18n="plan.comentario">{es['plan.comentario']}</span>
        <textarea id="request-comment" rows="3" maxlength="500" placeholder={es['plan.ejSumamosDosSedes']} data-i18n-placeholder="plan.ejSumamosDosSedes"></textarea>
      </label>
      <div id="request-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="plan.enviarSolicitud">{es['plan.enviarSolicitud']}</button>
      </div>
    </form>
  </dialog>

  <script src="../scripts/plan.ts"></script>
</MasterLayout>
