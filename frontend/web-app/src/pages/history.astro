---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['historial.titulo']} section={es['historial.seccion']} description={es['historial.descripcion']}
  i18n="historial"
>
  <div id="history-error" class="alert alert-error is-hidden" role="alert"></div>

  <form id="history-filters" class="panel compact-panel log-filters" novalidate>
    <div class="log-filter-grid">
      <label class="log-filter">
        <span data-i18n="general.dispositivo">{es['general.dispositivo']}</span>
        <select name="dispositivoId" class="technical-select"><option value="" data-i18n="general.todos">{es['general.todos']}</option></select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.baseline">{es['general.baseline']}</span>
        <select name="baselineId" class="technical-select"><option value="" data-i18n="general.todas">{es['general.todas']}</option></select>
      </label>
      <label class="log-filter">
        <span data-i18n="auditorias.severidadMaxima">{es['auditorias.severidadMaxima']}</span>
        <select name="severidad" class="technical-select">
          <option value="" data-i18n="general.todas">{es['general.todas']}</option>
          <option value="CRITICA" data-i18n="historial.critica">{es['historial.critica']}</option>
          <option value="ALTA" data-i18n="historial.alta">{es['historial.alta']}</option>
          <option value="MEDIA" data-i18n="historial.media">{es['historial.media']}</option>
          <option value="BAJA" data-i18n="historial.baja">{es['historial.baja']}</option>
          <option value="NINGUNA" data-i18n="historial.sinHallazgos">{es['historial.sinHallazgos']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="historial.resultado">{es['historial.resultado']}</span>
        <select name="resultado" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          <option value="CON_HALLAZGOS" data-i18n="historial.conHallazgos">{es['historial.conHallazgos']}</option>
          <option value="CUMPLE" data-i18n="historial.cumple">{es['historial.cumple']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="historial.ejecutadaPor">{es['historial.ejecutadaPor']}</span>
        <input name="ejecutadoPor" class="technical-input" type="text" maxlength="120" autocomplete="off" placeholder={es['historial.usuario']} data-i18n-placeholder="historial.usuario" />
      </label>
      <label class="log-filter">
        <span data-i18n="general.desde">{es['general.desde']}</span>
        <input name="desde" class="technical-input" type="datetime-local" />
      </label>
      <label class="log-filter">
        <span data-i18n="general.hasta">{es['general.hasta']}</span>
        <input name="hasta" class="technical-input" type="datetime-local" data-time="end" />
      </label>
    </div>
    <div class="log-filter-actions">
      <button type="button" id="history-clear" class="button button-ghost button-small" data-i18n="general.limpiar">{es['general.limpiar']}</button>
      <button type="submit" class="button button-primary button-small" data-i18n="general.consultar">{es['general.consultar']}</button>
    </div>
  </form>

  <section class="finding-workspace log-workspace">
    <article class="panel finding-list-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="historial.registroAuditorias">{es['historial.registroAuditorias']}</span>
          <h2 data-i18n="historial.auditoriasRegistradas">{es['historial.auditoriasRegistradas']}</h2>
        </div>
        <div class="log-heading-meta">
          <span id="history-count" class="counter-chip">—</span>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead>
            <tr>
              <th data-i18n="general.colAuditoria">{es['general.colAuditoria']}</th>
              <th data-i18n="general.colFecha">{es['general.colFecha']}</th>
              <th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th>
              <th data-i18n="general.colBaseline">{es['general.colBaseline']}</th>
              <th data-i18n="auditorias.colReglas">{es['auditorias.colReglas']}</th>
              <th data-i18n="general.colHallazgos">{es['general.colHallazgos']}</th>
              <th data-i18n="historial.colSevMax">{es['historial.colSevMax']}</th>
              <th data-i18n="historial.colEjecuto">{es['historial.colEjecuto']}</th>
            </tr>
          </thead>
          <tbody id="history-body"></tbody>
        </table>
        <div id="history-empty" class="empty-state compact-empty is-hidden">
          <div>
            <code data-i18n="historial.ceroAuditorias">{es['historial.ceroAuditorias']}</code>
            <p data-i18n="historial.encontraronAuditoriasFiltrosActuales">{es['historial.encontraronAuditoriasFiltrosActuales']}</p>
          </div>
        </div>
      </div>
      <nav id="history-pager" class="pager is-hidden" aria-label={es['historial.paginasHistorial']} data-i18n-aria-label="historial.paginasHistorial"></nav>
    </article>

    <aside class="panel finding-inspector" aria-live="polite">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="historial.evidenciaHistorica">{es['historial.evidenciaHistorica']}</span>
          <h2 data-i18n="historial.detalleAuditoria">{es['historial.detalleAuditoria']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="history-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="historial.seleccionaAuditoriaVerEvidencia">{es['historial.seleccionaAuditoriaVerEvidencia']}</p>
      </div>

      <div id="history-inspector-content" class="inspector-content is-hidden"></div>
    </aside>
  </section>

  <script src="../scripts/history.ts"></script>
</MasterLayout>
