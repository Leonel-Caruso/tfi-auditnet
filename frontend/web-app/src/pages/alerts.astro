---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['alertas.titulo']} section={es['alertas.seccion']} description={es['alertas.descripcion']}
  i18n="alertas"
>
  <div id="alert-error" class="alert alert-error is-hidden" role="alert"></div>
  <div id="alert-success" class="alert alert-success is-hidden" role="status"></div>

  <form id="alert-filters" class="panel compact-panel log-filters" novalidate>
    <div class="log-filter-grid">
      <label class="log-filter">
        <span data-i18n="general.estado">{es['general.estado']}</span>
        <select name="estado" class="technical-select">
          <option value="VIGENTES" data-i18n="alertas.vigentes">{es['alertas.vigentes']}</option>
          <option value="ACTIVA" data-i18n="alerta.ACTIVA">{es['alerta.ACTIVA']}</option>
          <option value="EN_ATENCION" data-i18n="alerta.EN_ATENCION">{es['alerta.EN_ATENCION']}</option>
          <option value="CERRADA" data-i18n="alerta.CERRADA">{es['alerta.CERRADA']}</option>
          <option value="TODAS" data-i18n="general.todas">{es['general.todas']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.severidad">{es['general.severidad']}</span>
        <select name="severidad" class="technical-select">
          <option value="" data-i18n="general.todas">{es['general.todas']}</option>
          <option value="CRITICA" data-i18n="severidad.CRITICA">{es['severidad.CRITICA']}</option>
          <option value="ALTA" data-i18n="severidad.ALTA">{es['severidad.ALTA']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="alertas.criticidadEquipo">{es['alertas.criticidadEquipo']}</span>
        <select name="criticidad" class="technical-select">
          <option value="" data-i18n="general.todas">{es['general.todas']}</option>
          <option value="CRITICA" data-i18n="severidad.CRITICA">{es['severidad.CRITICA']}</option>
          <option value="ALTA" data-i18n="severidad.ALTA">{es['severidad.ALTA']}</option>
          <option value="MEDIA" data-i18n="severidad.MEDIA">{es['severidad.MEDIA']}</option>
          <option value="BAJA" data-i18n="severidad.BAJA">{es['severidad.BAJA']}</option>
        </select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.dispositivo">{es['general.dispositivo']}</span>
        <select name="dispositivoId" class="technical-select"><option value="" data-i18n="general.todos">{es['general.todos']}</option></select>
      </label>
      <label class="log-filter">
        <span data-i18n="general.sede">{es['general.sede']}</span>
        <select name="sedeId" class="technical-select"><option value="" data-i18n="general.todas">{es['general.todas']}</option></select>
      </label>
    </div>
    <div class="log-filter-actions">
      <p class="technical-hint alert-hint" data-i18n="alertas.avisoCorreo">{es['alertas.avisoCorreo']}</p>
      <button type="button" id="alert-clear" class="button button-ghost button-small" data-i18n="general.limpiar">{es['general.limpiar']}</button>
      <button type="submit" class="button button-primary button-small" data-i18n="general.consultar">{es['general.consultar']}</button>
    </div>
  </form>

  <section class="finding-summary-grid">
    <article class="metric-card">
      <span class="metric-label" data-i18n="alertas.vigentes">{es['alertas.vigentes']}</span>
      <strong id="metric-alert-open">0</strong>
      <small data-i18n="alertas.activasAtencion">{es['alertas.activasAtencion']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="alertas.sinAtender">{es['alertas.sinAtender']}</span>
      <strong id="metric-alert-active">0</strong>
      <small data-i18n="alertas.nadieTomoTodavia">{es['alertas.nadieTomoTodavia']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="alertaTexto.EN_ATENCION">{es['alertaTexto.EN_ATENCION']}</span>
      <strong id="metric-alert-progress">0</strong>
      <small data-i18n="alertas.derivadasPerfilTecnico">{es['alertas.derivadasPerfilTecnico']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="alertas.criticasVigentes">{es['alertas.criticasVigentes']}</span>
      <strong id="metric-alert-critical">0</strong>
      <small data-i18n="alertas.severidadCritica">{es['alertas.severidadCritica']}</small>
    </article>
  </section>

  <section class="finding-workspace log-workspace">
    <article class="panel finding-list-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="alertas.alertasCriticasTitulo">{es['alertas.alertasCriticasTitulo']}</span>
          <h2 data-i18n="alertas.alertasPriorizadas">{es['alertas.alertasPriorizadas']}</h2>
        </div>
        <div class="log-heading-meta">
          <span id="alert-count" class="counter-chip">—</span>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead>
            <tr>
              <th data-i18n="alertas.colAlerta">{es['alertas.colAlerta']}</th>
              <th data-i18n="general.colRegla">{es['general.colRegla']}</th>
              <th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th>
              <th data-i18n="general.colSeveridad">{es['general.colSeveridad']}</th>
              <th data-i18n="general.colEstado">{es['general.colEstado']}</th>
              <th data-i18n="alertas.colGenerada">{es['alertas.colGenerada']}</th>
            </tr>
          </thead>
          <tbody id="alert-table-body"></tbody>
        </table>
        <div id="alert-empty" class="empty-state compact-empty is-hidden">
          <div>
            <code data-i18n="alertas.ceroAlertas">{es['alertas.ceroAlertas']}</code>
            <p id="alert-empty-text" data-i18n="alertas.hayAlertasCriticasPendientes">{es['alertas.hayAlertasCriticasPendientes']}</p>
          </div>
        </div>
      </div>
    </article>

    <aside class="panel finding-inspector" aria-live="polite">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="alertas.alertaSeleccionada">{es['alertas.alertaSeleccionada']}</span>
          <h2 data-i18n="alertas.detalleDerivacion">{es['alertas.detalleDerivacion']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="alert-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="alertas.seleccionaAlertaVerHallazgo">{es['alertas.seleccionaAlertaVerHallazgo']}</p>
      </div>

      <div id="alert-inspector-content" class="inspector-content is-hidden"></div>
    </aside>
  </section>

  <script src="../scripts/alerts.ts"></script>
</MasterLayout>
