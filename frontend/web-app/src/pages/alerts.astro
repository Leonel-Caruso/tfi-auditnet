---
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title="Alertas críticas"
  section="Resultados y trazabilidad"
  description="Alertas por hallazgos de severidad crítica o alta, ordenadas por prioridad. Seleccioná una para ver el hallazgo y derivarla a un perfil técnico."
>
  <div id="alert-error" class="alert alert-error is-hidden" role="alert"></div>
  <div id="alert-success" class="alert alert-success is-hidden" role="status"></div>

  <form id="alert-filters" class="panel compact-panel log-filters" novalidate>
    <div class="log-filter-grid">
      <label class="log-filter">
        <span>estado</span>
        <select name="estado" class="technical-select">
          <option value="VIGENTES">vigentes</option>
          <option value="ACTIVA">ACTIVA</option>
          <option value="EN_ATENCION">EN_ATENCION</option>
          <option value="CERRADA">CERRADA</option>
          <option value="TODAS">todas</option>
        </select>
      </label>
      <label class="log-filter">
        <span>severidad</span>
        <select name="severidad" class="technical-select">
          <option value="">todas</option>
          <option value="CRITICA">CRITICA</option>
          <option value="ALTA">ALTA</option>
        </select>
      </label>
      <label class="log-filter">
        <span>criticidad del equipo</span>
        <select name="criticidad" class="technical-select">
          <option value="">todas</option>
          <option value="CRITICA">CRITICA</option>
          <option value="ALTA">ALTA</option>
          <option value="MEDIA">MEDIA</option>
          <option value="BAJA">BAJA</option>
        </select>
      </label>
      <label class="log-filter">
        <span>dispositivo</span>
        <select name="dispositivoId" class="technical-select"><option value="">todos</option></select>
      </label>
      <label class="log-filter">
        <span>sede</span>
        <select name="sedeId" class="technical-select"><option value="">todas</option></select>
      </label>
    </div>
    <div class="log-filter-actions">
      <p class="technical-hint alert-hint">Solo alertas internas: no se envían mails ni notificaciones externas.</p>
      <button type="button" id="alert-clear" class="button button-ghost button-small">Limpiar</button>
      <button type="submit" class="button button-primary button-small">Consultar</button>
    </div>
  </form>

  <section class="finding-summary-grid">
    <article class="metric-card">
      <span class="metric-label">vigentes</span>
      <strong id="metric-alert-open">0</strong>
      <small>Activas y en atención</small>
    </article>
    <article class="metric-card">
      <span class="metric-label">sin atender</span>
      <strong id="metric-alert-active">0</strong>
      <small>Nadie las tomó todavía</small>
    </article>
    <article class="metric-card">
      <span class="metric-label">en atención</span>
      <strong id="metric-alert-progress">0</strong>
      <small>Derivadas a un perfil técnico</small>
    </article>
    <article class="metric-card">
      <span class="metric-label">críticas vigentes</span>
      <strong id="metric-alert-critical">0</strong>
      <small>Severidad CRITICA</small>
    </article>
  </section>

  <section class="finding-workspace log-workspace">
    <article class="panel finding-list-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">Alertas críticas</span>
          <h2>Alertas priorizadas</h2>
        </div>
        <div class="log-heading-meta">
          <span id="alert-count" class="counter-chip">—</span>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table finding-table log-table">
          <thead>
            <tr>
              <th>ALERTA</th>
              <th>REGLA</th>
              <th>DISPOSITIVO</th>
              <th>SEVERIDAD</th>
              <th>ESTADO</th>
              <th>GENERADA</th>
            </tr>
          </thead>
          <tbody id="alert-table-body"></tbody>
        </table>
        <div id="alert-empty" class="empty-state compact-empty is-hidden">
          <div>
            <code>0 alertas</code>
            <p id="alert-empty-text">No hay alertas críticas pendientes.</p>
          </div>
        </div>
      </div>
    </article>

    <aside class="panel finding-inspector" aria-live="polite">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">Alerta seleccionada</span>
          <h2>Detalle y derivación</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="alert-inspector-empty" class="inspector-empty">
        <code>sin selección</code>
        <p>Seleccioná una alerta para ver el hallazgo que la originó y derivarla a un perfil técnico.</p>
      </div>

      <div id="alert-inspector-content" class="inspector-content is-hidden"></div>
    </aside>
  </section>

  <script>
    import { auditFetch, hasRole } from '../lib/auth';
    import {
      jsonRequest,
      readApiError,
      type CriticalAlert,
      type CriticalAlertDetail,
      type NetworkDevice,
      type Site,
    } from '../lib/api';
    import { alertStatusBadge, code, escapeHtml, findingStatusBadge, formatDate, severityClass } from '../lib/format';
    import { loadVisibleSites } from '../lib/sites';

    let alerts: CriticalAlert[] = [];
    let devices: NetworkDevice[] = [];
    let sites: Site[] = [];
    let selectedId: number | null = null;
    let loadSeq = 0;

    // El tablero y la vista del cliente llegan con filtros (?severidad=CRITICA, ?dispositivo=ID, ?alerta=ID).
    const params = new URLSearchParams(window.location.search);
    const initialAlert = Number(params.get('alerta')) || null;

    // Derivan o devuelven el administrador, el responsable de gestión IT y el analista de redes.
    const canManage = hasRole('ADMINISTRADOR_SISTEMA') || hasRole('RESPONSABLE_GESTION_IT') || hasRole('ANALISTA_RED');

    const form = document.querySelector<HTMLFormElement>('#alert-filters');
    const siteName = (id: number | null) => id == null ? 'sin sede' : sites.find((site) => site.id === id)?.nombre ?? `sede #${id}`;

    const show = (selector: string, message: string | null) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (!node) return;
      node.textContent = message ?? '';
      node.classList.toggle('is-hidden', !message);
    };
    const showError = (message: string | null) => show('#alert-error', message);
    const showSuccess = (message: string) => {
      show('#alert-success', message);
      window.setTimeout(() => show('#alert-success', null), 4200);
    };

    const buildQuery = () => {
      const query = new URLSearchParams();
      if (form) {
        const data = new FormData(form);
        for (const name of ['estado', 'severidad', 'criticidad', 'dispositivoId', 'sedeId']) {
          const value = String(data.get(name) ?? '');
          if (value) query.set(name, value);
        }
      }
      const text = query.toString();
      return text ? `?${text}` : '';
    };

    const renderMetrics = (all: CriticalAlert[]) => {
      const set = (selector: string, value: number) => {
        const node = document.querySelector<HTMLElement>(selector);
        if (node) node.textContent = String(value);
      };
      const open = all.filter((alert) => alert.estado !== 'CERRADA');
      set('#metric-alert-open', open.length);
      set('#metric-alert-active', open.filter((alert) => alert.estado === 'ACTIVA').length);
      set('#metric-alert-progress', open.filter((alert) => alert.estado === 'EN_ATENCION').length);
      set('#metric-alert-critical', open.filter((alert) => alert.severidad === 'CRITICA').length);
    };

    const render = () => {
      const body = document.querySelector<HTMLTableSectionElement>('#alert-table-body');
      if (!body) return;
      body.innerHTML = alerts.map((alert) => {
        const classes = ['finding-row'];
        if (alert.id === selectedId) classes.push('is-selected');
        if (alert.severidad === 'CRITICA' && alert.estado !== 'CERRADA') classes.push('is-critical');
        if (alert.estado === 'CERRADA') classes.push('is-closed');
        return `
          <tr class="${classes.join(' ')}" data-alert-id="${alert.id}" tabindex="0">
            <td><code>${code('ALR', alert.id)}</code></td>
            <td><strong>${escapeHtml(alert.codigoRegla ?? `hallazgo #${alert.hallazgoId}`)}</strong><small>${escapeHtml(alert.nombreRegla ?? '')}</small></td>
            <td>
              <strong>${escapeHtml(alert.dispositivoIdentificador ?? `#${alert.dispositivoId}`)}</strong>
              <small>criticidad ${escapeHtml(alert.criticidadDispositivo ?? '—')} · ${escapeHtml(siteName(alert.sedeId))}</small>
            </td>
            <td><span class="severity-badge ${severityClass(alert.severidad)}">${escapeHtml(alert.severidad)}</span></td>
            <td>${alertStatusBadge(alert.estado)}${alert.perfilAsignado ? `<small>${escapeHtml(alert.perfilAsignado)}</small>` : ''}</td>
            <td><span class="log-nowrap">${escapeHtml(formatDate(alert.fechaGeneracion))}</span></td>
          </tr>`;
      }).join('');

      const count = document.querySelector('#alert-count');
      if (count) count.textContent = String(alerts.length);
      const data = form ? new FormData(form) : null;
      const onlyDefault = !data || (String(data.get('estado')) === 'VIGENTES'
        && ['severidad', 'criticidad', 'dispositivoId', 'sedeId'].every((name) => !data.get(name)));
      const emptyText = document.querySelector('#alert-empty-text');
      if (emptyText) {
        emptyText.textContent = onlyDefault
          ? 'No hay alertas críticas pendientes.'
          : 'No se encontraron alertas con esos criterios.';
      }
      document.querySelector('#alert-empty')?.classList.toggle('is-hidden', alerts.length > 0);

      body.querySelectorAll<HTMLElement>('[data-alert-id]').forEach((row) => {
        const select = () => void selectAlert(Number(row.dataset.alertId));
        row.addEventListener('click', select);
        row.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            select();
          }
        });
      });
    };

    const manageFormHtml = (alert: CriticalAlert) => {
      if (alert.estado === 'CERRADA') {
        return '<p class="log-muted">La alerta está cerrada porque su hallazgo se resolvió o se aceptó el riesgo. Para reactivarla, reabrí el hallazgo.</p>';
      }
      if (!canManage) {
        return '<p class="log-muted">Tu perfil puede consultar la alerta, pero no derivarla.</p>';
      }
      const giveBack = alert.estado === 'EN_ATENCION'
        ? '<option value="ACTIVA">devolver a ACTIVA (sin asignar)</option>'
        : '';
      return `
        <form id="alert-form" class="tracking-form" novalidate>
          <label class="log-filter">
            <span>acción</span>
            <select id="alert-action" class="technical-select">
              <option value="ANALISTA_RED">derivar a ANALISTA_RED</option>
              <option value="AUDITOR_TECNICO">derivar a AUDITOR_TECNICO</option>
              ${giveBack}
            </select>
          </label>
          <label class="log-filter">
            <span id="alert-comment-label">comentario (opcional)</span>
            <textarea id="alert-comment" class="technical-input tracking-comment" rows="3" maxlength="1000"
              placeholder="Qué hay que revisar o por qué se devuelve..."></textarea>
          </label>
          <div id="alert-form-error" class="alert alert-error is-hidden"></div>
          <button class="button button-primary button-small button-full" type="submit">Actualizar alerta</button>
        </form>`;
    };

    const selectAlert = async (id: number) => {
      selectedId = id;
      render();
      const response = await auditFetch(`/api/alerts/${id}`);
      if (id !== selectedId) return;
      if (!response.ok) return showError(await readApiError(response));
      const detail = await response.json() as CriticalAlertDetail;
      if (id !== selectedId) return;
      const { alerta: alert, hallazgo: finding } = detail;

      document.querySelector('#alert-inspector-empty')?.classList.add('is-hidden');
      const content = document.querySelector<HTMLElement>('#alert-inspector-content');
      if (!content) return;
      content.innerHTML = `
        <div class="inspector-identity">
          <span class="inspector-code">${code('ALR', alert.id)} · ${escapeHtml(formatDate(alert.fechaGeneracion))}</span>
          <h3>${escapeHtml(finding?.nombreRegla ?? alert.nombreRegla ?? 'Hallazgo no disponible')}</h3>
          <div class="badge-row">
            <span class="severity-badge ${severityClass(alert.severidad)}">${escapeHtml(alert.severidad)}</span>
            ${alertStatusBadge(alert.estado)}
          </div>
        </div>
        ${finding ? '' : '<div class="alert alert-error">No se pudo obtener el hallazgo asociado; se muestra la información disponible.</div>'}
        <dl class="technical-definition-list">
          <div><dt>dispositivo</dt><dd>${escapeHtml(alert.dispositivoIdentificador ?? `#${alert.dispositivoId}`)} · criticidad ${escapeHtml(alert.criticidadDispositivo ?? '—')}</dd></div>
          <div><dt>sede</dt><dd>${escapeHtml(siteName(alert.sedeId))}</dd></div>
          <div><dt>hallazgo</dt><dd><a class="inline-link" href="/results?hallazgo=${alert.hallazgoId}">${code('FND', alert.hallazgoId)} →</a> ${finding ? findingStatusBadge(finding.estado) : ''}</dd></div>
          <div><dt>auditoría</dt><dd><a class="inline-link" href="/history?auditoria=${alert.auditoriaId}">${code('AUD', alert.auditoriaId)} →</a></dd></div>
          <div><dt>derivada a</dt><dd>${escapeHtml(alert.perfilAsignado ?? 'sin derivar')}</dd></div>
          <div><dt>último cambio</dt><dd>${alert.fechaEstado
            ? `${escapeHtml(formatDate(alert.fechaEstado))} · ${escapeHtml(alert.usuarioEstado)}`
            : 'sin cambios'}</dd></div>
        </dl>
        ${alert.comentario ? `<div class="rule-recommendation"><span>último comentario</span><p>${escapeHtml(alert.comentario)}</p></div>` : ''}
        ${finding ? `
        <div class="finding-evidence-block">
          <span>evidencia</span>
          <p>${escapeHtml(finding.evidencia)}</p>
        </div>
        ${finding.impacto ? `<div class="finding-evidence-block"><span>impacto</span><p>${escapeHtml(finding.impacto)}</p></div>` : ''}
        <div class="rule-recommendation">
          <span>recomendación</span>
          <p>${escapeHtml(finding.recomendacion)}</p>
        </div>` : ''}
        ${manageFormHtml(alert)}
      `;
      content.classList.remove('is-hidden');
      wireForm(alert);
    };

    const wireForm = (alert: CriticalAlert) => {
      const alertForm = document.querySelector<HTMLFormElement>('#alert-form');
      const action = document.querySelector<HTMLSelectElement>('#alert-action');
      const comment = document.querySelector<HTMLTextAreaElement>('#alert-comment');
      if (!alertForm || !action || !comment) return;

      const syncLabel = () => {
        const label = document.querySelector('#alert-comment-label');
        if (label) label.textContent = action.value === 'ACTIVA' ? 'motivo (obligatorio)' : 'comentario (opcional)';
      };
      action.addEventListener('change', syncLabel);
      syncLabel();

      alertForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        show('#alert-form-error', null);
        const giveBack = action.value === 'ACTIVA';
        if (giveBack && !comment.value.trim()) {
          show('#alert-form-error', 'Para devolver la alerta hay que indicar el motivo.');
          return;
        }
        const response = await auditFetch(`/api/alerts/${alert.id}/status`, jsonRequest('PATCH', {
          estado: giveBack ? 'ACTIVA' : 'EN_ATENCION',
          perfil: giveBack ? null : action.value,
          comentario: comment.value.trim() || null,
        }));
        if (!response.ok) {
          show('#alert-form-error', await readApiError(response));
          return;
        }
        const updated = await response.json() as CriticalAlertDetail;
        showSuccess(giveBack
          ? `${code('ALR', updated.alerta.id)} volvió a ACTIVA.`
          : `${code('ALR', updated.alerta.id)} derivada a ${updated.alerta.perfilAsignado}.`);
        await loadAlerts();
        await selectAlert(updated.alerta.id);
      });
    };

    const loadAlerts = async () => {
      showError(null);
      const query = buildQuery();
      const seq = ++loadSeq;
      // Las métricas muestran siempre el total vigente; la lista, lo filtrado.
      const [response, openResponse] = await Promise.all([
        auditFetch(`/api/alerts/critical${query}`),
        auditFetch('/api/alerts/critical'),
      ]);
      if (seq !== loadSeq) return;
      if (!response.ok) {
        showError(await readApiError(response));
        return;
      }
      const data = await response.json() as CriticalAlert[];
      const open = openResponse.ok ? await openResponse.json() as CriticalAlert[] : data;
      if (seq !== loadSeq) return;
      alerts = data;
      renderMetrics(open);
      render();
    };

    const loadReferences = async () => {
      const [deviceResponse, visibleSites] = await Promise.all([auditFetch('/api/devices'), loadVisibleSites()]);
      if (!deviceResponse.ok) throw new Error(await readApiError(deviceResponse));
      devices = await deviceResponse.json() as NetworkDevice[];
      sites = visibleSites;

      const deviceSelect = form?.querySelector<HTMLSelectElement>('[name=dispositivoId]');
      devices.forEach((device) => deviceSelect?.add(new Option(`${device.identificador} · ${device.nombre}`, String(device.id))));
      const siteSelect = form?.querySelector<HTMLSelectElement>('[name=sedeId]');
      sites.forEach((site) => siteSelect?.add(new Option(site.nombre, String(site.id))));

      // Filtros que llegan desde el tablero o la vista del cliente.
      const preset: Record<string, string | null> = {
        estado: params.get('estado'),
        severidad: params.get('severidad'),
        criticidad: params.get('criticidad'),
        dispositivoId: params.get('dispositivo'),
        sedeId: params.get('sede'),
      };
      for (const [name, value] of Object.entries(preset)) {
        const field = form?.querySelector<HTMLSelectElement>(`[name=${name}]`);
        if (field && value && Array.from(field.options).some((option) => option.value === value)) field.value = value;
      }
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      void loadAlerts();
    });
    document.querySelector('#alert-clear')?.addEventListener('click', () => {
      form?.reset();
      window.history.replaceState(null, '', window.location.pathname);
      void loadAlerts();
    });

    loadReferences()
      .then(loadAlerts)
      .then(() => {
        if (initialAlert) void selectAlert(initialAlert);
      })
      .catch((error) => showError(error instanceof Error ? error.message : 'No se pudieron cargar las alertas.'));
  </script>
</MasterLayout>
