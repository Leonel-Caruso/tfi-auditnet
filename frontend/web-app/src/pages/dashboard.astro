---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['tablero.titulo']} section={es['tablero.seccion']} description={es['tablero.descripcion']}
  i18n="tablero"
>
  <div id="dash-error" class="alert alert-error is-hidden" role="alert"></div>

  <section class="panel compact-panel dashboard-scope">
    <div>
      <span class="eyebrow" data-i18n="tablero.tableroControl">{es['tablero.tableroControl']}</span>
      <h2 id="dash-scope-title" data-i18n="tablero.estadoGeneral">{es['tablero.estadoGeneral']}</h2>
    </div>
    <div class="dashboard-scope-actions">
      <label class="log-filter" id="dash-org-filter" hidden>
        <span data-i18n="general.organizacion">{es['general.organizacion']}</span>
        <select id="dash-org" class="technical-select"><option value="" data-i18n="tablero.todasOrganizaciones">{es['tablero.todasOrganizaciones']}</option></select>
      </label>
      <a id="dash-client-link" class="button button-ghost button-small" href="/client-status" data-i18n="tablero.estadoSede">{es['tablero.estadoSede']}</a>
    </div>
  </section>

  <div id="dash-risk"></div>

  <section id="dash-kpis" class="metric-grid dashboard-kpis" aria-live="polite">
    <article class="metric-card"><span class="metric-label" data-i18n="general.cargando">{es['general.cargando']}</span><strong>—</strong><small data-i18n="general.consultando">{es['general.consultando']}</small></article>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="tablero.hallazgos">{es['tablero.hallazgos']}</span>
          <h2 data-i18n="tablero.hallazgosPendientesSeveridad">{es['tablero.hallazgosPendientesSeveridad']}</h2>
        </div>
      </div>
      <div id="dash-severity"></div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="tablero.evolucion">{es['tablero.evolucion']}</span>
          <h2 data-i18n="tablero.desviosSemana">{es['tablero.desviosSemana']}</h2>
        </div>
        <span class="technical-hint" data-i18n="tablero.ultimasSemanas">{es['tablero.ultimasSemanas']}</span>
      </div>
      <div id="dash-evolution"></div>
    </article>
  </section>

  <section class="two-column dashboard-row">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="tablero.operacion">{es['tablero.operacion']}</span>
          <h2 data-i18n="tablero.alertasVigentesTitulo">{es['tablero.alertasVigentesTitulo']}</h2>
        </div>
        <a class="inline-link" href="/alerts" data-i18n="tablero.verTodas">{es['tablero.verTodas']}</a>
      </div>
      <div id="dash-alerts"></div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="tablero.historico">{es['tablero.historico']}</span>
          <h2 data-i18n="tablero.auditoriasRecientes">{es['tablero.auditoriasRecientes']}</h2>
        </div>
        <a class="inline-link" href="/history" data-i18n="tablero.historial">{es['tablero.historial']}</a>
      </div>
      <div id="dash-recent"></div>
    </article>
  </section>

  <section class="panel dashboard-row">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="tablero.riesgo">{es['tablero.riesgo']}</span>
        <h2 data-i18n="tablero.dispositivosMayorRiesgo">{es['tablero.dispositivosMayorRiesgo']}</h2>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data-table log-table">
        <thead>
          <tr><th data-i18n="general.colDispositivo">{es['general.colDispositivo']}</th><th data-i18n="general.colSede">{es['general.colSede']}</th><th data-i18n="tablero.colCriticidad">{es['tablero.colCriticidad']}</th><th data-i18n="general.colRiesgo">{es['general.colRiesgo']}</th><th data-i18n="general.colPendientes">{es['general.colPendientes']}</th><th data-i18n="general.colAlertas">{es['general.colAlertas']}</th><th data-i18n="tablero.colUltimaAuditoria">{es['tablero.colUltimaAuditoria']}</th></tr>
        </thead>
        <tbody id="dash-risk-devices"></tbody>
      </table>
      <div id="dash-risk-empty" class="empty-state compact-empty is-hidden">
        <div><code data-i18n="tablero.sinRiesgo">{es['tablero.sinRiesgo']}</code><p data-i18n="tablero.hayDispositivosRiesgoAlto">{es['tablero.hayDispositivosRiesgoAlto']}</p></div>
      </div>
    </div>
  </section>

  <section class="metric-grid" data-admin-section hidden>
    <article class="metric-card">
      <span class="metric-label" data-i18n="tablero.organizaciones">{es['tablero.organizaciones']}</span>
      <strong id="metric-organizations">—</strong>
      <small data-i18n="tablero.clientesRegistrados">{es['tablero.clientesRegistrados']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="tablero.sedes">{es['tablero.sedes']}</span>
      <strong id="metric-sites">—</strong>
      <small data-i18n="tablero.sedesOperativasRegistradas">{es['tablero.sedesOperativasRegistradas']}</small>
    </article>
    <article class="metric-card">
      <span class="metric-label" data-i18n="tablero.usuarios">{es['tablero.usuarios']}</span>
      <strong id="metric-users">—</strong>
      <small data-i18n="tablero.accesosAdministradosRol">{es['tablero.accesosAdministradosRol']}</small>
    </article>
  </section>

  <script src="../scripts/dashboard.ts"></script>
</MasterLayout>
