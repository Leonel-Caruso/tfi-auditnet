---
import PublicLayout from '../layouts/PublicLayout.astro';
import AccessBrand from '../components/AccessBrand.astro';
import es from '../i18n/es';
---

<PublicLayout title={es['recuperar.metaTitulo']} tituloClave="recuperar.metaTitulo"
  description="Pedí un enlace para crear una contraseña nueva." path="/recover">
  <main class="login-screen">
    <AccessBrand titulo="recuperar.titular" texto="recuperar.bajada" />

    <section class="login-form-panel">
      <form id="recover-form" class="login-card" novalidate>
        <div class="login-card-heading">
          <span class="eyebrow" data-i18n="recuperar.seccion">{es['recuperar.seccion']}</span>
          <h2 data-i18n="recuperar.titulo">{es['recuperar.titulo']}</h2>
          <p data-i18n="recuperar.ayuda">{es['recuperar.ayuda']}</p>
        </div>

        <label class="field">
          <span data-i18n="login.identidad">{es['login.identidad']}</span>
          <input id="recover-identity" type="text" autocomplete="username" placeholder={es['login.identidadEjemplo']}
            data-i18n-placeholder="login.identidadEjemplo" maxlength="160" required autofocus />
        </label>

        <div id="recover-error" class="alert alert-error is-hidden" role="alert"></div>
        <div id="recover-done" class="alert alert-success is-hidden" role="status"></div>

        <button id="recover-submit" class="button button-primary button-full" type="submit"
          data-i18n="recuperar.enviar">{es['recuperar.enviar']}</button>
        <a class="login-link login-link-center" href="/login" data-i18n="recuperar.volver">{es['recuperar.volver']}</a>
      </form>
    </section>
  </main>

  <script>
    import { MANAGEMENT_API_URL, readApiError } from '../lib/api';
    import { idiomaActual, t } from '../lib/i18n';

    const form = document.querySelector<HTMLFormElement>('#recover-form');
    const errorBox = document.querySelector<HTMLElement>('#recover-error');
    const done = document.querySelector<HTMLElement>('#recover-done');
    const submit = document.querySelector<HTMLButtonElement>('#recover-submit');

    const fail = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove('is-hidden');
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('is-hidden');
      const identidad = document.querySelector<HTMLInputElement>('#recover-identity')?.value.trim();
      if (!identidad) return fail(t('recuperar.falta'));
      if (submit) submit.disabled = true;
      try {
        const response = await fetch(`${MANAGEMENT_API_URL}/api/auth/password-recovery`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept-Language': idiomaActual() },
          body: JSON.stringify({ identidad }),
        });
        if (!response.ok) throw new Error(await readApiError(response));
        // La respuesta es la misma exista o no la cuenta: el texto sale del diccionario.
        if (done) {
          done.textContent = t('recuperar.enviado');
          done.classList.remove('is-hidden');
        }
        if (submit) submit.textContent = t('recuperar.reenviar');
      } catch (error) {
        fail(error instanceof Error ? error.message : t('recuperar.error'));
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</PublicLayout>
