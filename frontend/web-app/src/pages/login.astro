---
import PublicLayout from '../layouts/PublicLayout.astro';
import { es } from '../i18n';
---

<PublicLayout
  title={es['login.metaTitulo']}
  tituloClave="login.metaTitulo"
  description="AuditNet: auditoría y control de configuraciones de red Cisco IOS/IOS-XE para organizaciones. Ingresá a la consola con tu usuario."
  indexable
  path="/login"
>
  <main class="login-screen">
    <section class="login-brand-panel">
      <div class="login-brand-content">
        <div class="hero-mark" id="hero-mark" role="img" aria-label="AuditNet">
          <span aria-hidden="true">A</span><span class="hero-mark-typed" aria-hidden="true"></span><span class="hero-mark-cursor" aria-hidden="true">_</span>
        </div>
        <span class="eyebrow eyebrow-light" data-i18n="acceso.tesis">{es['acceso.tesis']}</span>
        <h1 data-i18n="login.titular">{es['login.titular']}</h1>
        <p data-i18n="login.bajada">{es['login.bajada']}</p>

        <div class="login-terminal" aria-label={es['login.flujo']} data-i18n-aria-label="login.flujo">
          <div class="terminal-bar">
            <span class="terminal-dot is-accent"></span>
            <span class="terminal-dot"></span>
            <span class="terminal-dot"></span>
            <span>auditnet://pipeline</span>
          </div>
          <div class="terminal-lines">
            <span>source = <b>running-config</b></span>
            <span>policy = <b>baseline + rules</b></span>
            <span>engine = <b>audit</b></span>
            <span>output = <b>findings / trace</b></span>
          </div>
        </div>
      </div>
    </section>

    <section class="login-form-panel">
      <form id="login-form" class="login-card">
        <div class="login-card-heading">
          <span class="eyebrow" data-i18n="login.seccion">{es['login.seccion']}</span>
          <h2 data-i18n="login.titulo">{es['login.titulo']}</h2>
          <p data-i18n="login.ayuda">{es['login.ayuda']}</p>
        </div>

        <label class="field">
          <span data-i18n="login.identidad">{es['login.identidad']}</span>
          <input id="identity" name="identity" type="text" autocomplete="username" placeholder={es['login.identidadEjemplo']}
            data-i18n-placeholder="login.identidadEjemplo" required autofocus />
        </label>

        <label class="field">
          <span data-i18n="login.contrasena">{es['login.contrasena']}</span>
          <input id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required />
        </label>
        <a class="login-link" href="/recover" data-i18n="login.olvido">{es['login.olvido']}</a>

        <div id="login-error" class="alert alert-error is-hidden" role="alert"></div>

        <button id="login-button" class="button button-primary button-full" type="submit" data-i18n="login.ingresar">{es['login.ingresar']}</button>

        <div class="login-security-note">
          <span class="security-dot"></span>
          <span data-i18n="login.seguridad">{es['login.seguridad']}</span>
        </div>
      </form>
    </section>
  </main>

  <script src="../scripts/login.ts"></script>
</PublicLayout>
