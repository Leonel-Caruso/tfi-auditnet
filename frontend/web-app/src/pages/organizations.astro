---
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title="Organizaciones y sedes"
  section="Control de acceso"
  description="Registrá clientes y sus sedes. Al deshabilitarlos se conserva su historial."
>
  <section id="organization-access-error" class="alert alert-error is-hidden"></section>
  <section id="organization-message" class="alert is-hidden" role="status"></section>

  <section class="two-column two-column-wide">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">Organizaciones</span>
          <h2>Clientes registrados</h2>
        </div>
        <div class="panel-heading-actions">
          <span id="organization-count" class="counter-chip">—</span>
          <button id="open-organization-dialog" class="button button-primary button-small" type="button" data-admin-only="true">
            + organización
          </button>
        </div>
      </div>
      <div id="organization-list" class="select-list">
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
      </div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">Sedes asociadas</span>
          <h2 id="site-title">Seleccioná una organización</h2>
        </div>
        <div class="panel-heading-actions">
          <button id="edit-organization" class="button button-ghost button-small" type="button" disabled data-admin-only="true">Editar</button>
          <button id="toggle-organization" class="button button-ghost button-small" type="button" disabled data-admin-only="true">Deshabilitar</button>
          <button id="open-site-dialog" class="button button-primary button-small" type="button" disabled
            data-roles="ADMINISTRADOR_SISTEMA,ADMINISTRADOR_ORGANIZACION">
            + sede
          </button>
        </div>
      </div>
      <p id="organization-disabled-note" class="alert alert-error is-hidden" style="margin-bottom: 14px;">
        Organización deshabilitada: sus usuarios no pueden ingresar ni operar y no se le agregan sedes. Sus datos e historial se conservan.
      </p>
      <div id="site-list" class="data-list empty-state">
        <p>Elegí una organización para consultar sus sedes.</p>
      </div>
    </article>
  </section>

  <section class="panel" id="plan-panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow">Plan</span>
        <h2>Plan y uso</h2>
      </div>
      <div class="panel-heading-actions">
        <a class="inline-link" href="/plan" data-roles="ADMINISTRADOR_ORGANIZACION">ver Mi plan →</a>
        <button id="change-plan" class="button button-ghost button-small" type="button" disabled data-admin-only="true">
          Cambiar plan
        </button>
      </div>
    </div>
    <div id="plan-summary" class="plan-summary"><div class="skeleton-row"></div></div>
  </section>

  <section class="panel" id="review-panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow">Revisión periódica</span>
        <h2>Plazos de revisión</h2>
      </div>
      <span id="review-updated" class="counter-chip">—</span>
    </div>
    <form id="review-form" novalidate>
      <fieldset id="review-fields" class="plain-fieldset">
        <div class="review-grid">
          <label class="field"><span>crítica · días</span><input id="review-critica" type="number" min="1" max="365" required /></label>
          <label class="field"><span>alta · días</span><input id="review-alta" type="number" min="1" max="365" required /></label>
          <label class="field"><span>media · días</span><input id="review-media" type="number" min="1" max="365" required /></label>
          <label class="field"><span>baja · días</span><input id="review-baja" type="number" min="1" max="365" required /></label>
          <label class="field"><span>re-auditar cada · días</span><input id="review-reaudit" type="number" min="1" max="365" required /></label>
          <label class="field"><span>configuración vieja a los · días</span><input id="review-config" type="number" min="1" max="365" required /></label>
        </div>
        <p class="technical-hint">
          Un hallazgo pendiente vence cuando pasan los días de su severidad desde que se detectó. La revisión diaria
          avisa por correo los vencidos y los equipos sin configuración nueva, una sola vez cada uno.
        </p>
        <label class="role-check review-auto">
          <input id="review-auto" type="checkbox" />
          <strong>Re-auditar automáticamente</strong>
          <small>Vuelve a auditar la última configuración de los equipos cuya última auditoría superó el plazo.</small>
        </label>
      </fieldset>
      <div id="review-error" class="alert alert-error is-hidden"></div>
      <div class="review-actions">
        <button id="review-submit" class="button button-primary button-small" type="submit" disabled
          data-roles="ADMINISTRADOR_SISTEMA,ADMINISTRADOR_ORGANIZACION">Guardar plazos</button>
      </div>
    </form>
  </section>

  <dialog id="organization-dialog" class="technical-dialog">
    <form id="organization-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" id="organization-dialog-eyebrow">Alta de organización</span>
          <h2 id="organization-dialog-title">Registrar organización</h2>
          <p id="organization-dialog-help">Incorporá un cliente a la plataforma.</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field">
          <span>identificador *</span>
          <input id="organization-identifier" type="text" maxlength="80" placeholder="CLIENTE-NORTE" required />
        </label>
        <label class="field">
          <span>razón social *</span>
          <input id="organization-name" type="text" maxlength="160" placeholder="Cliente Norte SA" required />
        </label>
        <label class="field" data-plan-choice>
          <span>plan inicial *</span>
          <select id="organization-plan" class="form-select" data-plan-select></select>
        </label>
        <label class="field" data-plan-trial>
          <span>días de prueba (60 a 90)</span>
          <input id="organization-trial-days" type="number" min="60" max="90" value="90" data-plan-days />
        </label>
        <label class="field" data-plan-custom>
          <span>dispositivos acordados *</span>
          <input id="organization-limit-devices" type="number" min="1" data-plan-devices />
        </label>
        <label class="field" data-plan-custom>
          <span>usuarios acordados *</span>
          <input id="organization-limit-users" type="number" min="1" data-plan-users />
        </label>
        <div class="device-form-context field-span-2">
          <code id="organization-dialog-state">estado = ACTIVO</code>
          <span>El identificador se guarda en mayúsculas y debe ser único, igual que la razón social.</span>
        </div>
      </div>

      <div id="organization-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog>Cancelar</button>
        <button id="organization-submit" class="button button-primary" type="submit">Registrar organización</button>
      </div>
    </form>
  </dialog>

  <dialog id="plan-dialog" class="technical-dialog" style="width: min(620px, calc(100vw - 32px));">
    <form id="plan-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow">Plan</span>
          <h2 id="plan-dialog-title">Cambiar plan</h2>
          <p>Se aplica en el acto. Si la organización usa más dispositivos o usuarios que el plan nuevo, el cambio se rechaza.</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar">×</button>
      </div>
      <div class="device-form-grid">
        <label class="field field-span-2">
          <span>plan *</span>
          <select id="plan-code" class="form-select" data-plan-select></select>
        </label>
        <label class="field" data-plan-trial>
          <span>días de prueba (60 a 90)</span>
          <input id="plan-trial-days" type="number" min="60" max="90" value="90" data-plan-days />
        </label>
        <label class="field" data-plan-custom>
          <span>dispositivos acordados *</span>
          <input id="plan-limit-devices" type="number" min="1" data-plan-devices />
        </label>
        <label class="field" data-plan-custom>
          <span>usuarios acordados *</span>
          <input id="plan-limit-users" type="number" min="1" data-plan-users />
        </label>
      </div>
      <div id="plan-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog>Cancelar</button>
        <button class="button button-primary" type="submit">Aplicar plan</button>
      </div>
    </form>
  </dialog>

  <dialog id="site-dialog" class="technical-dialog">
    <form id="site-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" id="site-dialog-eyebrow">Alta de sede</span>
          <h2 id="site-dialog-title">Registrar sede</h2>
          <p id="site-dialog-context">Sede de la organización seleccionada.</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field">
          <span>nombre *</span>
          <input id="site-name" type="text" maxlength="120" placeholder="Sede Central" required />
        </label>
        <label class="field">
          <span>ubicación *</span>
          <input id="site-location" type="text" maxlength="200" placeholder="Av. Siempre Viva 123, CABA" required />
        </label>
      </div>

      <div id="site-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog>Cancelar</button>
        <button id="site-submit" class="button button-primary" type="submit">Registrar sede</button>
      </div>
    </form>
  </dialog>

  <dialog id="org-confirm-dialog" class="technical-dialog" style="width: min(480px, calc(100vw - 32px));">
    <form method="dialog" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow">Confirmar</span>
          <h2 id="org-confirm-title">¿Confirmás la operación?</h2>
          <p id="org-confirm-text"></p>
        </div>
      </div>
      <div class="dialog-actions">
        <button class="button button-ghost" value="cancel">Cancelar</button>
        <button id="org-confirm-accept" class="button button-primary" value="ok">Confirmar</button>
      </div>
    </form>
  </dialog>

  <script>
    import { auditFetch, authFetch, hasRole } from '../lib/auth';
    import { jsonRequest, readApiError, type Organization, type OrganizationPlan, type Plan, type ReviewPolicy, type Site } from '../lib/api';
    import { escapeHtml, formatDate } from '../lib/format';
    import { formatDay, formatPrice, isCustomPlan, limitsText, isTrialPlan, requestStatusBadge, usageRow, validityText } from '../lib/plans';

    const orgList = document.querySelector<HTMLDivElement>('#organization-list');
    const orgCount = document.querySelector<HTMLSpanElement>('#organization-count');
    const siteList = document.querySelector<HTMLDivElement>('#site-list');
    const siteTitle = document.querySelector<HTMLHeadingElement>('#site-title');
    const accessError = document.querySelector<HTMLElement>('#organization-access-error');
    const message = document.querySelector<HTMLElement>('#organization-message');
    const openSiteButton = document.querySelector<HTMLButtonElement>('#open-site-dialog');
    const organizationDialog = document.querySelector<HTMLDialogElement>('#organization-dialog');
    const siteDialog = document.querySelector<HTMLDialogElement>('#site-dialog');

    let selectedOrganization: Organization | null = null;
    let editingOrganization: Organization | null = null;
    let editingSite: Site | null = null;
    let currentSites: Site[] = [];
    const isAdmin = hasRole('ADMINISTRADOR_SISTEMA');
    const canManageSites = isAdmin || hasRole('ADMINISTRADOR_ORGANIZACION');
    let catalog: Plan[] = [];
    const confirmDialog = document.querySelector<HTMLDialogElement>('#org-confirm-dialog');

    const confirmAction = (title: string, text: string, accept: string) => new Promise<boolean>((resolve) => {
      if (!confirmDialog) return resolve(false);
      document.querySelector('#org-confirm-title')!.textContent = title;
      document.querySelector('#org-confirm-text')!.textContent = text;
      document.querySelector('#org-confirm-accept')!.textContent = accept;
      confirmDialog.returnValue = 'cancel';
      confirmDialog.addEventListener('close', () => resolve(confirmDialog.returnValue === 'ok'), { once: true });
      confirmDialog.showModal();
    });

    const statusClass = (estado: string) => (estado === 'ACTIVO' ? 'status-ready' : 'status-off');

    function showError(text: string): void {
      if (!accessError) return;
      accessError.textContent = text;
      accessError.classList.remove('is-hidden');
    }

    function showMessage(text: string): void {
      if (!message) return;
      accessError?.classList.add('is-hidden');
      message.textContent = text;
      message.className = 'alert alert-success';
      window.setTimeout(() => message.classList.add('is-hidden'), 4200);
    }

    function showFormError(selector: string, text: string | null): void {
      const node = document.querySelector<HTMLElement>(selector);
      if (!node) return;
      node.textContent = text ?? '';
      node.classList.toggle('is-hidden', !text);
    }

    function inputValue(selector: string): string {
      return (document.querySelector<HTMLInputElement>(selector)?.value ?? '').trim();
    }

    function buildSiteRow(site: Site): HTMLDivElement {
      const row = document.createElement('div');
      row.className = 'data-row';

      const copy = document.createElement('div');
      const name = document.createElement('strong');
      name.textContent = site.nombre;
      const location = document.createElement('span');
      location.textContent = site.ubicacion;
      copy.append(name, location);

      const status = document.createElement('span');
      status.className = `status-badge ${statusClass(site.estado)}`;
      status.textContent = site.estado.toLowerCase();

      const side = document.createElement('div');
      side.className = 'inline-actions';
      side.append(status);
      if (canManageSites) {
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'button button-ghost button-small';
        edit.textContent = 'Editar';
        edit.addEventListener('click', () => openSiteDialog(site));
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'button button-ghost button-small';
        toggle.textContent = site.estado === 'ACTIVO' ? 'Deshabilitar' : 'Habilitar';
        toggle.addEventListener('click', () => void toggleSite(site));
        side.append(edit, toggle);
      }

      row.append(copy, side);
      return row;
    }

    function syncOrganizationActions(organization: Organization): void {
      const active = organization.estado === 'ACTIVO';
      if (openSiteButton) openSiteButton.disabled = !active;
      const edit = document.querySelector<HTMLButtonElement>('#edit-organization');
      const toggle = document.querySelector<HTMLButtonElement>('#toggle-organization');
      if (edit) edit.disabled = false;
      if (toggle) {
        toggle.disabled = false;
        toggle.textContent = active ? 'Deshabilitar' : 'Habilitar';
      }
      document.querySelector('#organization-disabled-note')?.classList.toggle('is-hidden', active);
    }

    // Plan de la organización seleccionada
    function fillPlanSelect(select: HTMLSelectElement | null, current?: string): void {
      if (!select) return;
      select.replaceChildren(...catalog.map((plan) => new Option(
        `${plan.nombre} · ${limitsText(plan)} · ${formatPrice(plan)}`,
        plan.codigo)));
      if (current) select.value = current;
    }

    /** Muestra días de prueba o límites acordados según el plan elegido en el diálogo. */
    function syncPlanFields(form: HTMLElement): void {
      const code = form.querySelector<HTMLSelectElement>('[data-plan-select]')?.value;
      const plan = catalog.find((item) => item.codigo === code);
      const editingExisting = form.id === 'organization-form' && editingOrganization !== null;
      form.querySelectorAll<HTMLElement>('[data-plan-choice]').forEach((node) => node.classList.toggle('is-hidden', editingExisting));
      form.querySelectorAll<HTMLElement>('[data-plan-trial]').forEach((node) =>
        node.classList.toggle('is-hidden', editingExisting || !plan || !isTrialPlan(plan)));
      form.querySelectorAll<HTMLElement>('[data-plan-custom]').forEach((node) =>
        node.classList.toggle('is-hidden', editingExisting || !plan || !isCustomPlan(plan)));
    }

    function planPayload(form: HTMLElement) {
      const number = (selector: string) => {
        const input = form.querySelector<HTMLInputElement>(selector);
        return input && !input.closest('.is-hidden') && input.value !== '' ? Number(input.value) : null;
      };
      return {
        plan: form.querySelector<HTMLSelectElement>('[data-plan-select]')?.value ?? '',
        diasPrueba: number('[data-plan-days]'),
        limiteDispositivos: number('[data-plan-devices]'),
        limiteUsuarios: number('[data-plan-users]'),
      };
    }

    let currentPlan: OrganizationPlan | null = null;

    async function loadPlan(organization: Organization): Promise<void> {
      const summary = document.querySelector<HTMLElement>('#plan-summary');
      const changeButton = document.querySelector<HTMLButtonElement>('#change-plan');
      if (changeButton) changeButton.disabled = true;
      const response = await authFetch(`/api/client-organizations/${organization.id}/plan`);
      if (!summary) return;
      if (!response.ok) {
        summary.innerHTML = `<div class="alert alert-error">${escapeHtml(await readApiError(response))}</div>`;
        return;
      }
      currentPlan = await response.json() as OrganizationPlan;
      const pending = currentPlan.solicitudPendiente;
      summary.innerHTML = `
        <div class="plan-summary-head">
          <h3>${escapeHtml(currentPlan.plan.nombre)}</h3>
          <code>${escapeHtml(formatPrice(currentPlan.plan))} · desde ${escapeHtml(formatDay(currentPlan.desde))}</code>
        </div>
        <p class="plan-validity ${currentPlan.vencido ? 'is-expired' : ''}">${escapeHtml(validityText(currentPlan))}</p>
        ${usageRow('Dispositivos activos', currentPlan.dispositivosActivos, currentPlan.maxDispositivos)}
        ${usageRow('Usuarios activos', currentPlan.usuariosActivos, currentPlan.maxUsuarios)}
        ${pending ? `<p class="log-muted">Solicitud ${requestStatusBadge(pending.estado)} de cambio a <strong>${escapeHtml(catalog.find((plan) => plan.codigo === pending.planSolicitado)?.nombre ?? pending.planSolicitado)}</strong> (${escapeHtml(pending.solicitadoPor)}).${isAdmin ? ' <a class="inline-link" href="/plans">resolver →</a>' : ''}</p>` : ''}`;
      if (changeButton) changeButton.disabled = false;
    }

    // Plazos de revisión (audit-core-service)
    const canEditReview = canManageSites;
    const reviewInputs: Record<keyof Omit<ReviewPolicy, 'reauditoriaAutomatica' | 'modificadaEn' | 'modificadaPor'>, string> = {
      diasCritica: '#review-critica',
      diasAlta: '#review-alta',
      diasMedia: '#review-media',
      diasBaja: '#review-baja',
      diasReauditoria: '#review-reaudit',
      diasConfiguracion: '#review-config',
    };
    const reviewFields = document.querySelector<HTMLFieldSetElement>('#review-fields');
    const reviewSubmit = document.querySelector<HTMLButtonElement>('#review-submit');

    function renderReview(policy: ReviewPolicy): void {
      (Object.entries(reviewInputs) as [keyof typeof reviewInputs, string][]).forEach(([key, selector]) => {
        document.querySelector<HTMLInputElement>(selector)!.value = String(policy[key]);
      });
      document.querySelector<HTMLInputElement>('#review-auto')!.checked = policy.reauditoriaAutomatica;
      const updated = document.querySelector('#review-updated');
      if (updated) {
        updated.textContent = policy.modificadaEn
          ? `${formatDate(policy.modificadaEn)} · ${policy.modificadaPor ?? ''}`
          : 'valores por defecto';
      }
    }

    async function loadReview(organization: Organization): Promise<void> {
      showFormError('#review-error', null);
      if (reviewFields) reviewFields.disabled = true;
      if (reviewSubmit) reviewSubmit.disabled = true;
      const response = await auditFetch(`/api/client-organizations/${organization.id}/review-policy`);
      if (!response.ok) return showFormError('#review-error', await readApiError(response));
      renderReview(await response.json() as ReviewPolicy);
      const editable = canEditReview && organization.estado === 'ACTIVO';
      if (reviewFields) reviewFields.disabled = !editable;
      if (reviewSubmit) reviewSubmit.disabled = !editable;
    }

    document.querySelector<HTMLFormElement>('#review-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const organization = selectedOrganization;
      if (!organization) return;
      showFormError('#review-error', null);
      const payload: Record<string, number | boolean> = {
        reauditoriaAutomatica: document.querySelector<HTMLInputElement>('#review-auto')!.checked,
      };
      for (const [key, selector] of Object.entries(reviewInputs)) {
        const value = Number(document.querySelector<HTMLInputElement>(selector)!.value);
        if (!Number.isInteger(value) || value < 1 || value > 365) {
          return showFormError('#review-error', 'Cada plazo debe ser un número de días entre 1 y 365.');
        }
        payload[key] = value;
      }
      const response = await auditFetch(`/api/client-organizations/${organization.id}/review-policy`,
        jsonRequest('PUT', payload));
      if (!response.ok) return showFormError('#review-error', await readApiError(response));
      renderReview(await response.json() as ReviewPolicy);
      showMessage(`Plazos de revisión de ${organization.razonSocial} guardados.`);
    });

    async function loadSites(organization: Organization): Promise<void> {
      selectedOrganization = organization;
      syncOrganizationActions(organization);
      void loadPlan(organization);
      void loadReview(organization);
      if (siteTitle) siteTitle.textContent = organization.razonSocial;
      if (siteList) {
        siteList.className = 'data-list';
        const skeleton = document.createElement('div');
        skeleton.className = 'skeleton-row';
        siteList.replaceChildren(skeleton);
      }

      const response = await authFetch(`/api/client-organizations/${organization.id}/sites`);
      if (!response.ok) {
        if (siteList) {
          const error = document.createElement('div');
          error.className = 'alert alert-error';
          error.textContent = await readApiError(response);
          siteList.replaceChildren(error);
        }
        return;
      }

      const sites = await response.json() as Site[];
      currentSites = sites;
      if (!siteList) return;

      siteList.replaceChildren();
      if (sites.length === 0) {
        siteList.className = 'data-list empty-state';
        const empty = document.createElement('p');
        empty.textContent = 'Esta organización todavía no tiene sedes registradas.';
        siteList.appendChild(empty);
        return;
      }

      siteList.className = 'data-list';
      sites.forEach((site) => siteList.appendChild(buildSiteRow(site)));
    }

    function buildOrganizationButton(organization: Organization): HTMLButtonElement {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'select-row';
      button.dataset.organizationId = String(organization.id);

      const copy = document.createElement('span');
      copy.className = 'select-row-main';
      const name = document.createElement('strong');
      name.textContent = organization.razonSocial;
      const identifier = document.createElement('small');
      identifier.textContent = organization.identificador;
      copy.append(name, identifier);

      const status = document.createElement('span');
      status.className = `status-badge ${statusClass(organization.estado)}`;
      status.textContent = organization.estado.toLowerCase();
      button.append(copy, status);

      button.addEventListener('click', () => {
        document.querySelectorAll('.select-row').forEach((node) => node.classList.remove('is-selected'));
        button.classList.add('is-selected');
        void loadSites(organization);
      });

      return button;
    }

    async function loadOrganizations(selectId?: number): Promise<void> {
      const response = await authFetch('/api/client-organizations');
      if (!response.ok) {
        showError(await readApiError(response));
        orgList?.replaceChildren();
        return;
      }

      const organizations = await response.json() as Organization[];
      if (orgCount) orgCount.textContent = String(organizations.length);
      if (!orgList) return;

      const buttons = organizations.map(buildOrganizationButton);
      orgList.replaceChildren(...buttons);
      const toSelect = buttons.find((button) => Number(button.dataset.organizationId) === selectId) ?? buttons[0];
      toSelect?.click();
    }

    // Diálogos
    document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
      button.addEventListener('click', () => button.closest('dialog')?.close());
    });

    function openOrganizationDialog(organization: Organization | null): void {
      editingOrganization = organization;
      document.querySelector<HTMLFormElement>('#organization-form')?.reset();
      showFormError('#organization-form-error', null);
      const text = (selector: string, value: string) => {
        const node = document.querySelector(selector);
        if (node) node.textContent = value;
      };
      text('#organization-dialog-eyebrow', organization ? 'Modificar organización' : 'Alta de organización');
      text('#organization-dialog-title', organization ? organization.razonSocial : 'Registrar organización');
      text('#organization-dialog-help', organization
        ? 'El identificador y la razón social siguen siendo únicos en la plataforma.'
        : 'Incorporá un cliente a la plataforma.');
      text('#organization-dialog-state', `estado = ${organization?.estado ?? 'ACTIVO'}`);
      text('#organization-submit', organization ? 'Guardar cambios' : 'Registrar organización');
      if (organization) {
        document.querySelector<HTMLInputElement>('#organization-identifier')!.value = organization.identificador;
        document.querySelector<HTMLInputElement>('#organization-name')!.value = organization.razonSocial;
      }
      const form = document.querySelector<HTMLFormElement>('#organization-form');
      fillPlanSelect(document.querySelector('#organization-plan'), 'PILOTO');
      if (form) syncPlanFields(form);
      organizationDialog?.showModal();
    }

    function openSiteDialog(site: Site | null): void {
      if (!selectedOrganization) return;
      editingSite = site;
      document.querySelector<HTMLFormElement>('#site-form')?.reset();
      showFormError('#site-form-error', null);
      const text = (selector: string, value: string) => {
        const node = document.querySelector(selector);
        if (node) node.textContent = value;
      };
      text('#site-dialog-eyebrow', site ? 'Modificar sede' : 'Alta de sede');
      text('#site-dialog-title', site ? site.nombre : 'Registrar sede');
      text('#site-dialog-context', site
        ? `Sede de ${selectedOrganization.razonSocial}. El nombre sigue siendo único dentro de la organización.`
        : `Nueva sede de ${selectedOrganization.razonSocial}.`);
      text('#site-submit', site ? 'Guardar cambios' : 'Registrar sede');
      if (site) {
        document.querySelector<HTMLInputElement>('#site-name')!.value = site.nombre;
        document.querySelector<HTMLInputElement>('#site-location')!.value = site.ubicacion;
      }
      siteDialog?.showModal();
    }

    async function toggleSite(site: Site): Promise<void> {
      if (!selectedOrganization) return;
      const disable = site.estado === 'ACTIVO';
      const accepted = await confirmAction(
        disable ? `Deshabilitar la sede ${site.nombre}` : `Habilitar la sede ${site.nombre}`,
        disable
          ? 'No se le podrán asignar dispositivos nuevos. Los dispositivos que ya tiene conservan su historial.'
          : 'Vuelve a estar disponible para asignar dispositivos.',
        disable ? 'Deshabilitar' : 'Habilitar');
      if (!accepted) return;
      const response = await authFetch(`/api/sites/${site.id}/status`, jsonRequest('PATCH', { estado: disable ? 'DESHABILITADO' : 'ACTIVO' }));
      if (!response.ok) return showError(await readApiError(response));
      showMessage(`Sede ${site.nombre} ${disable ? 'deshabilitada' : 'habilitada'}.`);
      await loadSites(selectedOrganization);
    }

    document.querySelector('#open-organization-dialog')?.addEventListener('click', () => openOrganizationDialog(null));
    document.querySelector('#edit-organization')?.addEventListener('click', () => {
      if (selectedOrganization) openOrganizationDialog(selectedOrganization);
    });
    openSiteButton?.addEventListener('click', () => openSiteDialog(null));

    document.querySelector('#toggle-organization')?.addEventListener('click', async () => {
      const organization = selectedOrganization;
      if (!organization) return;
      const disable = organization.estado === 'ACTIVO';
      const accepted = await confirmAction(
        disable ? `Deshabilitar ${organization.razonSocial}` : `Habilitar ${organization.razonSocial}`,
        disable
          ? `Sus usuarios no van a poder ingresar y las sesiones abiertas se cierran en el acto. Sus ${currentSites.length} sedes, dispositivos, auditorías y reportes se conservan.`
          : 'Sus usuarios activos vuelven a poder ingresar.',
        disable ? 'Deshabilitar' : 'Habilitar');
      if (!accepted) return;
      const response = await authFetch(`/api/client-organizations/${organization.id}/status`,
        jsonRequest('PATCH', { estado: disable ? 'DESHABILITADO' : 'ACTIVO' }));
      if (!response.ok) return showError(await readApiError(response));
      showMessage(`Organización ${organization.razonSocial} ${disable ? 'deshabilitada' : 'habilitada'}.`);
      await loadOrganizations(organization.id);
    });

    document.querySelector<HTMLFormElement>('#organization-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      showFormError('#organization-form-error', null);
      const payload = {
        identificador: inputValue('#organization-identifier'),
        razonSocial: inputValue('#organization-name'),
      };
      const form = document.querySelector<HTMLFormElement>('#organization-form')!;
      const response = editingOrganization
        ? await authFetch(`/api/client-organizations/${editingOrganization.id}`, jsonRequest('PUT', payload))
        : await authFetch('/api/client-organizations', jsonRequest('POST', { ...payload, ...planPayload(form) }));
      if (!response.ok) {
        showFormError('#organization-form-error', await readApiError(response));
        return;
      }
      const saved = await response.json() as Organization;
      organizationDialog?.close();
      showMessage(editingOrganization
        ? `Organización ${saved.razonSocial} actualizada.`
        : `Organización ${saved.razonSocial} registrada correctamente.`);
      await loadOrganizations(saved.id);
    });

    document.querySelector<HTMLFormElement>('#site-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!selectedOrganization) return;
      showFormError('#site-form-error', null);
      const organization = selectedOrganization;
      const payload = {
        nombre: inputValue('#site-name'),
        ubicacion: inputValue('#site-location'),
      };
      const response = editingSite
        ? await authFetch(`/api/sites/${editingSite.id}`, jsonRequest('PUT', payload))
        : await authFetch(`/api/client-organizations/${organization.id}/sites`, jsonRequest('POST', payload));
      if (!response.ok) {
        showFormError('#site-form-error', await readApiError(response));
        return;
      }
      const saved = await response.json() as Site;
      siteDialog?.close();
      showMessage(editingSite
        ? `Sede ${saved.nombre} actualizada.`
        : `Sede ${saved.nombre} registrada en ${organization.razonSocial}.`);
      await loadSites(organization);
    });

    // Cambio de plan (administrador del sistema)
    const planDialog = document.querySelector<HTMLDialogElement>('#plan-dialog');
    document.querySelectorAll<HTMLSelectElement>('[data-plan-select]').forEach((select) => {
      select.addEventListener('change', () => syncPlanFields(select.closest('form')!));
    });

    document.querySelector('#change-plan')?.addEventListener('click', () => {
      if (!selectedOrganization || !currentPlan) return;
      const form = document.querySelector<HTMLFormElement>('#plan-form')!;
      form.reset();
      showFormError('#plan-form-error', null);
      document.querySelector('#plan-dialog-title')!.textContent = `Plan de ${selectedOrganization.razonSocial}`;
      fillPlanSelect(document.querySelector('#plan-code'), currentPlan.plan.codigo);
      if (isCustomPlan(currentPlan.plan)) {
        document.querySelector<HTMLInputElement>('#plan-limit-devices')!.value = String(currentPlan.maxDispositivos ?? '');
        document.querySelector<HTMLInputElement>('#plan-limit-users')!.value = String(currentPlan.maxUsuarios ?? '');
      }
      syncPlanFields(form);
      planDialog?.showModal();
    });

    document.querySelector<HTMLFormElement>('#plan-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const organization = selectedOrganization;
      if (!organization) return;
      showFormError('#plan-form-error', null);
      const response = await authFetch(`/api/client-organizations/${organization.id}/plan`,
        jsonRequest('PUT', planPayload(event.currentTarget as HTMLFormElement)));
      if (!response.ok) return showFormError('#plan-form-error', await readApiError(response));
      planDialog?.close();
      const updated = await response.json() as OrganizationPlan;
      showMessage(`${organization.razonSocial} pasó al plan ${updated.plan.nombre}.`);
      await loadPlan(organization);
    });

    async function loadCatalog(): Promise<void> {
      const response = await authFetch('/api/plans');
      if (response.ok) catalog = await response.json() as Plan[];
    }

    loadCatalog()
      .then(() => loadOrganizations())
      .catch(() => showError('No se pudo cargar la información de organizaciones y sedes.'));
  </script>
</MasterLayout>
