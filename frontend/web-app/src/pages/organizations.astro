---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['organizaciones.titulo']} section={es['organizaciones.seccion']} description={es['organizaciones.descripcion']}
  i18n="organizaciones"
>
  <section id="organization-access-error" class="alert alert-error is-hidden"></section>
  <section id="organization-message" class="alert is-hidden" role="status"></section>

  <section class="two-column two-column-wide">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="organizaciones.organizaciones">{es['organizaciones.organizaciones']}</span>
          <h2 data-i18n="organizaciones.clientesRegistrados">{es['organizaciones.clientesRegistrados']}</h2>
        </div>
        <div class="panel-heading-actions">
          <span id="organization-count" class="counter-chip">—</span>
          <button id="open-organization-dialog" class="button button-primary button-small" type="button" data-admin-only="true" data-i18n="organizaciones.nuevaOrganizacion">{es['organizaciones.nuevaOrganizacion']}</button>
        </div>
      </div>
      <div id="organization-list" class="select-list">
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
      </div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="organizaciones.sedesAsociadas">{es['organizaciones.sedesAsociadas']}</span>
          <h2 id="site-title" data-i18n="organizaciones.seleccionaOrganizacion">{es['organizaciones.seleccionaOrganizacion']}</h2>
        </div>
        <div class="panel-heading-actions">
          <button id="edit-organization" class="button button-ghost button-small" type="button" disabled data-admin-only="true" data-i18n="general.editar">{es['general.editar']}</button>
          <button id="toggle-organization" class="button button-ghost button-small" type="button" disabled data-admin-only="true" data-i18n="organizaciones.deshabilitar">{es['organizaciones.deshabilitar']}</button>
          <button id="open-site-dialog" class="button button-primary button-small" type="button" disabled
            data-roles="ADMINISTRADOR_SISTEMA,ADMINISTRADOR_ORGANIZACION" data-i18n="organizaciones.nuevaSede">{es['organizaciones.nuevaSede']}</button>
        </div>
      </div>
      <p id="organization-disabled-note" class="alert alert-error is-hidden" style="margin-bottom: 14px;" data-i18n="organizaciones.organizacionDeshabilitadaUsuariosPueden">{es['organizaciones.organizacionDeshabilitadaUsuariosPueden']}</p>
      <div id="site-list" class="data-list empty-state">
        <p data-i18n="organizaciones.elegiOrganizacionConsultarSedes">{es['organizaciones.elegiOrganizacionConsultarSedes']}</p>
      </div>
    </article>
  </section>

  <section class="panel" id="plan-panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="organizaciones.plan">{es['organizaciones.plan']}</span>
        <h2 data-i18n="organizaciones.planUso">{es['organizaciones.planUso']}</h2>
      </div>
      <div class="panel-heading-actions">
        <a class="inline-link" href="/plan" data-roles="ADMINISTRADOR_ORGANIZACION" data-i18n="organizaciones.verMiPlan">{es['organizaciones.verMiPlan']}</a>
        <button id="change-plan" class="button button-ghost button-small" type="button" disabled data-admin-only="true" data-i18n="organizaciones.cambiarPlan">{es['organizaciones.cambiarPlan']}</button>
      </div>
    </div>
    <div id="plan-summary" class="plan-summary"><div class="skeleton-row"></div></div>
  </section>

  <section class="panel" id="review-panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="organizaciones.revisionPeriodica">{es['organizaciones.revisionPeriodica']}</span>
        <h2 data-i18n="organizaciones.plazosRevision">{es['organizaciones.plazosRevision']}</h2>
      </div>
      <span id="review-updated" class="counter-chip">—</span>
    </div>
    <form id="review-form" novalidate>
      <fieldset id="review-fields" class="plain-fieldset">
        <div class="review-grid">
          <label class="field"><span data-i18n="organizaciones.criticaDias">{es['organizaciones.criticaDias']}</span><input id="review-critica" type="number" min="1" max="365" required /></label>
          <label class="field"><span data-i18n="organizaciones.altaDias">{es['organizaciones.altaDias']}</span><input id="review-alta" type="number" min="1" max="365" required /></label>
          <label class="field"><span data-i18n="organizaciones.mediaDias">{es['organizaciones.mediaDias']}</span><input id="review-media" type="number" min="1" max="365" required /></label>
          <label class="field"><span data-i18n="organizaciones.bajaDias">{es['organizaciones.bajaDias']}</span><input id="review-baja" type="number" min="1" max="365" required /></label>
          <label class="field"><span data-i18n="organizaciones.reAuditarCadaDias">{es['organizaciones.reAuditarCadaDias']}</span><input id="review-reaudit" type="number" min="1" max="365" required /></label>
          <label class="field"><span data-i18n="organizaciones.configuracionViejaDias">{es['organizaciones.configuracionViejaDias']}</span><input id="review-config" type="number" min="1" max="365" required /></label>
        </div>
        <p class="technical-hint" data-i18n="organizaciones.hallazgoPendienteVenceCuando">{es['organizaciones.hallazgoPendienteVenceCuando']}</p>
        <label class="role-check review-auto">
          <input id="review-auto" type="checkbox" />
          <strong data-i18n="organizaciones.reAuditarAutomaticamente">{es['organizaciones.reAuditarAutomaticamente']}</strong>
          <small data-i18n="organizaciones.vuelveAuditarUltimaConfiguracion">{es['organizaciones.vuelveAuditarUltimaConfiguracion']}</small>
        </label>
      </fieldset>
      <div id="review-error" class="alert alert-error is-hidden"></div>
      <div class="review-actions">
        <button id="review-submit" class="button button-primary button-small" type="submit" disabled
          data-roles="ADMINISTRADOR_SISTEMA,ADMINISTRADOR_ORGANIZACION" data-i18n="organizaciones.guardarPlazos">{es['organizaciones.guardarPlazos']}</button>
      </div>
    </form>
  </section>

  <dialog id="organization-dialog" class="technical-dialog">
    <form id="organization-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" id="organization-dialog-eyebrow" data-i18n="organizaciones.altaOrganizacion">{es['organizaciones.altaOrganizacion']}</span>
          <h2 id="organization-dialog-title" data-i18n="organizaciones.registrarOrganizacion">{es['organizaciones.registrarOrganizacion']}</h2>
          <p id="organization-dialog-help" data-i18n="organizaciones.incorporaClientePlataforma">{es['organizaciones.incorporaClientePlataforma']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field">
          <span data-i18n="organizaciones.identificadorObligatorio">{es['organizaciones.identificadorObligatorio']}</span>
          <input id="organization-identifier" type="text" maxlength="80" placeholder={es['organizaciones.colClienteNorte']} data-i18n-placeholder="organizaciones.colClienteNorte" required />
        </label>
        <label class="field">
          <span data-i18n="organizaciones.razonSocialObligatorio">{es['organizaciones.razonSocialObligatorio']}</span>
          <input id="organization-name" type="text" maxlength="160" placeholder={es['organizaciones.clienteNorteSa']} data-i18n-placeholder="organizaciones.clienteNorteSa" required />
        </label>
        <label class="field" data-plan-choice>
          <span data-i18n="organizaciones.planInicialObligatorio">{es['organizaciones.planInicialObligatorio']}</span>
          <select id="organization-plan" class="form-select" data-plan-select></select>
        </label>
        <label class="field" data-plan-trial>
          <span data-i18n="organizaciones.diasPrueba">{es['organizaciones.diasPrueba']}</span>
          <input id="organization-trial-days" type="number" min="60" max="90" value="90" data-plan-days />
        </label>
        <label class="field" data-plan-custom>
          <span data-i18n="organizaciones.dispositivosAcordadosObligatorio">{es['organizaciones.dispositivosAcordadosObligatorio']}</span>
          <input id="organization-limit-devices" type="number" min="1" data-plan-devices />
        </label>
        <label class="field" data-plan-custom>
          <span data-i18n="organizaciones.usuariosAcordadosObligatorio">{es['organizaciones.usuariosAcordadosObligatorio']}</span>
          <input id="organization-limit-users" type="number" min="1" data-plan-users />
        </label>
        <div class="device-form-context field-span-2">
          <code id="organization-dialog-state" data-i18n="organizaciones.estadoInicial">{es['organizaciones.estadoInicial']}</code>
          <span data-i18n="organizaciones.identificadorGuardaMayusculasDebe">{es['organizaciones.identificadorGuardaMayusculasDebe']}</span>
        </div>
      </div>

      <div id="organization-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button id="organization-submit" class="button button-primary" type="submit" data-i18n="organizaciones.registrarOrganizacion">{es['organizaciones.registrarOrganizacion']}</button>
      </div>
    </form>
  </dialog>

  <dialog id="plan-dialog" class="technical-dialog" style="width: min(620px, calc(100vw - 32px));">
    <form id="plan-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="organizaciones.plan">{es['organizaciones.plan']}</span>
          <h2 id="plan-dialog-title" data-i18n="organizaciones.cambiarPlan">{es['organizaciones.cambiarPlan']}</h2>
          <p data-i18n="organizaciones.aplicaActoSiOrganizacion">{es['organizaciones.aplicaActoSiOrganizacion']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>
      <div class="device-form-grid">
        <label class="field field-span-2">
          <span data-i18n="organizaciones.planObligatorio">{es['organizaciones.planObligatorio']}</span>
          <select id="plan-code" class="form-select" data-plan-select></select>
        </label>
        <label class="field" data-plan-trial>
          <span data-i18n="organizaciones.diasPrueba">{es['organizaciones.diasPrueba']}</span>
          <input id="plan-trial-days" type="number" min="60" max="90" value="90" data-plan-days />
        </label>
        <label class="field" data-plan-custom>
          <span data-i18n="organizaciones.dispositivosAcordadosObligatorio">{es['organizaciones.dispositivosAcordadosObligatorio']}</span>
          <input id="plan-limit-devices" type="number" min="1" data-plan-devices />
        </label>
        <label class="field" data-plan-custom>
          <span data-i18n="organizaciones.usuariosAcordadosObligatorio">{es['organizaciones.usuariosAcordadosObligatorio']}</span>
          <input id="plan-limit-users" type="number" min="1" data-plan-users />
        </label>
      </div>
      <div id="plan-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="organizaciones.aplicarPlan">{es['organizaciones.aplicarPlan']}</button>
      </div>
    </form>
  </dialog>

  <dialog id="site-dialog" class="technical-dialog">
    <form id="site-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span class="eyebrow" id="site-dialog-eyebrow" data-i18n="organizaciones.altaSede">{es['organizaciones.altaSede']}</span>
          <h2 id="site-dialog-title" data-i18n="organizaciones.registrarSede">{es['organizaciones.registrarSede']}</h2>
          <p id="site-dialog-context" data-i18n="organizaciones.sedeOrganizacionSeleccionada">{es['organizaciones.sedeOrganizacionSeleccionada']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field">
          <span data-i18n="general.nombreObligatorio">{es['general.nombreObligatorio']}</span>
          <input id="site-name" type="text" maxlength="120" placeholder={es['organizaciones.sedeCentral']} data-i18n-placeholder="organizaciones.sedeCentral" required />
        </label>
        <label class="field">
          <span data-i18n="organizaciones.ubicacionObligatorio">{es['organizaciones.ubicacionObligatorio']}</span>
          <input id="site-location" type="text" maxlength="200" placeholder={es['organizaciones.avSiempreVivaCaba']} data-i18n-placeholder="organizaciones.avSiempreVivaCaba" required />
        </label>
      </div>

      <div id="site-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button id="site-submit" class="button button-primary" type="submit" data-i18n="organizaciones.registrarSede">{es['organizaciones.registrarSede']}</button>
      </div>
    </form>
  </dialog>


  <script src="../scripts/organizations.ts"></script>
</MasterLayout>
