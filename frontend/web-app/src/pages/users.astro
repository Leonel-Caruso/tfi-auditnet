---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['usuarios.titulo']} section={es['usuarios.seccion']} description={es['usuarios.descripcion']}
  i18n="usuarios"
>
  <p id="users-scope-note" class="alert alert-info is-hidden" style="margin-bottom: 14px;" data-i18n="usuarios.gestionasUsuariosOrganizacionPerfiles">{es['usuarios.gestionasUsuariosOrganizacionPerfiles']}</p>
  <div id="users-error" class="alert alert-error is-hidden" role="alert"></div>
  <div id="users-message" class="alert alert-success is-hidden" role="status"></div>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="usuarios.accesos">{es['usuarios.accesos']}</span>
        <h2 data-i18n="usuarios.usuarios">{es['usuarios.usuarios']}</h2>
      </div>
      <div class="panel-heading-actions">
        <span id="users-count" class="counter-chip">—</span>
        <button id="user-create" class="button button-primary button-small" type="button" data-i18n="usuarios.nuevoUsuario">{es['usuarios.nuevoUsuario']}</button>
      </div>
    </div>

    <div class="users-toolbar">
      <label class="terminal-search">
        <span>&gt;</span>
        <input id="user-search" type="search" placeholder={es['usuarios.buscarNombreUsuarioCorreo']} data-i18n-placeholder="usuarios.buscarNombreUsuarioCorreo" />
      </label>
      <label class="log-filter">
        <span data-i18n="general.estado">{es['general.estado']}</span>
        <select id="user-status-filter" class="technical-select">
          <option value="" data-i18n="general.todos">{es['general.todos']}</option>
          <option value="ACTIVO" data-i18n="usuarios.activos">{es['usuarios.activos']}</option>
          <option value="DESHABILITADO" data-i18n="usuarios.deshabilitados">{es['usuarios.deshabilitados']}</option>
          <option value="BLOQUEADO" data-i18n="usuarios.bloqueados">{es['usuarios.bloqueados']}</option>
        </select>
      </label>
    </div>

    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th data-i18n="usuarios.colUsuario">{es['usuarios.colUsuario']}</th>
            <th data-i18n="usuarios.colOrganizacion">{es['usuarios.colOrganizacion']}</th>
            <th data-i18n="usuarios.colPerfil">{es['usuarios.colPerfil']}</th>
            <th data-i18n="usuarios.colEstado">{es['usuarios.colEstado']}</th>
            <th data-i18n="usuarios.ultimoAcceso">{es['usuarios.ultimoAcceso']}</th>
            <th aria-label={es['usuarios.acciones']} data-i18n-aria-label="usuarios.acciones"></th>
          </tr>
        </thead>
        <tbody id="users-body">
          <tr><td colspan="6"><div class="skeleton-row"></div></td></tr>
        </tbody>
      </table>
      <div id="users-empty" class="empty-state compact-empty is-hidden">
        <div><code data-i18n="usuarios.ceroUsuarios">{es['usuarios.ceroUsuarios']}</code><p data-i18n="usuarios.hayUsuariosCoincidanFiltro">{es['usuarios.hayUsuariosCoincidanFiltro']}</p></div>
      </div>
    </div>
  </section>

  <section class="two-column">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="usuarios.perfiles">{es['usuarios.perfiles']}</span>
          <h2 data-i18n="usuarios.perfilesAcceso">{es['usuarios.perfilesAcceso']}</h2>
        </div>
      </div>
      <p class="log-muted" data-i18n="usuarios.cincoPerfilesSonFijos">{es['usuarios.cincoPerfilesSonFijos']}</p>
      <div id="role-list" class="role-list" style="margin-top: 12px;"><div class="skeleton-row"></div></div>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="usuarios.permisos">{es['usuarios.permisos']}</span>
          <h2 data-i18n="usuarios.matrizPermisos">{es['usuarios.matrizPermisos']}</h2>
        </div>
      </div>
      <div class="table-wrap">
        <table class="data-table permission-table">
          <thead>
            <tr><th data-i18n="usuarios.moduloAccion">{es['usuarios.moduloAccion']}</th><th title={es['perfil.ADMINISTRADOR_SISTEMA']} data-i18n-title="perfil.ADMINISTRADOR_SISTEMA" data-i18n="usuarios.colAdm">{es['usuarios.colAdm']}</th><th title={es['perfil.ADMINISTRADOR_ORGANIZACION']} data-i18n-title="perfil.ADMINISTRADOR_ORGANIZACION" data-i18n="usuarios.colOrg">{es['usuarios.colOrg']}</th><th title={es['perfil.ANALISTA_RED']} data-i18n-title="perfil.ANALISTA_RED" data-i18n="usuarios.colAnl">{es['usuarios.colAnl']}</th><th title={es['perfil.AUDITOR_TECNICO']} data-i18n-title="perfil.AUDITOR_TECNICO" data-i18n="usuarios.colAud">{es['usuarios.colAud']}</th><th title={es['perfil.RESPONSABLE_GESTION_IT']} data-i18n-title="perfil.RESPONSABLE_GESTION_IT" data-i18n="usuarios.colRsp">{es['usuarios.colRsp']}</th></tr>
          </thead>
          <tbody id="permission-body"></tbody>
        </table>
      </div>
    </article>
  </section>

  <dialog id="user-dialog" class="technical-dialog">
    <form id="user-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow" id="user-dialog-eyebrow" data-i18n="usuarios.altaUsuario">{es['usuarios.altaUsuario']}</span>
          <h2 id="user-dialog-title" data-i18n="usuarios.registrarUsuario">{es['usuarios.registrarUsuario']}</h2>
          <p id="user-dialog-help" data-i18n="usuarios.cuentaQuedaActivaPerfil">{es['usuarios.cuentaQuedaActivaPerfil']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field">
          <span data-i18n="usuarios.nombreApellidoObligatorio">{es['usuarios.nombreApellidoObligatorio']}</span>
          <input id="form-user-name" type="text" maxlength="140" autocomplete="off" required />
        </label>
        <label class="field">
          <span data-i18n="usuarios.correoObligatorio">{es['usuarios.correoObligatorio']}</span>
          <input id="form-user-email" type="email" maxlength="160" autocomplete="off" required />
        </label>
        <label class="field">
          <span data-i18n="usuarios.nombreUsuarioObligatorio">{es['usuarios.nombreUsuarioObligatorio']}</span>
          <input id="form-user-username" type="text" maxlength="60" autocomplete="off" placeholder={es['usuarios.ejAnaPerez']} data-i18n-placeholder="usuarios.ejAnaPerez" required />
        </label>
        <label class="field">
          <span data-i18n="general.organizacionObligatorio">{es['general.organizacionObligatorio']}</span>
          <select id="form-user-organization" class="technical-select form-select" required></select>
        </label>
        <label class="field field-span-2" id="form-user-password-field">
          <span data-i18n="usuarios.contrasenaInicialObligatorio">{es['usuarios.contrasenaInicialObligatorio']}</span>
          <input id="form-user-password" type="password" maxlength="72" autocomplete="new-password" required />
        </label>
        <ul id="form-user-password-rules" class="password-rules field-span-2"></ul>
        <fieldset class="role-checks field-span-2" id="user-roles">
          <legend data-i18n="usuarios.perfilObligatorio">{es['usuarios.perfilObligatorio']}</legend>
        </fieldset>
      </div>

      <div id="user-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button id="user-submit" class="button button-primary" type="submit" data-i18n="usuarios.registrarUsuario">{es['usuarios.registrarUsuario']}</button>
      </div>
    </form>
  </dialog>

  <dialog id="password-dialog" class="technical-dialog" style="width: min(520px, calc(100vw - 32px));">
    <form id="password-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="usuarios.restablecerContrasena">{es['usuarios.restablecerContrasena']}</span>
          <h2 id="password-dialog-title" data-i18n="usuarios.nuevaContrasena">{es['usuarios.nuevaContrasena']}</h2>
          <p data-i18n="usuarios.quitaBloqueoSiHubiera">{es['usuarios.quitaBloqueoSiHubiera']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>
      <label class="field">
        <span data-i18n="usuarios.contrasenaNuevaObligatorio">{es['usuarios.contrasenaNuevaObligatorio']}</span>
        <input id="reset-password" type="password" maxlength="72" autocomplete="new-password" required />
      </label>
      <ul id="reset-password-rules" class="password-rules"></ul>
      <label class="field">
        <span data-i18n="usuarios.repetirContrasenaObligatorio">{es['usuarios.repetirContrasenaObligatorio']}</span>
        <input id="reset-password-confirm" type="password" maxlength="72" autocomplete="new-password" required />
      </label>
      <div id="password-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="usuarios.restablecer">{es['usuarios.restablecer']}</button>
      </div>
    </form>
  </dialog>

  <dialog id="role-dialog" class="technical-dialog" style="width: min(560px, calc(100vw - 32px));">
    <form id="role-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="usuarios.perfilAcceso">{es['usuarios.perfilAcceso']}</span>
          <h2 id="role-dialog-title" data-i18n="general.editarDescripcion">{es['general.editarDescripcion']}</h2>
          <p data-i18n="usuarios.nombrePermisosPerfilCambian">{es['usuarios.nombrePermisosPerfilCambian']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>
      <label class="field">
        <span data-i18n="general.descripcionObligatorio">{es['general.descripcionObligatorio']}</span>
        <textarea id="role-description" rows="3" maxlength="240" required></textarea>
      </label>
      <div id="role-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="general.guardar">{es['general.guardar']}</button>
      </div>
    </form>
  </dialog>


  <script src="../scripts/users.ts"></script>
</MasterLayout>
