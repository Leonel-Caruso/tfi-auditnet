---
import MasterLayout from '../layouts/MasterLayout.astro';
import { es } from '../i18n';
---

<MasterLayout title={es['cuenta.titulo']} section={es['cuenta.seccion']} description={es['cuenta.descripcion']} i18n="cuenta">
  <div id="account-message" class="alert alert-success is-hidden" role="status"></div>

  <section class="account-grid">
    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cuenta.identidad">{es['cuenta.identidad']}</span>
          <h2 id="account-name">—</h2>
        </div>
      </div>
      <dl class="technical-definition-list">
        <div><dt data-i18n="cuenta.usuario">{es['cuenta.usuario']}</dt><dd id="account-username">—</dd></div>
        <div><dt data-i18n="cuenta.correo">{es['cuenta.correo']}</dt><dd id="account-email">—</dd></div>
        <div><dt data-i18n="cuenta.organizacion">{es['cuenta.organizacion']}</dt><dd id="account-organization">—</dd></div>
        <div><dt data-i18n="cuenta.perfil">{es['cuenta.perfil']}</dt><dd id="account-roles">—</dd></div>
        <div><dt data-i18n="cuenta.vence">{es['cuenta.vence']}</dt><dd id="account-expires">—</dd></div>
      </dl>
      <p class="log-muted" style="margin-top: 14px;" data-i18n="cuenta.cambiosDatos">{es['cuenta.cambiosDatos']}</p>
    </article>

    <article class="panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cuenta.seguridad">{es['cuenta.seguridad']}</span>
          <h2 data-i18n="cuenta.cambiarContrasena">{es['cuenta.cambiarContrasena']}</h2>
        </div>
      </div>
      <form id="account-password-form" class="account-form" novalidate>
        <label class="field">
          <span data-i18n="cuenta.actual">{es['cuenta.actual']}</span>
          <input id="account-current" type="password" autocomplete="current-password" maxlength="72" required />
        </label>
        <label class="field">
          <span data-i18n="cuenta.nueva">{es['cuenta.nueva']}</span>
          <input id="account-new" type="password" autocomplete="new-password" maxlength="72" required />
        </label>
        <ul id="account-rules" class="password-rules"></ul>
        <label class="field">
          <span data-i18n="cuenta.repetir">{es['cuenta.repetir']}</span>
          <input id="account-confirm" type="password" autocomplete="new-password" maxlength="72" required />
        </label>
        <div id="account-error" class="alert alert-error is-hidden" role="alert" style="margin-bottom: 14px;"></div>
        <button id="account-submit" class="button button-primary" type="submit" data-i18n="cuenta.cambiar">{es['cuenta.cambiar']}</button>
        <p class="log-muted" style="margin-top: 12px;" data-i18n="cuenta.notaContrasena">{es['cuenta.notaContrasena']}</p>
      </form>
    </article>

    <article class="panel account-wide" id="language-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cuenta.idiomaSeccion">{es['cuenta.idiomaSeccion']}</span>
          <h2 data-i18n="cuenta.idiomaTitulo">{es['cuenta.idiomaTitulo']}</h2>
        </div>
      </div>
      <div id="account-language" class="language-options" role="group" aria-label={es['idioma.elegir']} data-i18n-aria-label="idioma.elegir">
        <button type="button" class="language-option" data-idioma="es" lang="es"><strong>Español</strong><small>ES</small></button>
        <button type="button" class="language-option" data-idioma="en" lang="en"><strong>English</strong><small>EN</small></button>
        <button type="button" class="language-option" data-idioma="pt" lang="pt-BR"><strong>Português</strong><small>PT</small></button>
      </div>
      <div id="language-error" class="alert alert-error is-hidden" role="alert" style="margin-bottom: 14px;"></div>
      <p class="log-muted" data-i18n="cuenta.idiomaAyuda">{es['cuenta.idiomaAyuda']}</p>
    </article>

    <article class="panel account-wide" id="theme-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cuenta.temaSeccion">{es['cuenta.temaSeccion']}</span>
          <h2 data-i18n="cuenta.temaTitulo">{es['cuenta.temaTitulo']}</h2>
        </div>
      </div>
      <div id="account-theme" class="language-options theme-options" role="group" aria-label={es['tema.elegir']} data-i18n-aria-label="tema.elegir">
        <button type="button" class="language-option" data-opcion-tema="claro"><strong data-i18n="tema.claro">{es['tema.claro']}</strong></button>
        <button type="button" class="language-option" data-opcion-tema="oscuro"><strong data-i18n="tema.oscuro">{es['tema.oscuro']}</strong></button>
      </div>
      <p class="log-muted" data-i18n="cuenta.temaAyuda">{es['cuenta.temaAyuda']}</p>
    </article>

    <article class="panel account-wide" id="notifications-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="cuenta.correoSeccion">{es['cuenta.correoSeccion']}</span>
          <h2 data-i18n="cuenta.avisos">{es['cuenta.avisos']}</h2>
        </div>
      </div>
      <form id="notifications-form" class="notice-form" novalidate>
        <fieldset class="notice-checks" id="notification-options">
          <label class="role-check" data-notice="alertas">
            <input type="checkbox" name="alertas" />
            <strong data-i18n="cuenta.avisoAlertas">{es['cuenta.avisoAlertas']}</strong>
            <small data-i18n="cuenta.avisoAlertasAyuda">{es['cuenta.avisoAlertasAyuda']}</small>
          </label>
          <label class="role-check" data-notice="vencimientos">
            <input type="checkbox" name="vencimientos" />
            <strong data-i18n="cuenta.avisoVencimientos">{es['cuenta.avisoVencimientos']}</strong>
            <small data-i18n="cuenta.avisoVencimientosAyuda">{es['cuenta.avisoVencimientosAyuda']}</small>
          </label>
          <label class="role-check" data-notice="resumen">
            <input type="checkbox" name="resumen" />
            <strong data-i18n="cuenta.avisoResumen">{es['cuenta.avisoResumen']}</strong>
            <small data-i18n="cuenta.avisoResumenAyuda">{es['cuenta.avisoResumenAyuda']}</small>
          </label>
        </fieldset>
        <p id="notifications-none" class="log-muted is-hidden" data-i18n="cuenta.sinAvisos">{es['cuenta.sinAvisos']}</p>
        <div id="notifications-error" class="alert alert-error is-hidden" role="alert" style="margin-bottom: 14px;"></div>
        <button id="notifications-submit" class="button button-primary" type="submit" data-i18n="cuenta.guardarAvisos">{es['cuenta.guardarAvisos']}</button>
      </form>
    </article>
  </section>

  <script src="../scripts/account.ts"></script>
</MasterLayout>
