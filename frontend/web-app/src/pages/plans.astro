---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['planes.titulo']} section={es['planes.seccion']} description={es['planes.descripcion']}
  i18n="planes"
>
  <div id="plans-error" class="alert alert-error is-hidden" role="alert"></div>
  <div id="plans-message" class="alert alert-success is-hidden" role="status"></div>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="planes.pendientes">{es['planes.pendientes']}</span>
        <h2 data-i18n="planes.solicitudesResolver">{es['planes.solicitudesResolver']}</h2>
      </div>
      <span id="pending-count" class="counter-chip">—</span>
    </div>
    <ul id="pending-list" class="request-list"><li><div class="skeleton-row"></div></li></ul>
    <div id="pending-empty" class="empty-state compact-empty is-hidden">
      <div><code data-i18n="planes.ceroPendientes">{es['planes.ceroPendientes']}</code><p data-i18n="planes.haySolicitudesCambioPlan">{es['planes.haySolicitudesCambioPlan']}</p></div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="planes.catalogo">{es['planes.catalogo']}</span>
        <h2 data-i18n="planes.planesPreciosReferencia">{es['planes.planesPreciosReferencia']}</h2>
      </div>
    </div>
    <div id="catalog" class="plan-catalog"><div class="skeleton-row"></div></div>
    <p class="log-muted" style="margin-top: 12px;" data-i18n="planes.limitesSonPropuestaComercial">{es['planes.limitesSonPropuestaComercial']}</p>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow" data-i18n="planes.historial">{es['planes.historial']}</span>
        <h2 data-i18n="planes.solicitudesResueltas">{es['planes.solicitudesResueltas']}</h2>
      </div>
    </div>
    <ul id="history-list" class="request-list"></ul>
    <div id="history-empty" class="empty-state compact-empty is-hidden">
      <div><code data-i18n="planes.ceroResueltas">{es['planes.ceroResueltas']}</code><p data-i18n="planes.todaviaResolvioNingunaSolicitud">{es['planes.todaviaResolvioNingunaSolicitud']}</p></div>
    </div>
  </section>

  <dialog id="resolve-dialog" class="technical-dialog" style="width: min(560px, calc(100vw - 32px));">
    <form id="resolve-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span id="resolve-eyebrow" class="eyebrow" data-i18n="planes.aprobarSolicitud">{es['planes.aprobarSolicitud']}</span>
          <h2 id="resolve-title">—</h2>
          <p id="resolve-help"></p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>
      <div class="device-form-grid">
        <label class="field" data-custom-limit>
          <span data-i18n="organizaciones.dispositivosAcordadosObligatorio">{es['organizaciones.dispositivosAcordadosObligatorio']}</span>
          <input id="resolve-devices" type="number" min="1" />
        </label>
        <label class="field" data-custom-limit>
          <span data-i18n="organizaciones.usuariosAcordadosObligatorio">{es['organizaciones.usuariosAcordadosObligatorio']}</span>
          <input id="resolve-users" type="number" min="1" />
        </label>
        <label class="field field-span-2">
          <span id="resolve-answer-label" data-i18n="planes.respuestaCliente">{es['planes.respuestaCliente']}</span>
          <textarea id="resolve-answer" rows="3" maxlength="500"></textarea>
        </label>
      </div>
      <div id="resolve-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button id="resolve-submit" class="button button-primary" type="submit" data-i18n="planes.aprobar">{es['planes.aprobar']}</button>
      </div>
    </form>
  </dialog>

  <dialog id="price-dialog" class="technical-dialog" style="width: min(520px, calc(100vw - 32px));">
    <form id="price-form" class="device-form" novalidate>
      <div class="dialog-header">
        <div>
          <span class="eyebrow" data-i18n="planes.catalogo">{es['planes.catalogo']}</span>
          <h2 id="price-title">—</h2>
          <p data-i18n="planes.vacioDejaPrecioComo">{es['planes.vacioDejaPrecioComo']}</p>
        </div>
        <button class="dialog-close" type="button" data-close-dialog aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>
      <label class="field">
        <span data-i18n="planes.precioMensualReferenciaUsd">{es['planes.precioMensualReferenciaUsd']}</span>
        <input id="price-value" type="number" min="0" step="0.01" />
      </label>
      <label class="field">
        <span data-i18n="planes.condiciones">{es['planes.condiciones']}</span>
        <textarea id="price-conditions" rows="3" maxlength="400"></textarea>
      </label>
      <div id="price-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button class="button button-ghost" type="button" data-close-dialog data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button class="button button-primary" type="submit" data-i18n="general.guardar">{es['general.guardar']}</button>
      </div>
    </form>
  </dialog>

  <script src="../scripts/plans.ts"></script>
</MasterLayout>
