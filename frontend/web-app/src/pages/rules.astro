---
import { es } from '../i18n';
import MasterLayout from '../layouts/MasterLayout.astro';
---

<MasterLayout
  title={es['reglas.titulo']} section={es['reglas.seccion']} description={es['reglas.descripcion']}
  i18n="reglas"
>
  <section id="rule-message" class="alert is-hidden" role="status"></section>

  <section class="policy-toolbar panel compact-panel">
    <div class="device-toolbar-copy">
      <span class="eyebrow" data-i18n="reglas.reglasControl">{es['reglas.reglasControl']}</span>
      <div>
        <strong id="rule-count" data-i18n="reglas.ceroReglas">{es['reglas.ceroReglas']}</strong>
        <span data-i18n="reglas.controlesTecnicosConfigurados">{es['reglas.controlesTecnicosConfigurados']}</span>
      </div>
    </div>

    <div class="device-toolbar-actions">
      <label class="terminal-search">
        <span>&gt;</span>
        <input id="rule-search" type="search" placeholder={es['reglas.buscarCodigoReglaBaseline']} data-i18n-placeholder="reglas.buscarCodigoReglaBaseline" />
      </label>
      <select id="rule-severity-filter" class="technical-select" aria-label={es['reglas.filtrarSeveridad']} data-i18n-aria-label="reglas.filtrarSeveridad">
        <option value="" data-i18n="reglas.severidadTodas">{es['reglas.severidadTodas']}</option>
        <option value="CRITICA" data-i18n="reglas.severidadCritica">{es['reglas.severidadCritica']}</option>
        <option value="ALTA" data-i18n="reglas.severidadAlta">{es['reglas.severidadAlta']}</option>
        <option value="MEDIA" data-i18n="reglas.severidadMedia">{es['reglas.severidadMedia']}</option>
        <option value="BAJA" data-i18n="reglas.severidadBaja">{es['reglas.severidadBaja']}</option>
      </select>
      <select id="rule-status-filter" class="technical-select" aria-label={es['general.filtrarEstado']} data-i18n-aria-label="general.filtrarEstado">
        <option value="" data-i18n="general.estadoTodos">{es['general.estadoTodos']}</option>
        <option value="ACTIVA" data-i18n="reglas.estadoActiva">{es['reglas.estadoActiva']}</option>
        <option value="INACTIVA" data-i18n="reglas.estadoInactiva">{es['reglas.estadoInactiva']}</option>
      </select>
      <button
        id="open-rule-dialog"
        class="button button-primary device-create-action"
        type="button"
        data-roles="ADMINISTRADOR_SISTEMA,AUDITOR_TECNICO"
       data-i18n="reglas.nuevaRegla">{es['reglas.nuevaRegla']}</button>
    </div>
  </section>

  <section class="policy-workspace">
    <article class="panel policy-list-panel">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="reglas.controles">{es['reglas.controles']}</span>
          <h2 data-i18n="reglas.controlesConfiguracion">{es['reglas.controlesConfiguracion']}</h2>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table policy-table">
          <thead>
            <tr>
              <th data-i18n="reglas.colCodigo">{es['reglas.colCodigo']}</th>
              <th data-i18n="reglas.colRegla">{es['reglas.colRegla']}</th>
              <th data-i18n="reglas.colBaseline">{es['reglas.colBaseline']}</th>
              <th data-i18n="reglas.colCondicion">{es['reglas.colCondicion']}</th>
              <th data-i18n="reglas.colSeveridad">{es['reglas.colSeveridad']}</th>
              <th data-i18n="reglas.colEstado">{es['reglas.colEstado']}</th>
            </tr>
          </thead>
          <tbody id="rules-body"><tr><td colspan="6"><div class="skeleton-row"></div></td></tr></tbody>
        </table>
      </div>

      <div id="rules-empty" class="empty-state compact-empty is-hidden">
        <div>
          <code data-i18n="reglas.ceroReglas">{es['reglas.ceroReglas']}</code>
          <p data-i18n="reglas.hayReglasConfiguradasFiltros">{es['reglas.hayReglasConfiguradasFiltros']}</p>
        </div>
      </div>
    </article>

    <aside class="panel policy-inspector" aria-label={es['reglas.detalleRegla']} data-i18n-aria-label="reglas.detalleRegla">
      <div class="panel-heading">
        <div>
          <span class="eyebrow" data-i18n="reglas.reglaSeleccionada">{es['reglas.reglaSeleccionada']}</span>
          <h2 data-i18n="reglas.detalleControl">{es['reglas.detalleControl']}</h2>
        </div>
        <span class="inspector-led"></span>
      </div>

      <div id="rule-inspector-empty" class="inspector-empty">
        <code data-i18n="general.sinSeleccion">{es['general.sinSeleccion']}</code>
        <p data-i18n="reglas.seleccionaReglaRevisarCondicion">{es['reglas.seleccionaReglaRevisarCondicion']}</p>
      </div>

      <div id="rule-inspector-content" class="inspector-content is-hidden">
        <div class="inspector-identity">
          <span id="rule-inspector-code" class="inspector-code">—</span>
          <h3 id="rule-inspector-name">—</h3>
          <span id="rule-inspector-status" class="status-badge status-ready">—</span>
        </div>
        <p id="rule-inspector-description" class="policy-description">—</p>
        <dl class="technical-definition-list">
          <div><dt data-i18n="general.baseline">{es['general.baseline']}</dt><dd id="rule-inspector-baseline">—</dd></div>
          <div><dt data-i18n="reglas.condicionDetalle">{es['reglas.condicionDetalle']}</dt><dd id="rule-inspector-type">—</dd></div>
          <div><dt data-i18n="general.severidad">{es['general.severidad']}</dt><dd id="rule-inspector-severity">—</dd></div>
          <div><dt data-i18n="general.identificador">{es['general.identificador']}</dt><dd id="rule-inspector-id">—</dd></div>
        </dl>
        <div class="rule-expression-block">
          <span id="rule-inspector-pattern-label" data-i18n="reglas.patron">{es['reglas.patron']}</span>
          <code id="rule-inspector-pattern">—</code>
        </div>
        <div id="rule-inspector-expected-block" class="rule-expression-block is-hidden">
          <span data-i18n="reglas.valorEsperado">{es['reglas.valorEsperado']}</span>
          <code id="rule-inspector-expected">—</code>
        </div>
        <div class="finding-evidence-block">
          <span data-i18n="reglas.impacto">{es['reglas.impacto']}</span>
          <p id="rule-inspector-impact">—</p>
        </div>
        <div class="rule-recommendation">
          <span data-i18n="reglas.recomendacion">{es['reglas.recomendacion']}</span>
          <p id="rule-inspector-recommendation">—</p>
        </div>
        <div id="rule-inspector-frozen" class="inspector-footnote is-hidden">
          <code data-i18n="reglas.reglasCongeladas">{es['reglas.reglasCongeladas']}</code>
          <span data-i18n="reglas.baselineYaUsoAuditorias">{es['reglas.baselineYaUsoAuditorias']}</span>
        </div>
        <div class="inspector-actions" data-roles="ADMINISTRADOR_SISTEMA,AUDITOR_TECNICO">
          <button id="rule-edit" class="button button-ghost button-small" type="button" data-i18n="general.editar">{es['general.editar']}</button>
          <button id="rule-toggle" class="button button-ghost button-small" type="button" data-i18n="reglas.desactivar">{es['reglas.desactivar']}</button>
        </div>
      </div>
    </aside>
  </section>

  <dialog id="rule-dialog" class="technical-dialog">
    <form id="rule-form" class="device-form">
      <div class="dialog-header">
        <div>
          <span id="rule-dialog-eyebrow" class="eyebrow" data-i18n="reglas.nuevaReglaTitulo">{es['reglas.nuevaReglaTitulo']}</span>
          <h2 id="rule-dialog-title" data-i18n="reglas.crearRegla">{es['reglas.crearRegla']}</h2>
          <p id="rule-dialog-subtitle" data-i18n="reglas.convertiCondicionConfiguracionControl">{es['reglas.convertiCondicionConfiguracionControl']}</p>
        </div>
        <button id="close-rule-dialog" class="dialog-close" type="button" aria-label={es['general.cerrar']} data-i18n-aria-label="general.cerrar">×</button>
      </div>

      <div class="device-form-grid">
        <label class="field field-span-2">
          <span data-i18n="reglas.baselineObligatorio">{es['reglas.baselineObligatorio']}</span>
          <select id="rule-baseline" class="form-select" required><option value="" data-i18n="reglas.seleccionarBaseline">{es['reglas.seleccionarBaseline']}</option></select>
        </label>
        <label class="field">
          <span data-i18n="reglas.codigoObligatorio">{es['reglas.codigoObligatorio']}</span>
          <input id="rule-code" type="text" maxlength="60" placeholder="SEC-SSH-01" required />
        </label>
        <label class="field">
          <span data-i18n="general.nombreObligatorio">{es['general.nombreObligatorio']}</span>
          <input id="rule-name" type="text" maxlength="140" placeholder={es['reglas.forzarSshVersion']} data-i18n-placeholder="reglas.forzarSshVersion" required />
        </label>
        <label class="field">
          <span data-i18n="reglas.condicionObligatorio">{es['reglas.condicionObligatorio']}</span>
          <select id="rule-type" class="form-select" required>
            <option value="DEBE_CONTENER" data-i18n="condicion.DEBE_CONTENER">{es['condicion.DEBE_CONTENER']}</option>
            <option value="NO_DEBE_CONTENER" data-i18n="condicion.NO_DEBE_CONTENER">{es['condicion.NO_DEBE_CONTENER']}</option>
            <option value="VALOR_ESPERADO" data-i18n="condicion.VALOR_ESPERADO">{es['condicion.VALOR_ESPERADO']}</option>
          </select>
        </label>
        <label class="field">
          <span data-i18n="general.severidadObligatorio">{es['general.severidadObligatorio']}</span>
          <select id="rule-severity" class="form-select" required>
            <option value="MEDIA" data-i18n="severidad.MEDIA">{es['severidad.MEDIA']}</option>
            <option value="BAJA" data-i18n="severidad.BAJA">{es['severidad.BAJA']}</option>
            <option value="ALTA" data-i18n="severidad.ALTA">{es['severidad.ALTA']}</option>
            <option value="CRITICA" data-i18n="severidad.CRITICA">{es['severidad.CRITICA']}</option>
          </select>
        </label>
        <label id="rule-pattern-field" class="field field-span-2">
          <span id="rule-pattern-label" data-i18n="reglas.patronObligatorio">{es['reglas.patronObligatorio']}</span>
          <input id="rule-pattern" class="mono-input" type="text" maxlength="500" placeholder="ip ssh version 2" required />
        </label>
        <label id="rule-expected-field" class="field field-span-2 is-hidden">
          <span data-i18n="reglas.valorEsperadoObligatorio">{es['reglas.valorEsperadoObligatorio']}</span>
          <input id="rule-expected" class="mono-input" type="text" maxlength="500" placeholder="16384" />
        </label>
        <label class="field field-span-2">
          <span data-i18n="general.descripcionObligatorio">{es['general.descripcionObligatorio']}</span>
          <textarea id="rule-description" rows="2" maxlength="500" placeholder={es['reglas.configuracionDebeUtilizarExclusivamente']} data-i18n-placeholder="reglas.configuracionDebeUtilizarExclusivamente" required></textarea>
        </label>
        <label class="field field-span-2">
          <span data-i18n="reglas.impactoObligatorio">{es['reglas.impactoObligatorio']}</span>
          <textarea id="rule-impact" rows="2" maxlength="500" placeholder={es['reglas.credencialesAdministracionPuedenViajar']} data-i18n-placeholder="reglas.credencialesAdministracionPuedenViajar" required></textarea>
        </label>
        <label class="field field-span-2">
          <span data-i18n="reglas.recomendacionObligatorio">{es['reglas.recomendacionObligatorio']}</span>
          <textarea id="rule-recommendation" rows="2" maxlength="500" placeholder={es['reglas.configurarIpSshVersion']} data-i18n-placeholder="reglas.configurarIpSshVersion" required></textarea>
        </label>
      </div>
      <div class="rule-help">
        <code data-i18n="condicion.DEBE_CONTENER">{es['condicion.DEBE_CONTENER']}</code><span data-i18n="reglas.cumpleSiPatronAparece">{es['reglas.cumpleSiPatronAparece']}</span>
        <code data-i18n="condicion.NO_DEBE_CONTENER">{es['condicion.NO_DEBE_CONTENER']}</code><span data-i18n="reglas.cumpleSiNoAparece">{es['reglas.cumpleSiNoAparece']}</span>
        <code data-i18n="condicion.VALOR_ESPERADO">{es['condicion.VALOR_ESPERADO']}</code><span><span data-i18n="reglas.cumpleSiValor">{es['reglas.cumpleSiValor']}</span> (<span data-i18n="reglas.ejemplo">{es['reglas.ejemplo']}</span> <em>logging buffered</em> = <em>16384</em>)</span>
      </div>
      <div id="rule-form-error" class="alert alert-error is-hidden"></div>
      <div class="dialog-actions">
        <button id="cancel-rule-dialog" class="button button-ghost" type="button" data-i18n="general.cancelar">{es['general.cancelar']}</button>
        <button id="rule-submit" class="button button-primary" type="submit" data-i18n="reglas.crearRegla">{es['reglas.crearRegla']}</button>
      </div>
    </form>
  </dialog>

  <script src="../scripts/rules.ts"></script>
</MasterLayout>
